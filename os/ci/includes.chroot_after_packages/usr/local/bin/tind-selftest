#!/bin/bash
# Runs inside the CI VM only (DMI product name "tind-ci"). Writes a report to the serial port.
[ "$(cat /sys/class/dmi/id/product_name 2>/dev/null)" = tind-ci ] || exit 0
exec >/dev/ttyS0 2>&1
# input probe: report every input event the guest receives on the second serial port (ttyS1)
if [ -c /dev/ttyS1 ] && command -v libinput >/dev/null; then
    systemd-run --unit=tind-inputprobe --collect -p StandardOutput=file:/dev/ttyS1 -p StandardError=file:/dev/ttyS1 \
        timeout 1500 libinput debug-events --show-keycodes >/dev/null 2>&1 || true
fi
# ship the Calamares session log (once it exists) to ttyS1
systemd-run --unit=tind-calamares-log --collect -p StandardOutput=file:/dev/ttyS1 -p StandardError=file:/dev/ttyS1 \
    sh -c 'while :; do f=$(find /root/.cache /home -name session.log -path "*alamares*" 2>/dev/null | head -1); [ -n "$f" ] && break; sleep 5; done; echo "== calamares log: $f"; tail -n +1 -F "$f"' \
    >/dev/null 2>&1 || true
UIDN=$(id -u tind 2>/dev/null || echo 1000)
asuser() { runuser -u tind -- env XDG_RUNTIME_DIR="/run/user/$UIDN" DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$UIDN/bus" "$@"; }
sec() { echo; echo "##### $*"; }
# wait for the desktop session (up to 4 min), then let it settle
for _ in $(seq 1 120); do [ -S "/run/user/$UIDN/bus" ] && pgrep -u tind gnome-shell >/dev/null && break; sleep 2; done
sleep 30
# CI only: flip the session to the light scheme after 4 minutes so the boot screenshots show midday too
systemd-run --unit=tind-ci-light --collect \
    sh -c "sleep 200; runuser -u tind -- env XDG_RUNTIME_DIR=/run/user/$UIDN DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UIDN/bus gsettings set org.gnome.desktop.interface color-scheme default" \
    >/dev/null 2>&1 || true
# CI only: open Settings > Appearance (the accent swatches) in the dark session at 60 s and in the light one at
# 240 s (the flip is at 200 s), each for 40 s; the boot job screenshots them at ~85 s and ~265 s
for at in 60 240; do
    systemd-run --unit=tind-ci-settings-$at --collect \
        sh -c "sleep $at; runuser -u tind -- env XDG_RUNTIME_DIR=/run/user/$UIDN DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/$UIDN/bus WAYLAND_DISPLAY=wayland-0 timeout 40 gnome-control-center background" \
        >/dev/null 2>&1 || true
done
echo "=====TIND-SELFTEST-BEGIN====="
sec os-release; cat /etc/os-release
sec tind packages; dpkg -l 'tind-*' | tail -n +6 | awk '{print $1, $2, $3}'
sec input devices; grep -E '^(N: Name|H: Handlers)' /proc/bus/input/devices; ls /dev/input
sec session; loginctl list-sessions --no-legend; for s in $(loginctl list-sessions --no-legend | awk '{print $1}'); do loginctl show-session "$s" -p Name -p Type -p Active -p State -p Seat | tr '\n' ' '; echo; done
sec failed units; systemctl --failed --no-legend
sec services; for s in NetworkManager systemd-resolved ufw gdm; do echo "$s: $(systemctl is-active $s)"; done
sec resolv.conf; ls -l /etc/resolv.conf
sec ufw; ufw status | head -5
sec flatpak remotes; flatpak remotes 2>&1
sec gnome settings
for k in "org.gnome.desktop.interface color-scheme" "org.gnome.desktop.interface accent-color" \
         "org.gnome.desktop.background picture-uri-dark" "org.gnome.shell enabled-extensions" \
         "org.gnome.shell favorite-apps" "org.gnome.shell.extensions.dash-to-dock dock-position" \
         "org.gnome.shell.extensions.dash-to-dock dock-fixed" "org.gnome.shell.extensions.dash-to-dock intellihide" \
         "org.gnome.shell.extensions.dash-to-dock autohide" "org.gnome.shell.extensions.dash-to-dock extend-height" \
         "org.gnome.desktop.interface clock-format" "org.gnome.desktop.datetime automatic-timezone" \
         "org.gnome.system.location enabled" "org.gnome.desktop.wm.preferences button-layout" \
         "org.gnome.settings-daemon.plugins.media-keys custom-keybindings" \
         "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tind-terminal/ binding" \
         "org.gnome.settings-daemon.plugins.media-keys.custom-keybinding:/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tind-terminal/ command"; do
    echo "$k = $(asuser gsettings get $k 2>&1)"
done
sec "app grid folders"
echo "folder-children = $(asuser gsettings get org.gnome.desktop.app-folders folder-children 2>&1)"
for fo in Office System Utilities; do
    echo "$fo: $(asuser gsettings get "org.gnome.desktop.app-folders.folder:/org/gnome/desktop/app-folders/folders/$fo/" apps 2>&1)"
done
echo "live-only override files (should exist only in the live session):"; ls -l /usr/local/share/applications/ 2>&1 | head -5
echo "showtime: $(dpkg-query -W -f='${db:Status-Abbrev}' showtime 2>&1 | head -1)"
sec wallpapers
echo "picker lists: $(ls /usr/share/gnome-background-properties 2>&1 | tr '\n' ' ')"
echo "gnome-backgrounds: $(dpkg-query -W -f='${db:Status-Abbrev}' gnome-backgrounds 2>&1 | head -1)"
echo "tind.xml: $(test -e /usr/share/gnome-background-properties/tind.xml && grep -c "<wallpaper " /usr/share/gnome-background-properties/tind.xml || echo MISSING) entries"
echo "desktop-base: $(dpkg-query -W -f='${db:Status-Abbrev}' desktop-base 2>&1 | head -1)"
echo "backgrounds dirs: $(ls /usr/share/backgrounds 2>&1 | tr '\n' ' ')"
ls /usr/share/desktop-base 2>&1 | head -2
n=0; for f in /usr/share/gnome-background-properties/*.xml; do [ -e "$f" ] && [ "$(basename "$f")" != tind.xml ] && n=$((n+1)); done; echo "foreign picker lists: $n"
[ "$n" = 0 ] && echo "wallpapers: only Tind in the picker" || echo "wallpapers: NON-TIND LISTS PRESENT"
sec "keyboard (what Calamares preselects)"
echo "input-sources = $(asuser gsettings get org.gnome.desktop.input-sources sources 2>&1)"
echo "setxkbmap: $(asuser env DISPLAY=:0 setxkbmap -print 2>&1 | grep -E 'symbols' | head -1)"
cat /etc/default/keyboard 2>&1 | grep -E '^XKB(LAYOUT|MODEL)'
sec gnome-shell extensions; asuser gnome-extensions list --enabled 2>&1; asuser gnome-extensions info tind-ice@tind.no 2>&1 | head -8
echo "extension dirs: $(ls /usr/share/gnome-shell/extensions | tr '\n' ' ')"
for u in ubuntu-appindicators@ubuntu.com caffeine@patapon.info system-monitor-panel@naimur multi-monitors-bar@frederykabryan; do
  d=/usr/share/gnome-shell/extensions/$u
  echo "$u: files $(test -e $d/metadata.json && echo present || echo MISSING), schema $(test -e $d/schemas/gschemas.compiled && echo compiled || echo none-or-NOT-COMPILED), $(asuser gnome-extensions list --enabled 2>&1 | grep -qx "$u" && echo ENABLED || echo NOT-ENABLED)"
  asuser gnome-extensions info "$u" 2>&1 | grep -iE 'state|error|version' | head -4
done
echo "dbusmenu typelib: $(dpkg-query -W -f='${db:Status-Abbrev}' gir1.2-dbusmenu-glib-0.4 2>&1 | head -1)  geoclue: $(dpkg-query -W -f='${db:Status-Abbrev}' geoclue-2.0 2>&1 | head -1)"
echo "file-roller: $(dpkg -s file-roller >/dev/null 2>&1 && echo installed || echo MISSING)"
sec "tind update repository (static checks; the live site is not required to exist yet)"
echo "tind-archive-keyring: $(dpkg-query -W -f='${Version} ${db:Status-Abbrev}' tind-archive-keyring 2>&1)"
cat /etc/apt/sources.list.d/tind.sources 2>&1
echo "$(tind-channel 2>&1)"
fpr="$(gpg --show-keys --with-colons /usr/share/keyrings/tind-archive-keyring.gpg 2>/dev/null | awk -F: '$1=="fpr"{print $10; exit}')"
echo "tind repo key fingerprint: $fpr"
[ "$fpr" = "0F04FB12B3F97F21F3772F7FFE162F9E34C4D769" ] && echo "tind repo key: OK" || echo "tind repo key: MISMATCH"
echo "unattended-upgrades origins: $(apt-config dump 2>/dev/null | grep -c 'Origins-Pattern::.*origin=Tind') Tind entry"
sec firefox policies
for f in /etc/firefox/policies/policies.json /usr/lib/firefox-esr/distribution/policies.json; do echo "$f: $(test -e "$f" && echo present || echo MISSING)"; done
jq -e . /etc/firefox/policies/policies.json >/dev/null && echo "firefox policies.json: valid JSON"
ls -l /usr/lib/firefox-esr/distribution 2>&1 | head -5
sec ublock origin; dpkg -L webext-ublock-origin-firefox | grep -E 'xpi|\.json|extensions/' | head -8
find /usr/share/mozilla/extensions /usr/lib/firefox-esr -iname '*ublock*' 2>/dev/null | head
sec "firefox startup (headless, 40s)"
tmp=$(mktemp -d); chown tind "$tmp"
asuser timeout 40 firefox-esr --headless --profile "$tmp" about:policies >/dev/null 2>&1
grep -E 'uBlock|ublock' "$tmp/extensions.json" 2>/dev/null | head -3 | cut -c1-200 || true
echo "extensions.json present: $(test -e "$tmp/extensions.json" && echo yes || echo no)"
if [ -e "$tmp/extensions.json" ]; then jq -r '.addons[]|"\(.id) active=\(.active) location=\(.location)"' "$tmp/extensions.json" 2>&1 | head; fi
grep -E 'browser.search|isUserDisabled' "$tmp/prefs.js" 2>/dev/null | head -5
echo "policy keys:"; jq -r '.policies|keys|join(", ")' /etc/firefox/policies/policies.json
grep -E 'datareporting|toolkit.telemetry|autoDisableScopes|browser.search.region' "$tmp/prefs.js" 2>/dev/null | cut -c1-160 | head -8
sec thunderbird policies; jq -e . /etc/thunderbird/policies/policies.json >/dev/null && echo "thunderbird policies.json: valid JSON"
sec "accent names, Mozilla accent defaults, Spotify frame override"
for f in /usr/share/locale/en_US/LC_MESSAGES/gnome-control-center-2.0.mo /usr/lib/firefox-esr/defaults/pref/tind-accent.js /usr/lib/thunderbird/defaults/pref/tind-accent.js /var/lib/flatpak/overrides/com.spotify.Client; do echo "$f: $(test -e "$f" && echo present || echo MISSING)"; done
echo "accent tooltip for the green slot: $(python3 -c 'import gettext; print(gettext.translation("gnome-control-center-2.0", "/usr/share/locale", ["en_US"]).gettext("Green"))' 2>&1 | tail -1)"
sec tind-enroll; tind-enroll --help 2>&1 | head -8; cat /etc/tind/servr-tunnel.conf | grep -E '^[A-Z_]+=' | head
sec "enroll init/apply smoke test"
tind-enroll init 2>&1 | tail -3
tind-enroll apply </dev/null 2>&1 | tail -2   # empty block: must refuse cleanly
# a made-up block (documentation address, all-zero key) to exercise the real nmcli import path
tmp_before="$(find /tmp -maxdepth 1 -name 'tmp.*' | wc -l)"
apply_out="$(tind-enroll apply 2>&1 <<'BLOCK'
ADDRESS=10.99.99.2/32
SERVER_ENDPOINT=192.0.2.1:51820
SERVER_PUBLIC_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
ALLOWED_IPS=10.99.99.0/24
DNS_SERVER=10.99.99.1
BLOCK
)"
echo "$apply_out" | tail -3
# regression: the cleanup trap once failed with "tmp: unbound variable" and left the private-key temp dir behind
if echo "$apply_out" | grep -q "unbound variable"; then echo "tind-enroll apply: FAIL: shell error in the cleanup trap"; else echo "tind-enroll apply: no shell errors"; fi
tmp_after="$(find /tmp -maxdepth 1 -name 'tmp.*' | wc -l)"
[ "$tmp_after" -le "$tmp_before" ] && echo "tind-enroll apply: temp dir removed" || echo "tind-enroll apply: FAIL: temp dir left behind ($tmp_before -> $tmp_after)"
tind-enroll status 2>&1 | tail -2
tind-enroll remove --purge-key 2>&1 | tail -2
sec "wireguard watchdog"; systemctl is-enabled tind-wireguard-watchdog.timer 2>&1; /usr/lib/tind/wireguard-watchdog; echo "watchdog with no tunnel installed: exit $?"
sec "gnome-tour removed?"; dpkg -l gnome-tour 2>&1 | tail -1
sec calamares branding; grep -n '^branding' /etc/calamares/settings.conf; ls /usr/share/calamares/branding/tind | head
sec installer launcher
ls -l /usr/share/applications/tind-install.desktop 2>&1; grep -E '^(Name|Exec|Icon|NoDisplay)=' /usr/share/applications/tind-install.desktop 2>&1
echo "-- original:"; grep -E '^(Name|NoDisplay)=' /usr/share/applications/calamares-install-debian.desktop 2>&1
sec optins; ls /usr/share/tind/optins.d 2>&1; ls -l /usr/bin/tind-optins /usr/lib/tind/optin-install 2>&1
sec nextcloud config; cat /etc/Nextcloud/nextcloud.cfg 2>&1
sec plymouth; plymouth-set-default-theme 2>&1; ls /usr/share/plymouth/themes | tr '\n' ' '; echo
sec grub defaults; ls /etc/default/grub.d 2>&1
sec "boot mode and bootloader"
[ -d /sys/firmware/efi ] && echo "booted via: UEFI" || echo "booted via: BIOS"
dpkg-query -W -f='${Package} ${Version} ${db:Status-Abbrev}\n' os-prober grub-pc grub-pc-bin grub-efi-amd64 grub-efi-amd64-bin ntfs-3g 2>&1
echo "offline grub-pc files: $(ls /usr/share/tind/offline 2>&1 | tr '\n' ' ')"
echo "grub-pc debconf: $(debconf-show grub-pc 2>&1 | grep -E 'install_devices' | tr '\n' ' ')"
grep -rh OS_PROBER /etc/default/grub /etc/default/grub.d 2>&1
ls /boot/grub 2>&1 | tr '\n' ' '; echo
grep -c menuentry /boot/grub/grub.cfg 2>&1
lsblk -o NAME,SIZE,FSTYPE,MOUNTPOINT 2>&1 | head -12
sec "extras chosen in the installer"
cat /var/lib/tind/pending-extras 2>&1; cat /var/lib/tind/extras-status 2>&1
tail -40 /var/log/tind-extras.log 2>&1 | cut -c1-160
dpkg --print-foreign-architectures
dpkg-query -W -f='${Package} ${Version} ${db:Status-Abbrev}\n' steam-installer lutris wine wine32:i386 winetricks gamemode mangohud code git gh build-essential pipx 2>&1 | head -14
ls /etc/apt/sources.list.d/ /etc/sysctl.d/ 2>&1; sysctl vm.max_map_count
systemctl is-active tind-extras.service 2>&1
sec "gaming and graphics"
tind-gpu status 2>&1 | head -30
echo "vm.max_map_count=$(sysctl -n vm.max_map_count)"
dkms status 2>&1 | head -5
modinfo -F version nvidia-current 2>&1 | head -1; ls /lib/modules/*/updates/dkms 2>&1 | head -6
ls /etc/modprobe.d | tr '\n' ' '; echo
ls /usr/lib/udev/rules.d/*steam* /lib/udev/rules.d/*steam* 2>/dev/null | head -3
systemctl is-enabled tind-gpu-check.service nvidia-persistenced.service 2>&1
systemctl is-enabled tind-nvidia-upgrade.service 2>&1
echo "login logo: $(cmp -s /usr/share/tind/login-logo-64.png /usr/share/images/vendor-logos/logo-text-version-64.png && echo Tind || echo NOT-TIND) $(ls /usr/share/images/vendor-logos/ 2>&1 | tr '\n' ' ')"
echo "login background alternative: $(update-alternatives --query desktop-login-background 2>&1 | grep -E '^Value:|^Status:' | tr '\n' ' ')"
test -x /usr/lib/tind/nvidia-upgrade && echo "nvidia-upgrade: present" || echo "nvidia-upgrade: MISSING"
ls /var/lib/dkms/mok.key 2>&1
vulkaninfo --summary 2>&1 | grep -E 'deviceName|driverName|apiVersion' | head -6
sec "time sync"
echo "systemd-timesyncd: $(dpkg-query -W -f='${db:Status-Abbrev}' systemd-timesyncd 2>&1 | head -1) enabled=$(systemctl is-enabled systemd-timesyncd 2>&1) active=$(systemctl is-active systemd-timesyncd 2>&1)"
timedatectl show -p NTP -p NTPSynchronized 2>&1
sec "updates"
systemctl is-enabled tind-apt-refresh.service packagekit.service 2>&1; systemctl is-active tind-apt-refresh.service 2>&1
ls -l /var/lib/tind/apt-refreshed 2>&1; ls /var/lib/apt/lists | wc -l
cat /etc/apt/apt.conf.d/20tind-auto-upgrades 2>&1
systemctl is-enabled apt-daily.timer apt-daily-upgrade.timer 2>&1
unattended-upgrade --dry-run 2>&1 | tail -8
pkcon get-updates 2>&1 | tail -8
asuser gnome-software --version 2>&1 | head -1
flatpak remote-ls --updates 2>&1 | head -3
sec "security baseline"
echo "lsm: $(cat /sys/kernel/security/lsm 2>&1)"; cat /sys/module/apparmor/parameters/enabled 2>&1; systemctl status apparmor --no-pager 2>&1 | head -8; aa-status 2>&1 | head -4; grep -o "apparmor=[^ ]*\|lsm=[^ ]*" /proc/cmdline; resolvectl llmnr 2>&1 | head -2
echo "apparmor: $(systemctl is-active apparmor) ; profiles loaded: $(aa-status --enabled 2>&1; aa-status 2>/dev/null | sed -n '2p')"
ufw status verbose 2>&1 | head -8
echo "listening sockets:"; ss -tulnH 2>&1 | awk '{print $1, $5}' | sort -u | head -20
sec "hardware basics"
systemctl is-active power-profiles-daemon 2>&1; powerprofilesctl list 2>&1 | head -6
dpkg-query -W -f='${Package} ${Version} ${db:Status-Abbrev}\n' amd64-microcode intel-microcode firmware-brcm80211 firmware-mediatek fwupd 2>&1
grep -m1 microcode /proc/cpuinfo 2>&1
tind-report /tmp/tind-report-test.txt 2>&1 | tail -3
wc -l /tmp/tind-report-test.txt 2>&1; grep -c '^#####' /tmp/tind-report-test.txt 2>&1
ls /etc/apt/sources.list.d/ 2>&1
echo "proton in the base image (expected: none, it is the Security box): $(dpkg-query -W -f='${Package} ' protonvpn-stable-release proton-vpn-gnome-desktop 2>/dev/null || true)"
sec "desktop entries shown in the app grid (name, package)"
for f in /usr/share/applications/*.desktop; do
    grep -qE '^(NoDisplay|Hidden)=true' "$f" && continue
    grep -qE '^(NoDisplay|Hidden)=true' "/usr/local/share/applications/$(basename "$f")" 2>/dev/null && continue
    grep -q '^Type=Application' "$f" || continue
    echo "$(grep -m1 '^Name=' "$f" | cut -c1-40) | $(dpkg -S "$f" 2>/dev/null | cut -d: -f1 | head -1) | $(basename "$f")"
done | sort | head -80
sec "largest installed packages"; dpkg-query -Wf '${Installed-Size}\t${Package}\n' | sort -rn | head -25
echo "installed packages: $(dpkg-query -f '.\n' -W | wc -l)"
sec "journal errors (this boot)"; journalctl -p err -b --no-pager 2>&1 | tail -40
sec gnome-shell journal; journalctl -b --no-pager _COMM=gnome-shell 2>&1 | grep -iE 'error|tind|stylesheet|extension' | tail -25
# daily-machine checks (roadmap d1): one DAILY line per check, "ok" or "FAIL <why>". The installer test prints them
# as warnings for now; they become failures once a few runs show the baseline.
sec "daily machine checks"
daily() { echo "DAILY $1 $2"; }
failed="$(systemctl --failed --no-legend --plain 2>&1 | awk '{print $1}' | tr '\n' ' ')"
[ -z "${failed// /}" ] && daily failed-units ok || daily failed-units "FAIL $failed"
ua="$(cat /etc/apt/apt.conf.d/20tind-auto-upgrades 2>/dev/null)"
if echo "$ua" | grep -q 'Unattended-Upgrade "1"' && systemctl is-enabled apt-daily-upgrade.timer >/dev/null 2>&1 \
   && grep -q 'apt.servr.no\|Tind' /etc/apt/apt.conf.d/52tind-unattended-upgrades 2>/dev/null; then
    daily silent-updates-configured ok
else
    daily silent-updates-configured "FAIL (auto-upgrades file, apt-daily-upgrade.timer or the Tind origin is missing)"
fi
aptout="$(apt-get update 2>&1)"; aptmsg="$(echo "$aptout" | grep -E '^(W|E|N):' | head -3 | tr '\n' '|')"
[ -z "$aptmsg" ] && daily apt-update-quiet ok || daily apt-update-quiet "FAIL $aptmsg"
bad="$(grep -nE 'command not found|Traceback|: line [0-9]+:|Permission denied' /tmp/tind-report-test.txt 2>/dev/null | head -3 | tr '\n' '|')"
[ -s /tmp/tind-report-test.txt ] && [ -z "$bad" ] && daily tind-report-clean ok || daily tind-report-clean "FAIL ${bad:-empty report}"
nag="$(find /etc/xdg/autostart -maxdepth 1 -type f 2>/dev/null | grep -iE 'update-notifier|gnome-software|packagekit' | tr '\n' ' ')"
echo "DAILY info autostart-update-entries: ${nag:-none}"
echo "=====TIND-SELFTEST-END====="
