#!/bin/sh
# Trim leftovers that are not part of the Tind app set.
# Purge only when apt confirms no tind-* package would be removed with them.
for p in systemsettings zutty malcontent-gui yelp; do
    dpkg -s "$p" >/dev/null 2>&1 || continue
    if apt-get -s purge "$p" 2>/dev/null | grep -q '^Remv tind-\|^Remv gnome-shell \|^Remv gnome-control-center '; then
        echo "keeping $p (would remove a Tind core package)"
    else
        apt-get purge -y "$p" || true
    fi
done
# Hide what cannot be purged safely (still installed, just not in the app grid).
for f in vim.desktop im-config.desktop nm-connection-editor.desktop org.freedesktop.IBus.Setup.desktop \
         gnome-system-monitor-kde.desktop kdesystemsettings.desktop systemsettings.desktop \
         zutty.desktop org.freedesktop.MalcontentControl.desktop yelp.desktop \
         libreoffice-draw.desktop libreoffice-math.desktop nvidia-settings.desktop; do
    [ -f "/usr/share/applications/$f" ] && echo "NoDisplay=true" >> "/usr/share/applications/$f"
done
exit 0
