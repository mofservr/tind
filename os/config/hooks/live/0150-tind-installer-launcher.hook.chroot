#!/bin/sh
# rebrand the live-session installer launcher shipped by calamares-settings-debian
set -e
for f in /usr/share/applications/install-debian.desktop /usr/share/applications/calamares.desktop; do
    [ -f "$f" ] || continue
    out=/usr/share/applications/tind-install.desktop
    sed -e 's/^Name\(\[[^]]*\]\)\?=.*/Name=Install Tind/' \
        -e 's/^Icon=.*/Icon=tind-logo/' "$f" > "$out"
    echo "NoDisplay=false" >> "$out"
    echo "NoDisplay=true" >> "$f"
    break
done
exit 0
