#!/bin/sh
# live-build configuration for Tind. Run through build.sh (it copies auto/ and config/ into build/).
set -e
lb config noauto \
    --mode debian \
    --distribution trixie \
    --architectures amd64 \
    --linux-flavours amd64 \
    --archive-areas "main contrib non-free non-free-firmware" \
    --security true --updates true --backports true \
    --apt-recommends true \
    --apt-indices false \
    --firmware-chroot true --firmware-binary true \
    --debian-installer none \
    --binary-images iso-hybrid \
    --bootloaders "syslinux,grub-efi" \
    --bootappend-live "boot=live components quiet splash locales=nb_NO.UTF-8 keyboard-layouts=no timezone=Europe/Oslo username=tind hostname=tind" \
    --iso-application "Tind" \
    --iso-volume "TIND" \
    --iso-publisher "Tind" \
    --image-name tind \
    --memtest none \
    --win32-loader false \
    --checksums sha256 \
    --chroot-squashfs-compression-type xz \
    --debootstrap-options "--include=ca-certificates,gnupg" \
    "${@}"
