[Unit]
Description=Tind: move Turing-or-newer NVIDIA cards to NVIDIA's own driver repository
After=network-online.target
Wants=network-online.target
ConditionPathExists=/usr/lib/tind/nvidia-upgrade
ConditionPathExists=!/var/lib/tind/nvidia-upgrade.done
ConditionPathExists=!/run/live

[Service]
Type=oneshot
ExecStart=/usr/lib/tind/nvidia-upgrade
TimeoutStartSec=1800

[Install]
WantedBy=multi-user.target
