[Unit]
Description=Tind AI, local briefing service (socket)
Requires=tind-ai-firewall.service
After=tind-ai-firewall.service

[Socket]
ListenStream=/run/tind-ai/local.sock
# anyone may connect; the service takes the caller's user id from the kernel and only serves normal login users
SocketMode=0666
DirectoryMode=0755

[Install]
WantedBy=sockets.target
