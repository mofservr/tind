#!/bin/sh
set -e
if [ "$1" = configure ]; then
    systemctl daemon-reload >/dev/null 2>&1 || true
    systemctl enable tind-ai-local.socket >/dev/null 2>&1 || true
    if [ -d /run/systemd/system ]; then
        systemctl try-restart tind-ai-local.service >/dev/null 2>&1 || true
        systemctl restart tind-ai-local.socket || true
    fi
fi
exit 0
