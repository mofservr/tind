    print('LibreOffice Writer: %s' % ('installed (Word, PDF and ODT can be saved)' if writer_available() else
                                      'not installed (documents save as Markdown only)'))
    return rc


# ---- documents: saved from an answer, as Markdown, Word, PDF or ODT ---------------------------------------------------
# Word, PDF and ODT are made on this computer, as you, by LibreOffice Writer (the Productivity and cloud box). The
# answer is untrusted text: it becomes HTML that this file writes itself, every character escaped, with no raw HTML,
# images, styles or anything else that could be fetched; links stay links (http, https, mailto) and are never opened.
FORMATS = {'md': ('Markdown', 'md', None), 'docx': ('Word', 'docx', 'docx:MS Word 2007 XML'),
           'pdf': ('PDF', 'pdf', 'pdf:writer_pdf_Export'), 'odt': ('LibreOffice', 'odt', 'odt:writer8')}
WRITER_HINT = 'Word, PDF and LibreOffice files need LibreOffice: tick Productivity and cloud in Tind Apps.'
DOC_CSS = ('body, h1, h2, h3, h4, h5, h6, p, li, td, th { font-family: "Nunito Sans", "Liberation Sans", sans-serif; } '
           'body { font-size: 11pt; } '
           'pre, code { font-family: "Liberation Mono", monospace; font-size: 9.5pt; } '
           'pre { background: #f3f3f3; } table { border-collapse: collapse; } '
           'td, th { border: 1px solid #999; padding: 3px 6px; } blockquote { color: #555; }')


def doc_title(markdown, fallback='AI answer'):
    for line in markdown.split('\n'):
        m = re.match(r'^ {0,3}#{1,2}\s+(.+?)\s*#*\s*$', line)
        if m:
            return re.sub(r'[*_`]', '', m.group(1)).strip()[:80] or fallback
    return fallback


def writer_available():
    try:
        st = subprocess.run(['dpkg-query', '-W', '-f=${db:Status-Abbrev}', 'libreoffice-writer'],
                            capture_output=True, text=True, timeout=10).stdout
    except (OSError, subprocess.SubprocessError):
        st = ''
    return st.startswith('ii') and shutil.which('soffice') is not None


def _inline(text):
    """One line of Markdown to HTML: everything escaped, then code, links, bold, italic and strike-through."""
    text = text.replace('\0', '')
    codes = []

    def code(m):
        codes.append('<code>%s</code>' % html.escape(m.group(2).strip()))
        return '\0%d\0' % (len(codes) - 1)
    text = re.sub(r'(`+)(.+?)\1', code, text)
    text = html.escape(text, quote=True)
    text = re.sub(r'!\[([^\]]*)\]\([^)]*\)', r'\1', text)                 # images: their text only, nothing fetched

    def link(m):
        url = m.group(2).strip()
        if re.match(r'(https?://|mailto:)', url, re.I):
            return '<a href="%s">%s</a>' % (url, m.group(1))
        return m.group(1)
    text = re.sub(r'\[([^\]]+)\]\(([^)\s]+)(?:\s+&quot;[^)]*&quot;)?\)', link, text)
    text = re.sub(r'(\*\*|__)(?=\S)(.+?)(?<=\S)\1', r'<b>\2</b>', text)
    text = re.sub(r'(?<![\w*])\*(?=\S)(.+?)(?<=\S)\*(?![\w*])', r'<i>\1</i>', text)
    text = re.sub(r'(?<!\w)_(?=\S)(.+?)(?<=\S)_(?!\w)', r'<i>\1</i>', text)
    text = re.sub(r'~~(?=\S)(.+?)(?<=\S)~~', r'<del>\1</del>', text)
    return re.sub(r'\0(\d+)\0', lambda m: codes[int(m.group(1))], text)


LIST_RE = re.compile(r'^(\s*)([-*+]|\d{1,9}[.)])\s+(.*)$')
TABLE_SEP = re.compile(r'^\s*\|?\s*:?-{3,}:?\s*(\|\s*:?-{3,}:?\s*)*\|?\s*$')


def _cells(line):
    line = line.strip()
    if line.startswith('|'):
        line = line[1:]
    if line.endswith('|') and not line.endswith('\\|'):
        line = line[:-1]
    return [c.strip() for c in re.split(r'(?<!\\)\|', line)]


def md_to_html(markdown):
    """The body of a Markdown document as HTML (headings, paragraphs, lists, code, quotes, tables, rules)."""
    lines = markdown.replace('\r\n', '\n').split('\n')
    out = []
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip():
            i += 1
            continue
        fm = FENCE_RE.match(line)
        if fm:
            fence = fm.group(1)
            j = i + 1
            while j < len(lines) and not re.fullmatch(r' {0,3}%s%s*\s*' % (re.escape(fence), re.escape(fence[0])),
                                                      lines[j]):
                j += 1
            out.append('<pre><code>%s</code></pre>' % html.escape('\n'.join(lines[i + 1:j])))
            i = j + 1
            continue
        hm = re.match(r'^ {0,3}(#{1,6})\s+(.*?)\s*#*\s*$', line)
        if hm:
            n = len(hm.group(1))
            out.append('<h%d>%s</h%d>' % (n, _inline(hm.group(2)), n))
            i += 1
            continue
        if re.fullmatch(r' {0,3}([-*_])(\s*\1){2,}\s*', line):
            out.append('<hr/>')
            i += 1
            continue
        if line.lstrip().startswith('>'):
            j = i
            quoted = []
            while j < len(lines) and lines[j].lstrip().startswith('>'):
                quoted.append(re.sub(r'^\s*> ?', '', lines[j]))
                j += 1
            out.append('<blockquote>%s</blockquote>' % md_to_html('\n'.join(quoted)))
            i = j
            continue
        if '|' in line and i + 1 < len(lines) and TABLE_SEP.match(lines[i + 1]):
            rows = ['<tr>%s</tr>' % ''.join('<th>%s</th>' % _inline(c) for c in _cells(line))]
            j = i + 2
            while j < len(lines) and '|' in lines[j] and lines[j].strip():
                rows.append('<tr>%s</tr>' % ''.join('<td>%s</td>' % _inline(c) for c in _cells(lines[j])))
                j += 1
            out.append('<table border="1" cellpadding="4" cellspacing="0">%s</table>' % ''.join(rows))
            i = j
            continue
        if LIST_RE.match(line):
            stack = []          # (indent, tag)
            parts = []
            j = i
            while j < len(lines):
                lm = LIST_RE.match(lines[j])
                if lm:
                    indent = len(lm.group(1).expandtabs(4))
                    tag = 'ul' if lm.group(2)[0] in '-*+' else 'ol'
                    while stack and indent < stack[-1][0]:
                        parts.append('</li></%s>' % stack.pop()[1])
                    if stack and indent == stack[-1][0] and tag != stack[-1][1]:
                        parts.append('</li></%s>' % stack.pop()[1])
                    if not stack or indent > stack[-1][0]:
                        stack.append((indent, tag))
                        parts.append('<%s><li>' % tag)
                    else:
                        parts.append('</li><li>')
                    parts.append(_inline(lm.group(3)))
                    j += 1
                elif lines[j].strip() and lines[j].startswith((' ', '\t')) and stack:
                    parts.append(' ' + _inline(lines[j].strip()))
                    j += 1
                elif not lines[j].strip() and j + 1 < len(lines) and LIST_RE.match(lines[j + 1]):
                    j += 1
                else:
                    break
            while stack:
                parts.append('</li></%s>' % stack.pop()[1])
            out.append(''.join(parts))
            i = j
            continue
        para = []
        while i < len(lines) and lines[i].strip() and not (
                FENCE_RE.match(lines[i]) or re.match(r'^ {0,3}#{1,6}\s', lines[i]) or LIST_RE.match(lines[i])
                or lines[i].lstrip().startswith('>')
                or ('|' in lines[i] and i + 1 < len(lines) and TABLE_SEP.match(lines[i + 1]))):
            para.append(_inline(lines[i].strip()))
            i += 1
        if para:
            out.append('<p>%s</p>' % ' '.join(para))
        else:
            out.append('<p>%s</p>' % _inline(line.strip()))
            i += 1
    return '\n'.join(out)


def md_to_page(markdown, title):
    return ('<!DOCTYPE html>\n<html><head><meta charset="utf-8"><title>%s</title><style>%s</style></head>\n'
            '<body>\n%s\n</body></html>\n' % (html.escape(title), DOC_CSS, md_to_html(markdown)))


def unique_path(folder, base, ext):
    """A new file name in folder: "<base>.<ext>", then "<base>-2.<ext>" and so on. Never an existing file."""
    base = re.sub(r'[/\\\0]', '-', base).strip(' .') or 'Document'
    n = 1
    while True:
        path = os.path.join(folder, '%s%s.%s' % (base, '' if n == 1 else '-%d' % n, ext))
        if not os.path.lexists(path):
            return path
        n += 1


def _write_new(path, data):
    """Write a file that must not exist yet (no overwrite, not even in a race), readable by you only."""
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(fd, 'wb') as f:
        f.write(data)


def save_document(folder, markdown, title, fmt, when=None):
    """Save one document into folder as fmt (md, docx, pdf, odt). Returns the new file's path."""
    if fmt not in FORMATS:
        raise ValueError('unknown format %s' % fmt)
    name, ext, filt = FORMATS[fmt]
    make_dir(folder)
    base = '%s %s' % (time.strftime('%Y-%m-%d', time.localtime(time.time() if when is None else when)), title)
    markdown = markdown.strip('\n') + '\n'
    if fmt == 'md':
        for _ in range(5):
            path = unique_path(folder, base, ext)
            try:
                _write_new(path, markdown.encode('utf-8'))
                return path
            except FileExistsError:
                continue
        raise OSError('could not find a free file name in %s' % folder)
    if not writer_available():
        raise RuntimeError(WRITER_HINT)
    work = tempfile.mkdtemp(prefix='tind-ai-doc-')
    try:
        src = os.path.join(work, 'document.html')
        with open(src, 'w', encoding='utf-8') as f:
            f.write(md_to_page(markdown, title))
        profile = Gio_uri(os.path.join(work, 'profile'))
        cmd = ['soffice', '-env:UserInstallation=' + profile, '--headless', '--invisible', '--norestore', '--nologo',
               '--nodefault', '--nolockcheck', '--infilter=HTML (StarWriter)', '--convert-to', filt,
               '--outdir', os.path.join(work, 'out'), src]
        res = subprocess.run(cmd, capture_output=True, text=True, timeout=180, cwd=work, stdin=subprocess.DEVNULL)
        made = os.path.join(work, 'out', 'document.' + ext)
        if not os.path.isfile(made) or os.path.getsize(made) == 0:
            why = (res.stderr or res.stdout or 'no file was made').strip().split('\n')[-1][:200]
            raise RuntimeError('LibreOffice could not make the %s file: %s' % (name, why))
        with open(made, 'rb') as f:
            data = f.read()
        for _ in range(5):
            path = unique_path(folder, base, ext)
            try:
                _write_new(path, data)
                return path
            except FileExistsError:
                continue
        raise OSError('could not find a free file name in %s' % folder)
    finally:
        shutil.rmtree(work, ignore_errors=True)


def Gio_uri(path):  # noqa: N802 - a file:// URI without importing GTK (the CLI and tests run without it)
    from urllib.parse import quote
    return 'file://' + quote(os.path.abspath(path))


def cli_document(path, fmt):
    settings = load_json(SETTINGS, {})
    try:
        with open(path, encoding='utf-8') as f:
            md = f.read()
        out = save_document(sub_dir(settings, 'Documents'), md, doc_title(md, os.path.splitext(
            os.path.basename(path))[0]), fmt)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as e:
        print('not saved: %s' % e)
        return 2 if isinstance(e, RuntimeError) and str(e) == WRITER_HINT else 1
    print('saved %s' % out)
    return 0


def cli_migrate():
    settings = load_json(SETTINGS, {})
    moved = migrate_old_export(settings)
    if moved:
        print('export folder moved to %s' % moved)
    try:
        n = migrate_old_chats(sub_dir(settings, 'ChatArchive'), restore_texts)
    except OSError as e:
        print('chats not migrated: %s' % e)
        return 1
    print('chats migrated: %d' % n)
    return 0


# ---- the window ---------------------------------------------------------------------------------------------------
def main(open_target=None):
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk

    CSS = """
    .tind-me { background: alpha(@accent_bg_color, 0.16); border-radius: 14px; padding: 9px 14px; }
    .tind-ai { background: alpha(currentColor, 0.05); border-radius: 14px; padding: 9px 14px; }
    .tind-code { background: alpha(currentColor, 0.07); border-radius: 8px; padding: 4px 10px 8px 10px; }
    .tind-code label.tind-code-text { font-family: monospace; font-size: 0.93em; }
    .tind-meta { font-size: 0.85em; }
    .tind-sent { font-family: monospace; font-size: 0.88em; }
    .tind-composer { background: alpha(currentColor, 0.05); border-radius: 14px; padding: 6px; }
    .tind-composer textview, .tind-composer textview text { background: transparent; }
    .tind-chip { font-size: 0.9em; padding: 0 4px; }
    .tind-doc { background: @card_bg_color; border: 1px solid alpha(currentColor, 0.15); border-radius: 10px;
                padding: 8px 12px 10px 12px; }
    /* price bands: libadwaita's own colours; the band's name is always written next to or under the mark */
    .tind-dot { font-size: 0.8em; }
    .tind-band-free { color: #3584e4; }
    .tind-band-cheap { color: @success_color; }
    .tind-band-mid { color: @warning_color; }
    .tind-band-expensive { color: @error_color; }
    .tind-band-unknown { color: alpha(currentColor, 0.4); }
    """

    def bg(work, done):
        """Run work() in a thread, then done(result, error) on the main loop."""
        def run():
            try:
                res, err = work(), None
            except Exception as e:  # noqa: BLE001 - shown to the user as text
                res, err = None, e
            GLib.idle_add(lambda: (done(res, err), False)[1])
        threading.Thread(target=run, daemon=True).start()

    def dot(b):
        """The coloured mark for a price band."""
        return Gtk.Label(label='●', css_classes=['tind-dot', 'tind-band-' + b], tooltip_text=BAND_NAMES[b],
                         valign=Gtk.Align.CENTER)

    def label(text='', classes=(), **kw):
        lab = Gtk.Label(label=text, xalign=0, wrap=True, css_classes=list(classes), **kw)
        lab.set_wrap_mode(2)  # Pango WORD_CHAR
        return lab

    class Win(Adw.ApplicationWindow):
        def __init__(self, app, open_target):
            super().__init__(application=app, title='AI assistant', default_width=1040, default_height=740)
            self.settings = load_json(SETTINGS, {})
            self.providers = tindai.providers()
            self.default_pid = load_json(tindai.PROVIDERS_FILE, {}).get('default', self.providers[0]['id'])
            self.chat = None
            self.attach = {'journal': False, 'report': False, 'steam': False, 'files': []}
            self.busy = False
            self.templates = load_templates()
            self.prices = load_prices()
            self.back_to = 'chat'
            self.tpl, self.tpl_views, self.tpl_checks = None, {}, {}

            self.toasts = Adw.ToastOverlay()
            self.split = Adw.NavigationSplitView(min_sidebar_width=230, max_sidebar_width=300)
            self.toasts.set_child(self.split)
            self.set_content(self.toasts)
            self.split.set_sidebar(self.build_sidebar())
            self.split.set_content(self.build_content())

            keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
            keys.connect('key-pressed', self.on_window_key)
            self.add_controller(keys)

            self.migrate()
            self.refresh_sidebar()
            # the archive is plain files: a chat renamed, moved or deleted by hand shows up when the window is used again
            self.connect('notify::is-active', lambda *_: self.is_active() and not self.busy and self.refresh_sidebar())
            chats = all_chats(self.archive())
            if not os.path.exists(ACCEPTED):
                self.show_guide()
            elif open_target == 'prices':
                self.new_chat()
                self.show_prices()
            elif open_target == 'last' and chats:
                self.open_chat(chats[0][1])
            else:
                self.new_chat()

        # ---- the TindAI folder ------------------------------------------------------------------------------------
        def archive(self):
            return sub_dir(self.settings, 'ChatArchive')

        def migrate(self):
            """Once: ~/AI-export into the TindAI folder, and the old JSON chats into the archive (with the answers'
            placeholders put back). Quick, so it runs before the sidebar is filled; a failure is shown, not fatal."""
            try:
                migrate_old_export(self.settings)
                n = migrate_old_chats(self.archive(), restore_texts)
                if n:
                    GLib.idle_add(lambda: (self.toast('%d chats moved to %s' % (
                        n, home_short(self.archive()))), False)[1])
            except OSError as e:
                GLib.idle_add(lambda: (self.toast('Could not move the old chats: %s' % e), False)[1])

        def open_path(self, path):
            try:
                make_dir(path) if not os.path.exists(path) else None
                Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)
            except (GLib.Error, OSError) as e:
                self.toast('Could not open %s: %s' % (home_short(path), getattr(e, 'message', e)))

        def folder_dialog(self):
            root = ai_root(self.settings)
            dlg = Adw.AlertDialog(heading='TindAI folder', body=(
                'Chats (ChatArchive), saved documents (Documents) and exports (Export) are kept here, readable by you '
                'only. The chat archive shows your real names and addresses. A folder you sync (Nextcloud and the '
                'like) sends them on.'))
            grp = Adw.PreferencesGroup()
            row = Adw.ActionRow(title='Folder', subtitle=GLib.markup_escape_text(home_short(root)))
            grp.add(row)
            dlg.set_extra_child(grp)
            dlg.add_response('close', 'Close')
            dlg.add_response('open', 'Open')
            dlg.add_response('change', 'Change…')
            dlg.set_close_response('close')

            def picked(d, res):
                try:
                    f = d.select_folder_finish(res)
                except GLib.Error:
                    return
                if f and f.get_path():
                    self.change_folder(f.get_path())

            def respond(_d, r):
                if r == 'open':
                    self.open_path(root)
                elif r == 'change':
                    fd = Gtk.FileDialog(title='TindAI folder', modal=True)
                    start = root if os.path.isdir(root) else os.path.expanduser('~')
                    fd.set_initial_folder(Gio.File.new_for_path(start))
                    fd.select_folder(self, None, picked)
            dlg.connect('response', respond)
            dlg.present(self)

        def change_folder(self, new):
            old = ai_root(self.settings)
            if os.path.realpath(new) == os.path.realpath(old):
                return
            for name in SUBDIRS:
                src = os.path.realpath(os.path.join(old, name))
                if os.path.realpath(new) == src or os.path.realpath(new).startswith(src + os.sep):
                    self.toast('Pick a folder outside %s.' % home_short(src))
                    return

            def use(move):
                note = ''
                if move:
                    try:
                        moved, kept = move_folder(old, new)
                    except (OSError, ValueError) as e:
                        self.toast('Not moved: %s' % e)
                        return
                    if kept:
                        note = ' %d files kept in %s (the name was taken).' % (len(kept), home_short(old))
                self.settings['folder'] = new
                self.settings.pop('export_dir', None)
                save_json(SETTINGS, self.settings, 0o644)
                if self.chat:
                    self.chat.pop('_path', None)        # the open chat is saved in the new folder from now on
                self.refresh_sidebar()
                self.toast('The TindAI folder is now %s.%s' % (home_short(new), note))

            if not folder_has_files(old):
                use(False)
                return
            dlg = Adw.AlertDialog(heading='Move your chats and documents?', body=(
                'Move ChatArchive, Documents and Export from %s to %s? Files are never overwritten: one whose name is '
                'taken stays where it is. If you keep them where they are, the window starts empty in the new '
                'folder.' % (home_short(old), home_short(new))))
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('keep', 'Keep them there')
            dlg.add_response('move', 'Move')
            dlg.set_response_appearance('move', Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response('move')
            dlg.set_close_response('cancel')
            dlg.connect('response', lambda _d, r: r in ('keep', 'move') and use(r == 'move'))
            dlg.present(self)

        # ---- sidebar ----------------------------------------------------------------------------------------------
        def build_sidebar(self):
            view = Adw.ToolbarView()
            head = Adw.HeaderBar()
            head.set_title_widget(Adw.WindowTitle(title='Chats'))
            new = Gtk.Button(icon_name='document-new-symbolic', tooltip_text='New chat (Ctrl+N)')
            new.connect('clicked', lambda *_: self.new_chat())
            head.pack_start(new)
            view.add_top_bar(head)
            self.list = Gtk.ListBox(css_classes=['navigation-sidebar'], selection_mode=Gtk.SelectionMode.SINGLE)
            self.list.set_header_func(self.list_header)
            self.list.connect('row-activated', lambda _l, row: self.open_chat(load_chat(row.path)))
            self.list.set_placeholder(label('No saved chats yet.', ['dim-label'], margin_top=12, margin_start=12))
            sw = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            sw.set_child(self.list)
            view.set_content(sw)
            delall = Gtk.Button(label='Delete all chats', css_classes=['flat'], margin_top=6, margin_bottom=6,
                                margin_start=6, margin_end=6)
            delall.connect('clicked', lambda *_: self.confirm_delete_all())
            view.add_bottom_bar(delall)
            return Adw.NavigationPage(title='Chats', child=view)

        def list_header(self, row, before):
            if before is not None and before.pid == row.pid:
                row.set_header(None)
                return
            p = next((x for x in self.providers if x['id'] == row.pid), {'name': row.pid, 'country': ''})
            row.set_header(label(tindai.provider_label(p), ['heading'], margin_top=10, margin_start=10,
                                 margin_bottom=2))

        def refresh_sidebar(self):
            order = {p['id']: i for i, p in enumerate(self.providers)}
            chats = sorted(all_chats(self.archive()), key=lambda pc: (order.get(pc[1]['provider'], 99), -pc[1].get('updated', 0)))
            while (row := self.list.get_row_at_index(0)) is not None:
                self.list.remove(row)
            for path, chat in chats:
                row = Gtk.ListBoxRow()
                row.path, row.pid, row.cid = path, chat['provider'], chat['id']
                box = Gtk.Box(spacing=6)
                texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
                texts.append(Gtk.Label(label=chat.get('title') or 'New chat', xalign=0, ellipsize=3))
                texts.append(Gtk.Label(label=time.strftime('%d %b %H:%M', time.localtime(chat.get('updated', 0))),
                                       xalign=0, css_classes=['dim-label', 'caption']))
                box.append(texts)
                trash = Gtk.Button(icon_name='user-trash-symbolic', css_classes=['flat'], valign=Gtk.Align.CENTER,
                                   tooltip_text='Delete this chat')
                trash.connect('clicked', lambda _b, c=chat: self.confirm_delete(c))
                box.append(trash)
                row.set_child(box)
                self.list.append(row)
                if self.chat and chat['id'] == self.chat['id']:
                    self.list.select_row(row)

        # ---- content ----------------------------------------------------------------------------------------------
        def build_content(self):
            view = Adw.ToolbarView()
            head = Adw.HeaderBar()
            self.wtitle = Adw.WindowTitle(title='AI assistant')
            head.set_title_widget(self.wtitle)
            self.pbtn = Gtk.MenuButton(tooltip_text='Provider (a chat stays with its provider)')
            self.pbtn.set_popover(self.build_provider_popover())
            head.pack_start(self.pbtn)
            menu = Gio.Menu()
            menu.append('Prices', 'win.prices')
            menu.append('Export logs to a folder…', 'win.export')
            folders = Gio.Menu()
            folders.append('Open saved documents', 'win.open-docs')
            folders.append('TindAI folder…', 'win.folder')
            menu.append_section(None, folders)
            for name, fn in (('prices', lambda *_: self.show_prices()), ('export', lambda *_: self.export_dialog()),
                             ('open-export', lambda *_: self.open_export_folder()),
                             ('open-docs', lambda *_: self.open_path(sub_dir(self.settings, 'Documents'))),
                             ('folder', lambda *_: self.folder_dialog())):
                act = Gio.SimpleAction.new(name, None)
                act.connect('activate', fn)
                self.add_action(act)
            head.pack_end(Gtk.MenuButton(icon_name='open-menu-symbolic', menu_model=menu, tooltip_text='Menu'))
            keybtn = Gtk.Button(icon_name='dialog-password-symbolic', tooltip_text='API key for this provider')
            keybtn.connect('clicked', lambda *_: self.key_dialog())
            head.pack_end(keybtn)
            self.mbtn = Gtk.MenuButton(tooltip_text='Model and price')
            if hasattr(self.mbtn, 'set_always_show_arrow'):     # GTK 4.4+
                self.mbtn.set_always_show_arrow(True)
            mbox = Gtk.Box(spacing=6)
            self.mdot = dot('unknown')
            self.mlabel = Gtk.Label()
            mbox.append(self.mdot)
            mbox.append(self.mlabel)
            self.mbtn.set_child(mbox)
            head.pack_end(self.mbtn)
            view.add_top_bar(head)

            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, vexpand=True)
            self.scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            self.msgbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=16, margin_bottom=16,
                                  margin_start=16, margin_end=16)
            self.scroll.set_child(Adw.Clamp(maximum_size=780, child=self.msgbox))
            self.stack.add_named(self.scroll, 'chat')
            self.stack.add_named(self.build_guide(), 'guide')
            self.stack.add_named(self.build_template_page(), 'template')
            self.stack.add_named(self.build_prices_page(), 'prices')
            view.set_content(self.stack)
            self.composer = self.build_composer()
            view.add_bottom_bar(self.composer)
            return Adw.NavigationPage(title='AI assistant', child=view)

        def build_provider_popover(self):
            pop = Gtk.Popover()
            lb = Gtk.ListBox(css_classes=['boxed-list'], selection_mode=Gtk.SelectionMode.NONE, margin_top=6,
                             margin_bottom=6, margin_start=6, margin_end=6)
            for p in self.providers:
                row = Adw.ActionRow(title=GLib.markup_escape_text(tindai.provider_label(p)), activatable=True)
                if p.get('unavailable'):
                    row.set_subtitle(GLib.markup_escape_text(p['unavailable']))
                    row.set_sensitive(False)          # grayed: this computer cannot do it (yet)
                elif not provider_ready(p):
                    row.set_subtitle('No API key yet')
                row.connect('activated', lambda _r, pid=p['id']: (pop.popdown(), self.pick_provider(pid)))
                lb.append(row)
            pop.set_child(lb)
            return pop

        def build_model_popover(self, p):
            pop = Gtk.Popover()
            lb = Gtk.ListBox(css_classes=['boxed-list'], selection_mode=Gtk.SelectionMode.NONE, margin_top=6,
                             margin_bottom=6, margin_start=6, margin_end=6)
            for m in p['models']:
                e = price_of(self.prices, p, m['id'])
                b = band(self.prices, e)
                row = Adw.ActionRow(title=GLib.markup_escape_text(tindai.model_label(m)), activatable=True,
                                    subtitle=GLib.markup_escape_text('%s · %s' % (BAND_NAMES[b], price_text(e))))
                row.add_prefix(dot(b))
                row.connect('activated', lambda _r, mid=m['id']: (pop.popdown(), self.pick_model(mid)))
                lb.append(row)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            box.append(lb)
            allp = Gtk.Button(label='All prices…', css_classes=['flat'], margin_bottom=4)
            allp.connect('clicked', lambda *_: (pop.popdown(), self.show_prices()))
            box.append(allp)
            pop.set_child(box)
            return pop

        # ---- prices (the shipped list; nothing is looked up) -----------------------------------------------------
        def build_prices_page(self):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, margin_top=24, margin_bottom=24,
                          margin_start=24, margin_end=24)
            box.append(label('Prices', ['title-2']))
            box.append(label('Per million tokens, input and output, in the provider\'s own currency, before VAT. '
                             'A token is about three quarters of a word. Tind\'s list is from %s and comes with Tind '
                             'updates; providers change their prices, so check their page before you rely on it.'
                             % as_of_text(self.prices), ['dim-label']))
            cheap, mid = self.prices['limits']
            num = lambda x: ('%g' % x)  # noqa: E731
            legend = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, column_spacing=18, row_spacing=4,
                                 max_children_per_line=5, homogeneous=False)
            for b, text in (('free', 'Free'), ('cheap', 'Cheap: under %s' % num(cheap)),
                            ('mid', 'Mid: %s to %s' % (num(cheap), num(mid))),
                            ('expensive', 'Expensive: over %s' % num(mid)), ('unknown', 'Price unknown')):
                item = Gtk.Box(spacing=6)
                item.append(dot(b))
                item.append(Gtk.Label(label=text, css_classes=['caption']))
                legend.append(item)
            box.append(legend)
            box.append(label('The colour counts 3 parts input to 1 part output, the usual mix in a chat; € and $ are '
                             'treated alike. Free means a model on this computer.', ['dim-label', 'caption']))
            for p in self.providers:
                grp = Adw.PreferencesGroup(title=GLib.markup_escape_text(tindai.provider_label(p)))
                models = p['models'] or [{'id': '', 'name': 'No model yet' if p.get('service') == 'local'
                                          else 'The model you set'}]
                for m in models:
                    e = price_of(self.prices, p, m['id'])
                    b = band(self.prices, e)
                    sub = price_text(e)
                    if e and e.get('note'):
                        sub += '\n' + e['note']
                    row = Adw.ActionRow(title=GLib.markup_escape_text(tindai.model_label(m)),
                                        subtitle=GLib.markup_escape_text(sub))
                    row.add_prefix(dot(b))
                    row.add_suffix(Gtk.Label(label=BAND_NAMES[b], css_classes=['dim-label', 'caption']))
                    grp.add(row)
                box.append(grp)
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
            sw.set_child(Adw.Clamp(maximum_size=640, child=box))
            actions = Gtk.Box(halign=Gtk.Align.END, margin_top=8, margin_bottom=12, margin_start=24, margin_end=24)
            back = Gtk.Button(label='Back', css_classes=['pill'])
            back.connect('clicked', lambda *_: self.close_prices())
            actions.append(back)
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            page.append(sw)
            page.append(Gtk.Separator())
            page.append(Adw.Clamp(maximum_size=640, child=actions))
            return page

        def show_prices(self):
            if self.stack.get_visible_child_name() == 'prices':
                return
            self.back_to = self.stack.get_visible_child_name()
            self.stack.set_visible_child_name('prices')
            self.composer.set_visible(False)
            self.update_templates()

        def close_prices(self):
            self.stack.set_visible_child_name(self.back_to or 'chat')
            self.composer.set_visible(self.back_to != 'template')
            self.update_templates()

        # ---- export (for AI apps outside this window) -------------------------------------------------------------
        def export_dialog(self):
            if not os.path.exists(ACCEPTED):
                self.toast('Accept the guide first.')
                return
            folder = [export_dir(self.settings)]
            last = self.settings.get('export_items')
            ticked = [k for k in last if k in EXPORT_FILES] if isinstance(last, list) else ['report', 'journal']
            dlg = Adw.AlertDialog(heading='Export logs to a folder',
                                  body='For AI apps outside this window, such as Claude Desktop: point them at the '
                                       'folder. Each export replaces the previous one. The folder follows the TindAI '
                                       'folder (menu > TindAI folder).')
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            checks = {}
            for key, text in (('report', 'Tind report (hardware, drivers, setup)'),
                              ('journal', 'System log (this boot, warnings and errors)'),
                              ('steam', 'Steam and Proton logs')):
                checks[key] = Gtk.CheckButton(label=text, active=key in ticked)
                box.append(checks[key])
            raw = Gtk.CheckButton(label='Unredacted: keep names, addresses and keys', margin_top=8)
            rawnote = label('Those apps run outside the walls and can send the files on exactly as they are.',
                            ['error', 'caption'], visible=False)
            raw.connect('toggled', lambda b: rawnote.set_visible(b.get_active()))
            box.append(raw)
            box.append(rawnote)
            grp = Adw.PreferencesGroup(margin_top=10)
            where = Adw.ActionRow(title='Folder', subtitle=GLib.markup_escape_text(home_short(folder[0])))
            grp.add(where)
            box.append(grp)

            dlg.set_extra_child(box)
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('export', 'Export')
            dlg.set_response_appearance('export', Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response('export')
            dlg.set_close_response('cancel')

            def update(*_):
                dlg.set_response_enabled('export', any(c.get_active() for c in checks.values()))
            for c in checks.values():
                c.connect('toggled', update)
            update()

            def respond(_d, r):
                if r != 'export':
                    return
                keys = [k for k in EXPORT_FILES if checks[k].get_active()]
                self.settings['export_items'] = keys
                save_json(SETTINGS, self.settings, 0o644)
                self.do_export(keys, raw.get_active(), folder[0])
            dlg.connect('response', respond)
            dlg.present(self)

        def do_export(self, keys, raw, folder):
            self.toast('Exporting…')

            def done(res, err):
                if err:
                    self.toast('Not exported: %s' % err)
                    return
                path, names, red = res
                hidden = 'nothing hidden' if raw else ('hidden: ' + ', '.join(
                    '%d %s' % (n, k) for k, n in sorted(red.items())) if red else 'nothing needed hiding')
                t = Adw.Toast(title=GLib.markup_escape_text('Exported %d files to %s (%s)' % (
                    len(names), home_short(path), hidden)), timeout=8, button_label='Open folder',
                    action_name='win.open-export')
                self.toasts.add_toast(t)
            bg(lambda: run_export(keys, raw, folder), done)

        def open_export_folder(self):
            path = export_dir(self.settings)
            try:
                Gio.AppInfo.launch_default_for_uri(Gio.File.new_for_path(path).get_uri(), None)
            except GLib.Error as e:
                self.toast('Could not open %s: %s' % (home_short(path), e.message))

        def build_guide(self):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=24, margin_bottom=24,
                          margin_start=24, margin_end=24)
            box.append(label('Before you start', ['title-2']))
            box.append(label(GUIDE))
            self.accept = Gtk.CheckButton(label='I accept the responsibility and risk of using AI')
            box.append(self.accept)
            go = Gtk.Button(label='Continue', halign=Gtk.Align.END, sensitive=False,
                            css_classes=['suggested-action', 'pill'])
            self.accept.connect('toggled', lambda b: go.set_sensitive(b.get_active()))
            go.connect('clicked', self.on_accept)
            box.append(go)
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            sw.set_child(Adw.Clamp(maximum_size=640, child=box))
            return sw

        def build_composer(self):
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=6, margin_bottom=10,
                            margin_start=16, margin_end=16)
            self.chips = Gtk.Box(spacing=6, visible=False)
            self.tpl_row = self.build_template_chips()
            self.rawnote = label('Unredacted: the next message is sent exactly as typed, nothing is hidden.',
                                 ['error', 'caption'], visible=False)
            box = Gtk.Box(spacing=6, css_classes=['tind-composer'])
            add = Gtk.MenuButton(icon_name='list-add-symbolic', tooltip_text='Attach system data or files',
                                 valign=Gtk.Align.END, css_classes=['flat', 'circular'])
            add.set_popover(self.build_attach_popover())
            self.input = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=8, bottom_margin=8,
                                      left_margin=6, right_margin=6, hexpand=True, accepts_tab=False)
            keys = Gtk.EventControllerKey()
            keys.connect('key-pressed', self.on_input_key)
            self.input.add_controller(keys)
            isw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True,
                                     max_content_height=180, hexpand=True)
            isw.set_child(self.input)
            self.rawbtn = Gtk.ToggleButton(label='Unredacted', valign=Gtk.Align.END, css_classes=['flat'],
                                           tooltip_text='Send the next message exactly as typed (nothing hidden)')
            self.rawbtn.connect('toggled', lambda b: self.rawnote.set_visible(b.get_active()))
            self.sendbtn = Gtk.Button(icon_name='go-up-symbolic', valign=Gtk.Align.END, tooltip_text='Send (Enter)',
                                      css_classes=['suggested-action', 'circular'])
            self.sendbtn.connect('clicked', lambda *_: self.on_send())
            for w in (add, isw, self.rawbtn, self.sendbtn):
                box.append(w)
            for w in (self.tpl_row, self.chips, self.rawnote, box):
                outer.append(w)
            hint = label('Enter sends, Shift+Enter adds a line. Attaching system data shows you the text first.',
                         ['dim-label', 'caption'])
            outer.append(hint)
            return Adw.Clamp(maximum_size=812, child=outer)

        # ---- task templates (static text, no model call) ---------------------------------------------------------
        def build_template_chips(self):
            row = Gtk.Box(spacing=6)
            row.append(Gtk.Label(label='Start from:', css_classes=['dim-label', 'caption']))
            for t in self.templates:
                b = Gtk.Button(label=t['title'], css_classes=['pill', 'tind-chip'], tooltip_text=t['hint'] or None)
                b.connect('clicked', lambda _b, t=t: self.open_template(t))
                row.append(b)
            sw = Gtk.ScrolledWindow(vscrollbar_policy=Gtk.PolicyType.NEVER, hscrollbar_policy=Gtk.PolicyType.AUTOMATIC,
                                    propagate_natural_height=True, visible=False)
            sw.set_child(row)
            return sw

        def build_template_page(self):
            self.tpl_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_top=24, margin_bottom=24,
                                   margin_start=24, margin_end=24)
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, vexpand=True)
            sw.set_child(Adw.Clamp(maximum_size=640, child=self.tpl_box))
            # the buttons stay in view below the scrolling form
            self.tpl_actions = Gtk.Box(spacing=8, halign=Gtk.Align.END, margin_top=8, margin_bottom=12,
                                       margin_start=24, margin_end=24)
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            page.append(sw)
            page.append(Gtk.Separator())
            page.append(Adw.Clamp(maximum_size=640, child=self.tpl_actions))
            return page

        def update_templates(self):
            """The chips show in an empty chat only: they start a task, free typing stays the default."""
            show = bool(self.templates) and self.tpl is None and self.chat is not None and not self.busy \
                and not self.chat['messages'] and self.stack.get_visible_child_name() == 'chat'
            self.tpl_row.set_visible(show)

        def open_template(self, tpl):
            if self.busy or self.chat is None or self.chat['messages']:
                return
            buf = self.input.get_buffer()
            typed = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
            box = self.tpl_box
            while (child := box.get_first_child()) is not None:
                box.remove(child)
            self.tpl, self.tpl_views, self.tpl_checks = tpl, {}, {}
            box.append(label(tpl['title'], ['title-2']))
            if tpl['hint']:
                box.append(label(tpl['hint'], ['dim-label']))
            for i, f in enumerate(tpl['fields']):
                box.append(label(f.get('label', f['id']) + ('' if f.get('required') else ' (optional)'),
                                 ['heading'], margin_top=6))
                tv = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=8, bottom_margin=8, left_margin=8,
                                  right_margin=8, accepts_tab=False)
                if i == 0 and typed:                  # what was already typed becomes the first answer
                    tv.get_buffer().set_text(typed)
                tv.get_buffer().connect('changed', lambda *_: self.tpl_validate())
                keys = Gtk.EventControllerKey()
                keys.connect('key-pressed', self.on_template_key)
                tv.add_controller(keys)
                fsw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, css_classes=['card'],
                                         min_content_height=max(1, int(f.get('lines', 2))) * 22 + 18)
                fsw.set_child(tv)
                box.append(fsw)
                if f.get('example'):
                    box.append(label('For example: ' + str(f['example']), ['dim-label', 'caption']))
                self.tpl_views[f['id']] = tv
            box.append(label('Send along', ['heading'], margin_top=10))
            for key, text in (('report', 'Tind report (hardware, drivers, setup)'),
                              ('journal', 'System log (this boot, warnings and errors)'),
                              ('steam', 'Steam and Proton logs')):
                cb = Gtk.CheckButton(label=text, active=key in tpl['attach'])
                self.tpl_checks[key] = cb
                box.append(cb)
            box.append(label('Attached data is shown to you in full before anything is sent. Names, addresses and '
                             'keys are hidden first.', ['dim-label', 'caption']))
            while (child := self.tpl_actions.get_first_child()) is not None:
                self.tpl_actions.remove(child)
            back = Gtk.Button(label='Back', css_classes=['flat'])
            back.connect('clicked', self.close_template)
            self.tpl_go = Gtk.Button(label='Write the message', css_classes=['suggested-action', 'pill'],
                                     tooltip_text='Puts the message in the box below, ready to read, change and send '
                                                  '(Ctrl+Enter)')
            self.tpl_go.connect('clicked', self.submit_template)
            self.tpl_actions.append(back)
            self.tpl_actions.append(self.tpl_go)
            self.tpl_validate()
            self.stack.set_visible_child_name('template')
            self.composer.set_visible(False)
            self.update_templates()
            first = self.tpl_views[tpl['fields'][0]['id']]
            first.grab_focus()

        def tpl_values(self):
            out = {}
            for fid, tv in self.tpl_views.items():
                b = tv.get_buffer()
                out[fid] = b.get_text(b.get_start_iter(), b.get_end_iter(), False).strip()
            return out

        def tpl_validate(self):
            go = getattr(self, 'tpl_go', None)
            if go is not None and self.tpl is not None:
                go.set_sensitive(not missing_required(self.tpl, self.tpl_values()))

        def on_template_key(self, _ctl, keyval, _code, state):
            if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and state & Gdk.ModifierType.CONTROL_MASK:
                self.submit_template()
                return True
            return False

        def close_template(self, *_):
            self.tpl, self.tpl_views, self.tpl_checks = None, {}, {}
            self.composer.set_visible(True)
            self.stack.set_visible_child_name('chat')
            self.update_templates()
            self.input.grab_focus()

        def submit_template(self, *_):
            tpl, vals = self.tpl, self.tpl_values()
            if tpl is None or missing_required(tpl, vals):
                return
            attached = [k for k, cb in self.tpl_checks.items() if cb.get_active()]
            text = compose_prompt(tpl, vals, attached)
            for k in ATTACH_KEYS:
                self.attach[k] = k in attached
            self.draw_chips()
            self.input.get_buffer().set_text(text)
            self.close_template()

        def build_attach_popover(self):
            pop = Gtk.Popover()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=4, margin_bottom=4)
            for key, text in (('journal', 'System log (this boot, warnings and errors)'),
                              ('report', 'Tind report (hardware, drivers, setup)'),
                              ('steam', 'Steam and Proton logs')):
                b = Gtk.Button(label=text, css_classes=['flat'])
                b.get_child().set_xalign(0)
                b.connect('clicked', lambda _b, k=key: (pop.popdown(), self.set_attach(k, True)))
                box.append(b)
            f = Gtk.Button(label='Files…', css_classes=['flat'])
            f.get_child().set_xalign(0)
            f.connect('clicked', lambda *_: (pop.popdown(), self.pick_files()))
            box.append(f)
            box.append(Gtk.Separator(margin_top=2, margin_bottom=2))
            ex = Gtk.Button(label='Export logs to a folder…', css_classes=['flat'],
                            tooltip_text='For AI apps outside this window, such as Claude Desktop')
            ex.get_child().set_xalign(0)
            ex.connect('clicked', lambda *_: (pop.popdown(), self.export_dialog()))
            box.append(ex)
            pop.set_child(box)
            return pop

        # ---- state ------------------------------------------------------------------------------------------------
        def prov(self):
            pid = self.chat['provider'] if self.chat else self.default_pid
            return next((p for p in self.providers if p['id'] == pid), self.providers[0])

        def model(self):
            p = self.prov()
            ids = [m['id'] for m in p['models']]
            want = (self.chat or {}).get('model') or self.settings.get('models', {}).get(p['id'])
            return want if want in ids else (ids[0] if ids else '')

        def update_header(self):
            p = self.prov()
            self.pbtn.set_label(tindai.provider_label(p))
            mid = self.model()
            m = next((x for x in p['models'] if x['id'] == mid), None)
            self.mbtn.set_visible(bool(m))
            if m:
                e = price_of(self.prices, p, mid)
                b = band(self.prices, e)
                self.mlabel.set_label(tindai.model_label(m))
                self.mdot.set_css_classes(['tind-dot', 'tind-band-' + b])
                self.mdot.set_tooltip_text('%s: %s' % (BAND_NAMES[b], price_text(e)))
                self.mbtn.set_popover(self.build_model_popover(p))
            self.wtitle.set_title((self.chat or {}).get('title') or 'New chat')
            self.wtitle.set_subtitle(tindai.provider_label(p))

        def toast(self, text):
            self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(str(text)), timeout=6))

        def show_guide(self):
            self.chat = None
            self.update_header()
            self.stack.set_visible_child_name('guide')
            self.composer.set_sensitive(False)
            self.update_templates()

        def new_chat(self, pid=None):
            if not os.path.exists(ACCEPTED):
                return self.show_guide()
            pid = pid or self.settings.get('provider') or self.default_pid
            if not any(p['id'] == pid and not p.get('unavailable') for p in self.providers):
                pid = self.default_pid
            self.chat = {'id': secrets.token_hex(8), 'provider': pid, 'model': '', 'title': '',
                         'created': int(time.time()), 'updated': int(time.time()), 'messages': []}
            self.chat['model'] = self.model()
            self.list.unselect_all()
            self.render()
            self.input.grab_focus()
            return None

        def open_chat(self, chat):
            if not chat or self.busy or not os.path.exists(ACCEPTED):
                return
            self.chat = chat
            self.render()
            self.refresh_sidebar()

        def save_chat(self):
            if self.chat and self.chat['messages']:
                self.chat['updated'] = int(time.time())
                try:
                    save_chat_file(self.archive(), self.chat)
                except OSError as e:
                    self.toast('The chat was not saved: %s' % e)
                self.refresh_sidebar()

        def render(self):
            self.tpl = None
            self.composer.set_visible(True)
            self.stack.set_visible_child_name('chat')
            self.composer.set_sensitive(True)
            self.update_header()
            while (child := self.msgbox.get_first_child()) is not None:
                self.msgbox.remove(child)
            msgs = self.chat['messages']
            if not msgs:
                p = self.prov()
                where = ('Nothing leaves this computer.' if p.get('service') == 'local' else
                         'Messages go to %s.' % tindai.provider_label(p))
                self.msgbox.append(Adw.StatusPage(
                    title='Ask about this computer', icon_name='dialog-question-symbolic',
                    description='%s Names, addresses and keys are hidden before anything is sent.' % where))
            for m in msgs:
                self.msgbox.append(self.bubble(m))
            self.update_templates()
            GLib.idle_add(self.scroll_end)

        def scroll_end(self):
            adj = self.scroll.get_vadjustment()
            adj.set_value(adj.get_upper())
            return False

        # ---- message widgets --------------------------------------------------------------------------------------
        def bubble(self, m):
            mine = m['role'] == 'user'
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                          halign=Gtk.Align.END if mine else Gtk.Align.FILL)
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                           css_classes=['tind-me' if mine else 'tind-ai'])
            if mine:
                card.append(label(m['text'], selectable=True, max_width_chars=70))
                if m.get('items'):
                    card.append(label('Attached: ' + ', '.join(m['items']), ['dim-label', 'caption']))
            elif m.get('text'):
                for b in split_blocks(m['text']):
                    if b[0] == 'text':
                        card.append(self.text_block(b[1]))
                    elif b[0] == 'doc':
                        card.append(self.doc_card(b[1], b[2]))
                    else:
                        card.append(self.code_block(b[1], b[2]))
            if mine or m.get('text'):
                col.append(card)
            meta = self.meta_line(m)
            if meta:
                col.append(meta)
            return col

        def text_block(self, text):
            lab = label('', selectable=True)
            try:
                lab.set_markup(to_markup(text, GLib.markup_escape_text))
            except GLib.Error:
                lab.set_text(text)
            return lab

        def code_block(self, lang, code):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, css_classes=['tind-code'])
            head = Gtk.Box(spacing=2)
            head.append(Gtk.Label(label=lang, xalign=0, hexpand=True, css_classes=['dim-label', 'caption']))
            for text, fn in (('Copy', self.copy_text), ('Save…', self.save_text)):
                b = Gtk.Button(label=text, css_classes=['flat'])
                b.connect('clicked', lambda _b, f=fn: f(code, lang))
                head.append(b)
            if lang in SHELLS:
                b = Gtk.Button(label='Run in Terminal', css_classes=['flat'],
                               tooltip_text='Shows the script and runs it as you, only if you answer yes')
                b.connect('clicked', lambda *_: self.run_in_terminal(code))
                head.append(b)
            box.append(head)
            box.append(label(code, ['tind-code-text'], selectable=True))
            return box

        def doc_card(self, title, markdown):
            """A finished document from the answer: a preview, Save as (Markdown, Word, PDF, LibreOffice) and Copy."""
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=['tind-doc'])
            head = Gtk.Box(spacing=8)
            head.append(Gtk.Image(icon_name='x-office-document-symbolic'))
            head.append(Gtk.Label(label=title, xalign=0, hexpand=True, ellipsize=3, css_classes=['heading']))
            head.append(self.save_menu(lambda: markdown, title, 'Save as…'))
            copy = Gtk.Button(label='Copy', css_classes=['flat'])
            copy.connect('clicked', lambda *_: self.copy_text(markdown))
            head.append(copy)
            box.append(head)
            body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=4, margin_end=4)
            shown = re.sub(r'\A\s*#{1,2}\s+[^\n]*\n?', '', markdown, count=1) if doc_title(markdown, '') == title \
                else markdown      # the title is in the card's header already
            for b in split_blocks(shown):
                body.append(self.text_block(b[1]) if b[0] == 'text' else self.code_block(b[1], b[2]))
            if shown.count('\n') < 24:      # short: shown whole (a scrolled box would size itself too tall)
                box.append(body)
                return box
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, min_content_height=340,
                                    max_content_height=340, css_classes=['tind-doc-body'])
            sw.set_child(body)
            box.append(sw)
            return box

        def save_menu(self, get_text, title, text):
            """A button with the formats; Word, PDF and LibreOffice are grayed when LibreOffice Writer is missing."""
            btn = Gtk.MenuButton(label=text, css_classes=['flat'], tooltip_text='Save to %s' % home_short(
                sub_dir(self.settings, 'Documents')))
            pop = Gtk.Popover()
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=4, margin_bottom=4,
                          margin_start=4, margin_end=4)
            buttons = {}
            for fmt, (name, ext, _f) in FORMATS.items():
                b = Gtk.Button(css_classes=['flat'])
                b.set_child(Gtk.Label(label='%s (.%s)' % (name, ext), xalign=0))
                b.connect('clicked', lambda _b, f=fmt: (pop.popdown(), self.save_doc(get_text(), title, f)))
                buttons[fmt] = b
                col.append(b)
            hint = label(WRITER_HINT, ['dim-label', 'caption'], max_width_chars=34, margin_top=4, margin_start=6,
                         margin_end=6)
            col.append(hint)
            pop.set_child(col)

            def showing(*_):
                ok = writer_available()
                for fmt, b in buttons.items():
                    b.set_sensitive(fmt == 'md' or ok)
                    b.set_tooltip_text(None if fmt == 'md' or ok else WRITER_HINT)
                hint.set_visible(not ok)
            pop.connect('show', showing)
            btn.set_popover(pop)
            return btn

        def save_doc(self, markdown, title, fmt):
            folder = sub_dir(self.settings, 'Documents')
            self.toast('Saving as %s…' % FORMATS[fmt][0])

            def done(path, err):
                if err:
                    self.toast('Not saved: %s' % err)
                    return
                t = Adw.Toast(title=GLib.markup_escape_text('Saved %s' % home_short(path)), timeout=8,
                              button_label='Open folder', action_name='win.open-docs')
                self.toasts.add_toast(t)
            bg(lambda: save_document(folder, markdown, title, fmt), done)

        def meta_line(self, m):
            if m.get('pending'):
                row = Gtk.Box(spacing=6, halign=Gtk.Align.END if m['role'] == 'user' else Gtk.Align.START)
                row.append(Gtk.Spinner(spinning=True))
                row.append(label(m['pending'], ['dim-label', 'caption']))
                return row
            if m['role'] == 'user':
                if m.get('raw'):
                    return label('Sent unredacted', ['error', 'caption'], halign=Gtk.Align.END)
                red = m.get('redactions') or {}
                if not red:
                    return None
                what = ', '.join('%d %s' % (n, k) for k, n in sorted(red.items()))
                exp = Gtk.Expander(label='Hidden before sending: %s' % what, halign=Gtk.Align.END,
                                   css_classes=['tind-meta', 'dim-label'])
                exp.set_child(label(m.get('sent', ''), ['tind-sent'], selectable=True, max_width_chars=80))
                return exp
            bits = [m.get('provider_name', ''), m.get('model_name', '') or m.get('model', '')]
            if m.get('seconds'):
                bits.append('%s s' % m['seconds'])
            row = Gtk.Box(spacing=6)
            row.append(label(' · '.join(b for b in bits if b), ['dim-label', 'caption'], hexpand=True,
                             valign=Gtk.Align.CENTER))
            if m.get('text'):
                fallback = (self.chat or {}).get('title') or 'AI answer'
                save = self.save_menu(lambda: m['text'], doc_title(m['text'], fallback), 'Save as document')
                save.add_css_class('caption')
                row.append(save)
            return row

        # ---- actions on answers -----------------------------------------------------------------------------------
        def copy_text(self, text, _lang=None):
            self.get_clipboard().set(text)
            self.toast('Copied.')

        def save_text(self, text, lang='text'):
            ext = {'diff': 'patch', 'patch': 'patch', 'bash': 'sh', 'sh': 'sh', 'shell': 'sh', 'python': 'py',
                   'json': 'json', 'ini': 'conf', 'conf': 'conf', 'yaml': 'yaml', 'html': 'html'}.get(lang, 'txt')
            dlg = Gtk.FileDialog(title='Save', initial_name='ai-%s.%s' % ('change' if ext == 'patch' else 'file', ext))

            def done(d, res):
                try:
                    f = d.save_finish(res)
                except GLib.Error:
                    return
                with open(f.get_path(), 'w', encoding='utf-8') as out:
                    out.write(text if text.endswith('\n') else text + '\n')
                self.toast('Saved.')
            dlg.save(self, None, done)

        def run_in_terminal(self, text):
            fd, path = tempfile.mkstemp(prefix='tind-ai-', suffix='.sh')
            with os.fdopen(fd, 'w', encoding='utf-8') as f:
                f.write(text if text.endswith('\n') else text + '\n')
            shown = ('clear; echo "This script came from the AI answer. Read it before you answer."; echo; '
                     'cat -n "$0"; echo; read -r -p "Run it now, as you? [y/N] " a; '
                     'if [ "$a" = y ] || [ "$a" = Y ]; then bash "$0"; echo; echo "Finished (exit $?)."; '
                     'else echo "Not run."; fi; rm -f "$0"; read -r -p "Press Enter to close. " _')
            try:
                subprocess.Popen(['gnome-terminal', '--', 'bash', '-c', shown, path])
            except OSError as e:
                os.unlink(path)
                self.toast('Could not open a terminal: %s' % e)

        # ---- picking --------------------------------------------------------------------------------------------
        def pick_provider(self, pid):
            if self.busy:
                return
            self.settings['provider'] = pid
            save_json(SETTINGS, self.settings, 0o644)
            if self.chat is None:
                self.new_chat(pid)
                return
            if self.chat['messages'] and self.chat['provider'] != pid:
                p = next(x for x in self.providers if x['id'] == pid)
                self.new_chat(pid)
                self.toast('New chat with %s' % tindai.provider_label(p))
                return
            self.chat['provider'] = pid
            self.chat['model'] = ''
            self.chat['model'] = self.model()
            self.render()

        def pick_model(self, mid):
            self.chat['model'] = mid
            self.settings.setdefault('models', {})[self.chat['provider']] = mid
            save_json(SETTINGS, self.settings, 0o644)
            self.update_header()
            self.save_chat()

        def set_attach(self, key, on):
            self.attach[key] = on
            self.draw_chips()

        def pick_files(self):
            dlg = Gtk.FileDialog(title='Files to share')

            def done(d, res):
                try:
                    files = d.open_multiple_finish(res)
                except GLib.Error:
                    return
                for i in range(files.get_n_items()):
                    path = files.get_item(i).get_path()
                    if path and path not in self.attach['files']:
                        self.attach['files'].append(path)
                self.draw_chips()
            dlg.open_multiple(self, None, done)

        def draw_chips(self):
            while (child := self.chips.get_first_child()) is not None:
                self.chips.remove(child)
            names = {'journal': 'System log', 'report': 'Tind report', 'steam': 'Steam logs'}
            items = [(k, names[k]) for k in ('journal', 'report', 'steam') if self.attach[k]]
            items += [('file:' + f, os.path.basename(f)) for f in self.attach['files']]
            for key, text in items:
                b = Gtk.Button(css_classes=['pill', 'tind-chip'], tooltip_text='Remove')
                inner = Gtk.Box(spacing=4)
                inner.append(Gtk.Label(label=text))
                inner.append(Gtk.Image(icon_name='window-close-symbolic'))
                b.set_child(inner)
                b.connect('clicked', lambda _b, k=key: self.drop_chip(k))
                self.chips.append(b)
            self.chips.set_visible(bool(items))

        def drop_chip(self, key):
            if key.startswith('file:'):
                self.attach['files'].remove(key[5:])
            else:
                self.attach[key] = False
            self.draw_chips()

        # ---- sending ----------------------------------------------------------------------------------------------
        def on_input_key(self, _ctl, keyval, _code, state):
            if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and not state & Gdk.ModifierType.SHIFT_MASK:
                self.on_send()
                return True
            return False

        def on_window_key(self, _ctl, keyval, _code, state):
            ctrl = state & Gdk.ModifierType.CONTROL_MASK
            if keyval == Gdk.KEY_Escape:
                if self.stack.get_visible_child_name() == 'prices':
                    self.close_prices()
                elif self.tpl is not None:
                    self.close_template()
                else:
                    self.close()
                return True
            if ctrl and keyval in (Gdk.KEY_w, Gdk.KEY_q):
                self.close()
                return True
            if ctrl and keyval == Gdk.KEY_n:
                self.new_chat()
                return True
            return False

        def on_send(self):
            if self.busy or self.chat is None:
                return
            buf = self.input.get_buffer()
            text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
            if not text:
                return
            p = self.prov()
            if not provider_ready(p):
                if p.get('unavailable'):
                    self.toast(p['unavailable'])
                else:
                    self.toast('Set the API key for %s first.' % tindai.provider_label(p))
                    self.key_dialog()
                return
            att = {'journal': self.attach['journal'], 'report': self.attach['report'],
                   'steam': self.attach['steam'], 'files': list(self.attach['files'])}
            checked = any([att['journal'], att['report'], att['steam'], att['files']])
            raw = self.rawbtn.get_active()
            names = ([n for k, n in (('journal', 'System log'), ('report', 'Tind report'), ('steam', 'Steam logs'))
                      if att[k]] + [os.path.basename(f) for f in att['files']])
            history = [{'role': m['role'], 'text': m.get('sent') or m['text'], 'raw': bool(m.get('raw'))}
                       for m in self.chat['messages'] if m.get('text') and not m.get('pending')]
            msg = {'role': 'user', 'text': text, 'raw': raw, 'items': names, 'pending': 'Preparing on this computer…',
                   'time': int(time.time())}
            if not self.chat['title']:
                self.chat['title'] = text.split('\n')[0][:60]
            self.chat['messages'].append(msg)
            buf.set_text('')
            self.rawbtn.set_active(False)
            self.attach = {'journal': False, 'report': False, 'steam': False, 'files': []}
            self.draw_chips()
            self.busy = True
            self.render()
            pid, model, conv = p['id'], self.model(), self.chat['id']

            def work():
                items = []
                if att['report']:
                    items.append({'name': 'Tind report', 'text': collect_report()})
                if att['steam']:
                    for name, body in collect_steam():
                        items.append({'name': 'Steam log ' + name, 'text': body})
                for f in att['files']:
                    items.append({'name': 'File ' + os.path.basename(f), 'text': tail_file(f)})
                return tindai.call(tindai.LOCAL_SOCKET, {
                    'op': 'brief', 'request': text, 'provider': pid, 'model': model, 'journal': att['journal'],
                    'raw': raw, 'items': items, 'history': history, 'conversation': conv}, timeout=180)

            def prepared(res, err):
                if err or not res.get('ok'):
                    self.fail(msg, 'Could not prepare: %s' % (err or res.get('error')))
                    return
                msg['sent'] = res['text']
                msg['redactions'] = res.get('redactions') or {}
                if checked:
                    msg['pending'] = 'Waiting for you to check the text…'
                    self.render()
                    self.preview(res, lambda: self.send_brief(msg, res['id'], pid, model),
                                 lambda: self.fail(msg, 'Not sent.'))
                else:
                    self.send_brief(msg, res['id'], pid, model)
            bg(work, prepared)

        def preview(self, res, on_send, on_cancel):
            p = self.prov()
            red = res.get('redactions') or {}
            what = ', '.join('%d %s' % (n, k) for k, n in sorted(red.items())) or 'nothing'
            body = 'This exact text goes to %s, and nothing else.\nHidden on this computer: %s.' % (
                tindai.provider_label(p), 'nothing (sent unredacted)' if res.get('raw') else what)
            if res.get('history'):
                body += '\nThe earlier messages of this chat are sent too.'
            dlg = Adw.AlertDialog(heading='Check before sending', body=body)
            if hasattr(dlg, 'set_prefer_wide_layout'):      # libadwaita 1.6+ (trixie has 1.7)
                dlg.set_prefer_wide_layout(True)
            tv = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.WORD_CHAR, monospace=True,
                              top_margin=8, bottom_margin=8, left_margin=8, right_margin=8)
            tv.get_buffer().set_text(res['text'])
            sw = Gtk.ScrolledWindow(min_content_height=320, min_content_width=560, css_classes=['card'])
            sw.set_child(tv)
            dlg.set_extra_child(sw)
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('send', 'Send to %s' % p['name'])
            dlg.set_response_appearance('send', Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response('send')
            dlg.set_close_response('cancel')
            dlg.connect('response', lambda _d, r: on_send() if r == 'send' else on_cancel())
            dlg.present(self)

        def send_brief(self, msg, bid, pid, model):
            p = next(x for x in self.providers if x['id'] == pid)
            msg['pending'] = None
            reply = {'role': 'assistant', 'text': '', 'pending': 'Waiting for %s…' % tindai.provider_label(p)}
            self.chat['messages'].append(reply)
            self.render()
            sock = tindai.LOCAL_SOCKET if p.get('service') == 'local' else tindai.remote_socket(pid)

            conv = self.chat['id']

            def work():
                res = tindai.call(sock, {'op': 'send', 'id': bid, 'model': model}, timeout=300)
                if res.get('ok') and res.get('answer'):
                    try:    # the placeholders back to your real values, for this window and the archive only
                        res['restored'] = restore_texts(conv, [res['answer']])[0]
                    except (OSError, RuntimeError, ValueError, IndexError):
                        pass
                return res

            def answered(res, err):
                if reply in self.chat['messages']:
                    self.chat['messages'].remove(reply)
                if err or not res.get('ok'):
                    self.fail(msg, 'No answer: %s' % (err or res.get('error')))
                    return
                m = next((x for x in p['models'] if x['id'] == res.get('model')), None)
                shown = res.get('restored') or res['answer']
                self.chat['messages'].append({
                    'role': 'assistant', 'text': shown, 'provider_name': tindai.provider_label(p),
                    'model': res.get('model', ''), 'model_name': tindai.model_label(m) if m else res.get('model', ''),
                    'seconds': res.get('seconds'), 'time': int(time.time())})
                if shown != res['answer']:
                    self.chat['messages'][-1]['sent'] = res['answer']   # as received: what the history sends back
                self.busy = False
                self.save_chat()
                self.render()
            bg(work, answered)

        def fail(self, msg, why):
            """The message did not go out: take it back off the chat and put its text back in the box."""
            self.busy = False
            if msg in self.chat['messages']:
                self.chat['messages'].remove(msg)
            if not self.chat['messages']:
                self.chat['title'] = ''
            self.render()
            self.input.get_buffer().set_text(msg['text'])
            self.toast(why)

        # ---- keys, guide, deleting --------------------------------------------------------------------------------
        def on_accept(self, *_):
            os.makedirs(CONFIG_DIR, exist_ok=True)
            open(ACCEPTED, 'w').close()
            self.new_chat()

        def key_dialog(self):
            p = self.prov()
            if p.get('service') == 'local':
                self.toast('This computer needs no key.')
                return
            custom = p['id'] == 'custom'
            dlg = Adw.AlertDialog(heading='API key for %s' % tindai.provider_label(p),
                                  body='%s\n\nThe key is stored for this computer, readable only by the service that '
                                  'talks to this provider. Saving asks for your password.' % p.get('key_help', ''))
            grp = Adw.PreferencesGroup()
            url = Adw.EntryRow(title='Server address (https://…/v1, or http://127.0.0.1:…/v1)')
            mod = Adw.EntryRow(title='Model name')
            key = Adw.PasswordEntryRow(title='API key (leave empty if the server needs none)' if custom else 'API key')
            if custom:
                url.set_text(p.get('base_url') or '')
                mod.set_text(p['models'][0]['id'] if p['models'] else '')
                grp.add(url)
                grp.add(mod)
            grp.add(key)
            dlg.set_extra_child(grp)
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('save', 'Save key')
            dlg.set_response_appearance('save', Adw.ResponseAppearance.SUGGESTED)
            dlg.set_close_response('cancel')

            def respond(_d, r):
                if r != 'save':
                    return
                secret = key.get_text().strip()
                args = ['pkexec', '/usr/lib/tind-ai/setkey', p['id']]
                if custom:
                    args += [url.get_text().strip(), mod.get_text().strip()]
                elif not secret:
                    self.toast('Paste the API key first.')
                    return

                def work():
                    r2 = subprocess.run(args, input=secret + '\n', capture_output=True, text=True, timeout=300)
                    if r2.returncode != 0:
                        raise RuntimeError((r2.stderr or r2.stdout).strip() or 'cancelled')

                def done(_res, err):
                    if err:
                        self.toast('Key not saved: %s' % err)
                        return
                    self.providers = tindai.providers()
                    self.pbtn.set_popover(self.build_provider_popover())
                    self.update_header()
                    self.toast('Key saved for %s.' % tindai.provider_label(p))
                bg(work, done)
            dlg.connect('response', respond)
            dlg.present(self)

        def confirm_delete(self, chat):
            dlg = Adw.AlertDialog(heading='Delete this chat?', body=chat.get('title') or 'New chat')
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('delete', 'Delete')
            dlg.set_response_appearance('delete', Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response('cancel')
            dlg.connect('response', lambda _d, r: r == 'delete' and self.delete_chats([chat]))
            dlg.present(self)

        def confirm_delete_all(self):
            chats = [c for _p, c in all_chats(self.archive())]
            if not chats:
                return
            dlg = Adw.AlertDialog(heading='Delete all %d chats?' % len(chats), body='This cannot be undone.')
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('delete', 'Delete all')
            dlg.set_response_appearance('delete', Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response('cancel')
            dlg.connect('response', lambda _d, r: r == 'delete' and self.delete_chats(chats))
            dlg.present(self)

        def delete_chats(self, chats):
            ids = [c['id'] for c in chats]
            for c in chats:
                try:
                    os.unlink(c.get('_path') or chat_path(self.archive(), c))
                except OSError:
                    pass

            def work():
                for cid in ids:     # the local service forgets the placeholder maps (they hold the real values)
                    tindai.call(tindai.LOCAL_SOCKET, {'op': 'forget', 'conversation': cid}, timeout=30)
            bg(work, lambda _r, _e: None)
            if self.chat and self.chat['id'] in ids:
                self.new_chat()
            self.refresh_sidebar()

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id='no.servr.TindAI', flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
            self.win = None

        def do_startup(self):
            Adw.Application.do_startup(self)
            css = Gtk.CssProvider()
            css.load_from_string(CSS)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def do_activate(self):
            if not self.win:
                self.win = Win(self, open_target)
            self.win.present()

    return App().run([sys.argv[0]])


if __name__ == '__main__':
    if '--check' in sys.argv:
        sys.exit(check())
    if '--templates' in sys.argv:
        sys.exit(check_templates())
    if '--prices' in sys.argv:
        sys.exit(check_prices())
    if '--export' in sys.argv:
        sys.exit(cli_export('--unredacted' in sys.argv))
    if '--migrate' in sys.argv:
        sys.exit(cli_migrate())
    if '--document' in sys.argv[:-1]:
        fmt = sys.argv[sys.argv.index('--format') + 1] if '--format' in sys.argv[:-1] else 'md'
        sys.exit(cli_document(sys.argv[sys.argv.index('--document') + 1], fmt))
    target = sys.argv[sys.argv.index('--open') + 1] if '--open' in sys.argv[:-1] else None
    sys.exit(main(target))
