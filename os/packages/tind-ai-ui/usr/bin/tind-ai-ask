#!/usr/bin/python3
"""tind-ai-ask: the AI assistant's chat window (Super+K). Runs as the human.

  tind-ai-ask              open the window (a second start brings the open window to the front)
  tind-ai-ask --open last  open the most recent chat (used by the CI self-test)
  tind-ai-ask --check      print whether the services answer and which providers have a key (no window)

How a message travels (see /usr/share/doc/tind-ai-users/README):
  1. You type (Direct). Attaching system data (system log, Tind report, Steam logs, files) makes it Checked: the exact
     text is shown before it is sent. This window reads your own files; the system log is added by the local service.
  2. The local service (tind-ai-local, no network) hides names, addresses, keys and other secrets with fixed rules and
     saves the briefing. "Unredacted" skips the rules for one message.
  3. The provider's remote service (tind-ai-remote@PROVIDER) sends that saved briefing and writes the answer to your
     outbox. Nothing in an answer runs by itself.
Chats are kept in ~/.local/share/tind-ai/chats/<provider>/ (readable by you only) until you delete them.
"""
import glob
import json
import os
import re
import secrets
import subprocess
import sys
import tempfile
import threading
import time

sys.path.insert(0, '/usr/lib/tind-ai')
import tindai  # noqa: E402

CONFIG_DIR = os.path.join(os.environ.get('XDG_CONFIG_HOME') or os.path.expanduser('~/.config'), 'tind-ai')
DATA_DIR = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'tind-ai')
CHATS_DIR = os.path.join(DATA_DIR, 'chats')
ACCEPTED = os.path.join(CONFIG_DIR, 'accepted')
SETTINGS = os.path.join(CONFIG_DIR, 'settings.json')
MAX_FILE = 200_000
SHELLS = ('bash', 'sh', 'shell', 'console', 'zsh')

GUIDE = (
    "This window lets an AI service help you with your computer: a setting, an error message, a program that will "
    "not start, a script.\n\n"
    "How it keeps you in control:\n"
    "• What you type is sent with names, addresses, keys and passwords replaced by placeholders such as [user-1] or "
    "[ip-1]. Each message shows what was hidden.\n"
    "• When you attach system data (logs, the Tind report, files) you see the exact text before it is sent.\n"
    "• Only that text goes to the provider named at the top. European providers are the default.\n"
    "• The AI cannot run anything on this computer. Its suggestions are shown to you; you decide what to copy and run.\n\n"
    "AI answers can be wrong. Read a command before you run it, and keep backups of what matters.")


# ---- small helpers (no GTK) -----------------------------------------------------------------------------------------
def load_json(path, default):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, obj, mode=0o600):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + '.tmp'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.rename(tmp, path)


def provider_ready(p):
    if p.get('unavailable'):
        return False
    if p.get('service') == 'local':
        return True
    return os.path.exists(os.path.join(tindai.READY_DIR, p['id']))


def tail_file(path, limit=MAX_FILE):
    with open(path, 'rb') as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - limit))
        data = f.read()
    if b'\0' in data[:4096]:
        raise ValueError('%s is not a text file' % os.path.basename(path))
    return data.decode('utf-8', 'replace')


def collect_report():
    fd, path = tempfile.mkstemp(prefix='tind-report-', suffix='.txt')
    os.close(fd)
    try:
        subprocess.run(['tind-report', path], capture_output=True, timeout=120, check=False)
        return tail_file(path)
    finally:
        os.unlink(path)


def collect_steam():
    home = os.path.expanduser('~')
    found = []
    for pattern in ('.steam/steam/logs/console_log.txt', '.local/share/Steam/logs/console_log.txt',
                    '.steam/steam/logs/stderr.txt', 'steam-*.log'):
        found += glob.glob(os.path.join(home, pattern))
    found = sorted(set(os.path.realpath(f) for f in found), key=os.path.getmtime, reverse=True)[:3]
    return [(os.path.basename(f), tail_file(f, 80_000)) for f in found]


def all_chats():
    """Every saved chat, newest first: list of (path, chat dict)."""
    out = []
    for path in glob.glob(os.path.join(CHATS_DIR, '*', '*.json')):
        chat = load_json(path, None)
        if isinstance(chat, dict) and chat.get('id'):
            out.append((path, chat))
    out.sort(key=lambda pc: pc[1].get('updated', 0), reverse=True)
    return out


def chat_path(chat):
    return os.path.join(CHATS_DIR, chat['provider'], chat['id'] + '.json')


def split_blocks(text):
    """[('text', str) | ('code', lang, str)] from an answer with ``` fenced blocks."""
    out, pos = [], 0
    for m in re.finditer(r'```([A-Za-z0-9_+.-]*)[^\n]*\n(.*?)(?:```|\Z)', text, re.S):
        if m.start() > pos:
            out.append(('text', text[pos:m.start()]))
        out.append(('code', (m.group(1) or 'text').lower(), m.group(2).rstrip('\n')))
        pos = m.end()
    if pos < len(text):
        out.append(('text', text[pos:]))
    return [b for b in out if b[0] == 'code' or b[1].strip()]


def to_markup(text, escape):
    """A little Markdown to Pango markup: headings, bold, inline code, bullets."""
    lines = []
    for line in text.strip('\n').split('\n'):
        head = re.match(r'^(#{1,4})\s+(.*)$', line)
        body = escape(head.group(2) if head else line)
        body = re.sub(r'\*\*(.+?)\*\*', r'<b>\1</b>', body)
        body = re.sub(r'`([^`]+)`', r'<tt>\1</tt>', body)
        body = re.sub(r'^(\s*)[-*] ', r'\1• ', body)
        lines.append('<b>%s</b>' % body if head else body)
    return '\n'.join(lines)


def check():
    rc = 0
    try:
        ok = tindai.call(tindai.LOCAL_SOCKET, {'op': 'ping'}, timeout=30).get('ok')
        print('local service:', 'ok' if ok else 'no')
    except OSError as e:
        print('local service: not answering (%s)' % e)
        rc = 1
    for p in tindai.providers():
        state = p.get('unavailable') or ('key set' if provider_ready(p) else 'no key yet')
        print('%-10s %-30s %s' % (p['id'], tindai.provider_label(p), state))
    print('saved chats: %d' % len(all_chats()))
    return rc


# ---- the window ---------------------------------------------------------------------------------------------------
def main(open_target=None):
    import gi
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    from gi.repository import Adw, Gdk, Gio, GLib, Gtk

    CSS = """
    .tind-me { background: alpha(@accent_bg_color, 0.16); border-radius: 14px; padding: 9px 14px; }
    .tind-ai { background: alpha(currentColor, 0.05); border-radius: 14px; padding: 9px 14px; }
    .tind-code { background: alpha(currentColor, 0.07); border-radius: 8px; padding: 4px 10px 8px 10px; }
    .tind-code label.tind-code-text { font-family: monospace; font-size: 0.93em; }
    .tind-meta { font-size: 0.85em; }
    .tind-sent { font-family: monospace; font-size: 0.88em; }
    .tind-composer { background: alpha(currentColor, 0.05); border-radius: 14px; padding: 6px; }
    .tind-composer textview, .tind-composer textview text { background: transparent; }
    .tind-chip { font-size: 0.9em; padding: 0 4px; }
    """

    def bg(work, done):
        """Run work() in a thread, then done(result, error) on the main loop."""
        def run():
            try:
                res, err = work(), None
            except Exception as e:  # noqa: BLE001 - shown to the user as text
                res, err = None, e
            GLib.idle_add(lambda: (done(res, err), False)[1])
        threading.Thread(target=run, daemon=True).start()

    def label(text='', classes=(), **kw):
        lab = Gtk.Label(label=text, xalign=0, wrap=True, css_classes=list(classes), **kw)
        lab.set_wrap_mode(2)  # Pango WORD_CHAR
        return lab

    class Win(Adw.ApplicationWindow):
        def __init__(self, app, open_target):
            super().__init__(application=app, title='AI assistant', default_width=1040, default_height=740)
            self.settings = load_json(SETTINGS, {})
            self.providers = tindai.providers()
            self.default_pid = load_json(tindai.PROVIDERS_FILE, {}).get('default', self.providers[0]['id'])
            self.chat = None
            self.attach = {'journal': False, 'report': False, 'steam': False, 'files': []}
            self.busy = False

            self.toasts = Adw.ToastOverlay()
            self.split = Adw.NavigationSplitView(min_sidebar_width=230, max_sidebar_width=300)
            self.toasts.set_child(self.split)
            self.set_content(self.toasts)
            self.split.set_sidebar(self.build_sidebar())
            self.split.set_content(self.build_content())

            keys = Gtk.EventControllerKey(propagation_phase=Gtk.PropagationPhase.CAPTURE)
            keys.connect('key-pressed', self.on_window_key)
            self.add_controller(keys)

            self.refresh_sidebar()
            if not os.path.exists(ACCEPTED):
                self.show_guide()
            elif open_target == 'last' and all_chats():
                self.open_chat(all_chats()[0][1])
            else:
                self.new_chat()

        # ---- sidebar ----------------------------------------------------------------------------------------------
        def build_sidebar(self):
            view = Adw.ToolbarView()
            head = Adw.HeaderBar()
            head.set_title_widget(Adw.WindowTitle(title='Chats'))
            new = Gtk.Button(icon_name='document-new-symbolic', tooltip_text='New chat (Ctrl+N)')
            new.connect('clicked', lambda *_: self.new_chat())
            head.pack_start(new)
            view.add_top_bar(head)
            self.list = Gtk.ListBox(css_classes=['navigation-sidebar'], selection_mode=Gtk.SelectionMode.SINGLE)
            self.list.set_header_func(self.list_header)
            self.list.connect('row-activated', lambda _l, row: self.open_chat(load_json(row.path, None)))
            self.list.set_placeholder(label('No saved chats yet.', ['dim-label'], margin_top=12, margin_start=12))
            sw = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            sw.set_child(self.list)
            view.set_content(sw)
            delall = Gtk.Button(label='Delete all chats', css_classes=['flat'], margin_top=6, margin_bottom=6,
                                margin_start=6, margin_end=6)
            delall.connect('clicked', lambda *_: self.confirm_delete_all())
            view.add_bottom_bar(delall)
            return Adw.NavigationPage(title='Chats', child=view)

        def list_header(self, row, before):
            if before is not None and before.pid == row.pid:
                row.set_header(None)
                return
            p = next((x for x in self.providers if x['id'] == row.pid), {'name': row.pid, 'country': ''})
            row.set_header(label(tindai.provider_label(p), ['heading'], margin_top=10, margin_start=10,
                                 margin_bottom=2))

        def refresh_sidebar(self):
            order = {p['id']: i for i, p in enumerate(self.providers)}
            chats = sorted(all_chats(), key=lambda pc: (order.get(pc[1]['provider'], 99), -pc[1].get('updated', 0)))
            while (row := self.list.get_row_at_index(0)) is not None:
                self.list.remove(row)
            for path, chat in chats:
                row = Gtk.ListBoxRow()
                row.path, row.pid, row.cid = path, chat['provider'], chat['id']
                box = Gtk.Box(spacing=6)
                texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
                texts.append(Gtk.Label(label=chat.get('title') or 'New chat', xalign=0, ellipsize=3))
                texts.append(Gtk.Label(label=time.strftime('%d %b %H:%M', time.localtime(chat.get('updated', 0))),
                                       xalign=0, css_classes=['dim-label', 'caption']))
                box.append(texts)
                trash = Gtk.Button(icon_name='user-trash-symbolic', css_classes=['flat'], valign=Gtk.Align.CENTER,
                                   tooltip_text='Delete this chat')
                trash.connect('clicked', lambda _b, c=chat: self.confirm_delete(c))
                box.append(trash)
                row.set_child(box)
                self.list.append(row)
                if self.chat and chat['id'] == self.chat['id']:
                    self.list.select_row(row)

        # ---- content ----------------------------------------------------------------------------------------------
        def build_content(self):
            view = Adw.ToolbarView()
            head = Adw.HeaderBar()
            self.wtitle = Adw.WindowTitle(title='AI assistant')
            head.set_title_widget(self.wtitle)
            self.pbtn = Gtk.MenuButton(tooltip_text='Provider (a chat stays with its provider)')
            self.pbtn.set_popover(self.build_provider_popover())
            head.pack_start(self.pbtn)
            keybtn = Gtk.Button(icon_name='dialog-password-symbolic', tooltip_text='API key for this provider')
            keybtn.connect('clicked', lambda *_: self.key_dialog())
            head.pack_end(keybtn)
            self.mbtn = Gtk.MenuButton(tooltip_text='Model')
            head.pack_end(self.mbtn)
            view.add_top_bar(head)

            self.stack = Gtk.Stack(transition_type=Gtk.StackTransitionType.CROSSFADE, vexpand=True)
            self.scroll = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
            self.msgbox = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=16, margin_bottom=16,
                                  margin_start=16, margin_end=16)
            self.scroll.set_child(Adw.Clamp(maximum_size=780, child=self.msgbox))
            self.stack.add_named(self.scroll, 'chat')
            self.stack.add_named(self.build_guide(), 'guide')
            view.set_content(self.stack)
            self.composer = self.build_composer()
            view.add_bottom_bar(self.composer)
            return Adw.NavigationPage(title='AI assistant', child=view)

        def build_provider_popover(self):
            pop = Gtk.Popover()
            lb = Gtk.ListBox(css_classes=['boxed-list'], selection_mode=Gtk.SelectionMode.NONE, margin_top=6,
                             margin_bottom=6, margin_start=6, margin_end=6)
            for p in self.providers:
                row = Adw.ActionRow(title=GLib.markup_escape_text(tindai.provider_label(p)), activatable=True)
                if p.get('unavailable'):
                    row.set_subtitle(GLib.markup_escape_text(p['unavailable']))
                    row.set_sensitive(False)          # grayed: this computer cannot do it (yet)
                elif not provider_ready(p):
                    row.set_subtitle('No API key yet')
                row.connect('activated', lambda _r, pid=p['id']: (pop.popdown(), self.pick_provider(pid)))
                lb.append(row)
            pop.set_child(lb)
            return pop

        def build_model_popover(self, p):
            pop = Gtk.Popover()
            lb = Gtk.ListBox(css_classes=['boxed-list'], selection_mode=Gtk.SelectionMode.NONE, margin_top=6,
                             margin_bottom=6, margin_start=6, margin_end=6)
            for m in p['models']:
                row = Adw.ActionRow(title=GLib.markup_escape_text(tindai.model_label(m)), activatable=True)
                row.connect('activated', lambda _r, mid=m['id']: (pop.popdown(), self.pick_model(mid)))
                lb.append(row)
            pop.set_child(lb)
            return pop

        def build_guide(self):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14, margin_top=24, margin_bottom=24,
                          margin_start=24, margin_end=24)
            box.append(label('Before you start', ['title-2']))
            box.append(label(GUIDE))
            self.accept = Gtk.CheckButton(label='I accept the responsibility and risk of using AI')
            box.append(self.accept)
            go = Gtk.Button(label='Continue', halign=Gtk.Align.END, sensitive=False,
                            css_classes=['suggested-action', 'pill'])
            self.accept.connect('toggled', lambda b: go.set_sensitive(b.get_active()))
            go.connect('clicked', self.on_accept)
            box.append(go)
            sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER)
            sw.set_child(Adw.Clamp(maximum_size=640, child=box))
            return sw

        def build_composer(self):
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, margin_top=6, margin_bottom=10,
                            margin_start=16, margin_end=16)
            self.chips = Gtk.Box(spacing=6, visible=False)
            self.rawnote = label('Unredacted: the next message is sent exactly as typed, nothing is hidden.',
                                 ['error', 'caption'], visible=False)
            box = Gtk.Box(spacing=6, css_classes=['tind-composer'])
            add = Gtk.MenuButton(icon_name='list-add-symbolic', tooltip_text='Attach system data or files',
                                 valign=Gtk.Align.END, css_classes=['flat', 'circular'])
            add.set_popover(self.build_attach_popover())
            self.input = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, top_margin=8, bottom_margin=8,
                                      left_margin=6, right_margin=6, hexpand=True, accepts_tab=False)
            keys = Gtk.EventControllerKey()
            keys.connect('key-pressed', self.on_input_key)
            self.input.add_controller(keys)
            isw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, propagate_natural_height=True,
                                     max_content_height=180, hexpand=True)
            isw.set_child(self.input)
            self.rawbtn = Gtk.ToggleButton(label='Unredacted', valign=Gtk.Align.END, css_classes=['flat'],
                                           tooltip_text='Send the next message exactly as typed (nothing hidden)')
            self.rawbtn.connect('toggled', lambda b: self.rawnote.set_visible(b.get_active()))
            self.sendbtn = Gtk.Button(icon_name='go-up-symbolic', valign=Gtk.Align.END, tooltip_text='Send (Enter)',
                                      css_classes=['suggested-action', 'circular'])
            self.sendbtn.connect('clicked', lambda *_: self.on_send())
            for w in (add, isw, self.rawbtn, self.sendbtn):
                box.append(w)
            for w in (self.chips, self.rawnote, box):
                outer.append(w)
            hint = label('Enter sends, Shift+Enter adds a line. Attaching system data shows you the text first.',
                         ['dim-label', 'caption'])
            outer.append(hint)
            return Adw.Clamp(maximum_size=812, child=outer)

        def build_attach_popover(self):
            pop = Gtk.Popover()
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_top=4, margin_bottom=4)
            for key, text in (('journal', 'System log (this boot, warnings and errors)'),
                              ('report', 'Tind report (hardware, drivers, setup)'),
                              ('steam', 'Steam and Proton logs')):
                b = Gtk.Button(label=text, css_classes=['flat'])
                b.get_child().set_xalign(0)
                b.connect('clicked', lambda _b, k=key: (pop.popdown(), self.set_attach(k, True)))
                box.append(b)
            f = Gtk.Button(label='Files…', css_classes=['flat'])
            f.get_child().set_xalign(0)
            f.connect('clicked', lambda *_: (pop.popdown(), self.pick_files()))
            box.append(f)
            pop.set_child(box)
            return pop

        # ---- state ------------------------------------------------------------------------------------------------
        def prov(self):
            pid = self.chat['provider'] if self.chat else self.default_pid
            return next((p for p in self.providers if p['id'] == pid), self.providers[0])

        def model(self):
            p = self.prov()
            ids = [m['id'] for m in p['models']]
            want = (self.chat or {}).get('model') or self.settings.get('models', {}).get(p['id'])
            return want if want in ids else (ids[0] if ids else '')

        def update_header(self):
            p = self.prov()
            self.pbtn.set_label(tindai.provider_label(p))
            mid = self.model()
            m = next((x for x in p['models'] if x['id'] == mid), None)
            self.mbtn.set_visible(bool(m))
            if m:
                self.mbtn.set_label(tindai.model_label(m))
                self.mbtn.set_popover(self.build_model_popover(p))
            self.wtitle.set_title((self.chat or {}).get('title') or 'New chat')
            self.wtitle.set_subtitle(tindai.provider_label(p))

        def toast(self, text):
            self.toasts.add_toast(Adw.Toast(title=GLib.markup_escape_text(str(text)), timeout=6))

        def show_guide(self):
            self.chat = None
            self.update_header()
            self.stack.set_visible_child_name('guide')
            self.composer.set_sensitive(False)

        def new_chat(self, pid=None):
            if not os.path.exists(ACCEPTED):
                return self.show_guide()
            pid = pid or self.settings.get('provider') or self.default_pid
            if not any(p['id'] == pid and not p.get('unavailable') for p in self.providers):
                pid = self.default_pid
            self.chat = {'id': secrets.token_hex(8), 'provider': pid, 'model': '', 'title': '',
                         'created': int(time.time()), 'updated': int(time.time()), 'messages': []}
            self.chat['model'] = self.model()
            self.list.unselect_all()
            self.render()
            self.input.grab_focus()
            return None

        def open_chat(self, chat):
            if not chat or self.busy or not os.path.exists(ACCEPTED):
                return
            self.chat = chat
            self.render()
            self.refresh_sidebar()

        def save_chat(self):
            if self.chat and self.chat['messages']:
                self.chat['updated'] = int(time.time())
                save_json(chat_path(self.chat), self.chat)
                self.refresh_sidebar()

        def render(self):
            self.stack.set_visible_child_name('chat')
            self.composer.set_sensitive(True)
            self.update_header()
            while (child := self.msgbox.get_first_child()) is not None:
                self.msgbox.remove(child)
            msgs = self.chat['messages']
            if not msgs:
                p = self.prov()
                where = ('Nothing leaves this computer.' if p.get('service') == 'local' else
                         'Messages go to %s.' % tindai.provider_label(p))
                self.msgbox.append(Adw.StatusPage(
                    title='Ask about this computer', icon_name='dialog-question-symbolic',
                    description='%s Names, addresses and keys are hidden before anything is sent.' % where))
            for m in msgs:
                self.msgbox.append(self.bubble(m))
            GLib.idle_add(self.scroll_end)

        def scroll_end(self):
            adj = self.scroll.get_vadjustment()
            adj.set_value(adj.get_upper())
            return False

        # ---- message widgets --------------------------------------------------------------------------------------
        def bubble(self, m):
            mine = m['role'] == 'user'
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4,
                          halign=Gtk.Align.END if mine else Gtk.Align.FILL)
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                           css_classes=['tind-me' if mine else 'tind-ai'])
            if mine:
                card.append(label(m['text'], selectable=True, max_width_chars=70))
                if m.get('items'):
                    card.append(label('Attached: ' + ', '.join(m['items']), ['dim-label', 'caption']))
            elif m.get('text'):
                for b in split_blocks(m['text']):
                    card.append(self.text_block(b[1]) if b[0] == 'text' else self.code_block(b[1], b[2]))
            if mine or m.get('text'):
                col.append(card)
            meta = self.meta_line(m)
            if meta:
                col.append(meta)
            return col

        def text_block(self, text):
            lab = label('', selectable=True)
            try:
                lab.set_markup(to_markup(text, GLib.markup_escape_text))
            except GLib.Error:
                lab.set_text(text)
            return lab

        def code_block(self, lang, code):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, css_classes=['tind-code'])
            head = Gtk.Box(spacing=2)
            head.append(Gtk.Label(label=lang, xalign=0, hexpand=True, css_classes=['dim-label', 'caption']))
            for text, fn in (('Copy', self.copy_text), ('Save…', self.save_text)):
                b = Gtk.Button(label=text, css_classes=['flat'])
                b.connect('clicked', lambda _b, f=fn: f(code, lang))
                head.append(b)
            if lang in SHELLS:
                b = Gtk.Button(label='Run in Terminal', css_classes=['flat'],
                               tooltip_text='Shows the script and runs it as you, only if you answer yes')
                b.connect('clicked', lambda *_: self.run_in_terminal(code))
                head.append(b)
            box.append(head)
            box.append(label(code, ['tind-code-text'], selectable=True))
            return box

        def meta_line(self, m):
            if m.get('pending'):
                row = Gtk.Box(spacing=6, halign=Gtk.Align.END if m['role'] == 'user' else Gtk.Align.START)
                row.append(Gtk.Spinner(spinning=True))
                row.append(label(m['pending'], ['dim-label', 'caption']))
                return row
            if m['role'] == 'user':
                if m.get('raw'):
                    return label('Sent unredacted', ['error', 'caption'], halign=Gtk.Align.END)
                red = m.get('redactions') or {}
                if not red:
                    return None
                what = ', '.join('%d %s' % (n, k) for k, n in sorted(red.items()))
                exp = Gtk.Expander(label='Hidden before sending: %s' % what, halign=Gtk.Align.END,
                                   css_classes=['tind-meta', 'dim-label'])
                exp.set_child(label(m.get('sent', ''), ['tind-sent'], selectable=True, max_width_chars=80))
                return exp
            bits = [m.get('provider_name', ''), m.get('model_name', '') or m.get('model', '')]
            if m.get('seconds'):
                bits.append('%s s' % m['seconds'])
            return label(' · '.join(b for b in bits if b), ['dim-label', 'caption'])

        # ---- actions on answers -----------------------------------------------------------------------------------
        def copy_text(self, text, _lang=None):
            self.get_clipboard().set(text)
            self.toast('Copied.')

        def save_text(self, text, lang='text'):
            ext = {'diff': 'patch', 'patch': 'patch', 'bash': 'sh', 'sh': 'sh', 'shell': 'sh', 'python': 'py',
                   'json': 'json', 'ini': 'conf', 'conf': 'conf', 'yaml': 'yaml', 'html': 'html'}.get(lang, 'txt')
            dlg = Gtk.FileDialog(title='Save', initial_name='ai-%s.%s' % ('change' if ext == 'patch' else 'file', ext))

            def done(d, res):
                try:
                    f = d.save_finish(res)
                except GLib.Error:
                    return
                with open(f.get_path(), 'w', encoding='utf-8') as out:
                    out.write(text if text.endswith('\n') else text + '\n')
                self.toast('Saved.')
            dlg.save(self, None, done)

        def run_in_terminal(self, text):
            fd, path = tempfile.mkstemp(prefix='tind-ai-', suffix='.sh')
            with os.fdopen(fd, 'w', encoding='utf-8') as f:
                f.write(text if text.endswith('\n') else text + '\n')
            shown = ('clear; echo "This script came from the AI answer. Read it before you answer."; echo; '
                     'cat -n "$0"; echo; read -r -p "Run it now, as you? [y/N] " a; '
                     'if [ "$a" = y ] || [ "$a" = Y ]; then bash "$0"; echo; echo "Finished (exit $?)."; '
                     'else echo "Not run."; fi; rm -f "$0"; read -r -p "Press Enter to close. " _')
            try:
                subprocess.Popen(['gnome-terminal', '--', 'bash', '-c', shown, path])
            except OSError as e:
                os.unlink(path)
                self.toast('Could not open a terminal: %s' % e)

        # ---- picking --------------------------------------------------------------------------------------------
        def pick_provider(self, pid):
            if self.busy:
                return
            self.settings['provider'] = pid
            save_json(SETTINGS, self.settings, 0o644)
            if self.chat is None:
                self.new_chat(pid)
                return
            if self.chat['messages'] and self.chat['provider'] != pid:
                p = next(x for x in self.providers if x['id'] == pid)
                self.new_chat(pid)
                self.toast('New chat with %s' % tindai.provider_label(p))
                return
            self.chat['provider'] = pid
            self.chat['model'] = ''
            self.chat['model'] = self.model()
            self.render()

        def pick_model(self, mid):
            self.chat['model'] = mid
            self.settings.setdefault('models', {})[self.chat['provider']] = mid
            save_json(SETTINGS, self.settings, 0o644)
            self.update_header()
            self.save_chat()

        def set_attach(self, key, on):
            self.attach[key] = on
            self.draw_chips()

        def pick_files(self):
            dlg = Gtk.FileDialog(title='Files to share')

            def done(d, res):
                try:
                    files = d.open_multiple_finish(res)
                except GLib.Error:
                    return
                for i in range(files.get_n_items()):
                    path = files.get_item(i).get_path()
                    if path and path not in self.attach['files']:
                        self.attach['files'].append(path)
                self.draw_chips()
            dlg.open_multiple(self, None, done)

        def draw_chips(self):
            while (child := self.chips.get_first_child()) is not None:
                self.chips.remove(child)
            names = {'journal': 'System log', 'report': 'Tind report', 'steam': 'Steam logs'}
            items = [(k, names[k]) for k in ('journal', 'report', 'steam') if self.attach[k]]
            items += [('file:' + f, os.path.basename(f)) for f in self.attach['files']]
            for key, text in items:
                b = Gtk.Button(css_classes=['pill', 'tind-chip'], tooltip_text='Remove')
                inner = Gtk.Box(spacing=4)
                inner.append(Gtk.Label(label=text))
                inner.append(Gtk.Image(icon_name='window-close-symbolic'))
                b.set_child(inner)
                b.connect('clicked', lambda _b, k=key: self.drop_chip(k))
                self.chips.append(b)
            self.chips.set_visible(bool(items))

        def drop_chip(self, key):
            if key.startswith('file:'):
                self.attach['files'].remove(key[5:])
            else:
                self.attach[key] = False
            self.draw_chips()

        # ---- sending ----------------------------------------------------------------------------------------------
        def on_input_key(self, _ctl, keyval, _code, state):
            if keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and not state & Gdk.ModifierType.SHIFT_MASK:
                self.on_send()
                return True
            return False

        def on_window_key(self, _ctl, keyval, _code, state):
            ctrl = state & Gdk.ModifierType.CONTROL_MASK
            if keyval == Gdk.KEY_Escape:
                self.close()
                return True
            if ctrl and keyval in (Gdk.KEY_w, Gdk.KEY_q):
                self.close()
                return True
            if ctrl and keyval == Gdk.KEY_n:
                self.new_chat()
                return True
            return False

        def on_send(self):
            if self.busy or self.chat is None:
                return
            buf = self.input.get_buffer()
            text = buf.get_text(buf.get_start_iter(), buf.get_end_iter(), False).strip()
            if not text:
                return
            p = self.prov()
            if not provider_ready(p):
                if p.get('unavailable'):
                    self.toast(p['unavailable'])
                else:
                    self.toast('Set the API key for %s first.' % tindai.provider_label(p))
                    self.key_dialog()
                return
            att = {'journal': self.attach['journal'], 'report': self.attach['report'],
                   'steam': self.attach['steam'], 'files': list(self.attach['files'])}
            checked = any([att['journal'], att['report'], att['steam'], att['files']])
            raw = self.rawbtn.get_active()
            names = ([n for k, n in (('journal', 'System log'), ('report', 'Tind report'), ('steam', 'Steam logs'))
                      if att[k]] + [os.path.basename(f) for f in att['files']])
            history = [{'role': m['role'], 'text': m.get('sent') or m['text'], 'raw': bool(m.get('raw'))}
                       for m in self.chat['messages'] if m.get('text') and not m.get('pending')]
            msg = {'role': 'user', 'text': text, 'raw': raw, 'items': names, 'pending': 'Preparing on this computer…',
                   'time': int(time.time())}
            if not self.chat['title']:
                self.chat['title'] = text.split('\n')[0][:60]
            self.chat['messages'].append(msg)
            buf.set_text('')
            self.rawbtn.set_active(False)
            self.attach = {'journal': False, 'report': False, 'steam': False, 'files': []}
            self.draw_chips()
            self.busy = True
            self.render()
            pid, model, conv = p['id'], self.model(), self.chat['id']

            def work():
                items = []
                if att['report']:
                    items.append({'name': 'Tind report', 'text': collect_report()})
                if att['steam']:
                    for name, body in collect_steam():
                        items.append({'name': 'Steam log ' + name, 'text': body})
                for f in att['files']:
                    items.append({'name': 'File ' + os.path.basename(f), 'text': tail_file(f)})
                return tindai.call(tindai.LOCAL_SOCKET, {
                    'op': 'brief', 'request': text, 'provider': pid, 'model': model, 'journal': att['journal'],
                    'raw': raw, 'items': items, 'history': history, 'conversation': conv}, timeout=180)

            def prepared(res, err):
                if err or not res.get('ok'):
                    self.fail(msg, 'Could not prepare: %s' % (err or res.get('error')))
                    return
                msg['sent'] = res['text']
                msg['redactions'] = res.get('redactions') or {}
                if checked:
                    msg['pending'] = 'Waiting for you to check the text…'
                    self.render()
                    self.preview(res, lambda: self.send_brief(msg, res['id'], pid, model),
                                 lambda: self.fail(msg, 'Not sent.'))
                else:
                    self.send_brief(msg, res['id'], pid, model)
            bg(work, prepared)

        def preview(self, res, on_send, on_cancel):
            p = self.prov()
            red = res.get('redactions') or {}
            what = ', '.join('%d %s' % (n, k) for k, n in sorted(red.items())) or 'nothing'
            body = 'This exact text goes to %s, and nothing else.\nHidden on this computer: %s.' % (
                tindai.provider_label(p), 'nothing (sent unredacted)' if res.get('raw') else what)
            if res.get('history'):
                body += '\nThe earlier messages of this chat are sent too.'
            dlg = Adw.AlertDialog(heading='Check before sending', body=body)
            if hasattr(dlg, 'set_prefer_wide_layout'):      # libadwaita 1.6+ (trixie has 1.7)
                dlg.set_prefer_wide_layout(True)
            tv = Gtk.TextView(editable=False, cursor_visible=False, wrap_mode=Gtk.WrapMode.WORD_CHAR, monospace=True,
                              top_margin=8, bottom_margin=8, left_margin=8, right_margin=8)
            tv.get_buffer().set_text(res['text'])
            sw = Gtk.ScrolledWindow(min_content_height=320, min_content_width=560, css_classes=['card'])
            sw.set_child(tv)
            dlg.set_extra_child(sw)
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('send', 'Send to %s' % p['name'])
            dlg.set_response_appearance('send', Adw.ResponseAppearance.SUGGESTED)
            dlg.set_default_response('send')
            dlg.set_close_response('cancel')
            dlg.connect('response', lambda _d, r: on_send() if r == 'send' else on_cancel())
            dlg.present(self)

        def send_brief(self, msg, bid, pid, model):
            p = next(x for x in self.providers if x['id'] == pid)
            msg['pending'] = None
            reply = {'role': 'assistant', 'text': '', 'pending': 'Waiting for %s…' % tindai.provider_label(p)}
            self.chat['messages'].append(reply)
            self.render()
            sock = tindai.LOCAL_SOCKET if p.get('service') == 'local' else tindai.remote_socket(pid)

            def work():
                return tindai.call(sock, {'op': 'send', 'id': bid, 'model': model}, timeout=300)

            def answered(res, err):
                if reply in self.chat['messages']:
                    self.chat['messages'].remove(reply)
                if err or not res.get('ok'):
                    self.fail(msg, 'No answer: %s' % (err or res.get('error')))
                    return
                m = next((x for x in p['models'] if x['id'] == res.get('model')), None)
                self.chat['messages'].append({
                    'role': 'assistant', 'text': res['answer'], 'provider_name': tindai.provider_label(p),
                    'model': res.get('model', ''), 'model_name': tindai.model_label(m) if m else res.get('model', ''),
                    'seconds': res.get('seconds'), 'time': int(time.time())})
                self.busy = False
                self.save_chat()
                self.render()
            bg(work, answered)

        def fail(self, msg, why):
            """The message did not go out: take it back off the chat and put its text back in the box."""
            self.busy = False
            if msg in self.chat['messages']:
                self.chat['messages'].remove(msg)
            if not self.chat['messages']:
                self.chat['title'] = ''
            self.render()
            self.input.get_buffer().set_text(msg['text'])
            self.toast(why)

        # ---- keys, guide, deleting --------------------------------------------------------------------------------
        def on_accept(self, *_):
            os.makedirs(CONFIG_DIR, exist_ok=True)
            open(ACCEPTED, 'w').close()
            self.new_chat()

        def key_dialog(self):
            p = self.prov()
            if p.get('service') == 'local':
                self.toast('This computer needs no key.')
                return
            custom = p['id'] == 'custom'
            dlg = Adw.AlertDialog(heading='API key for %s' % tindai.provider_label(p),
                                  body='%s\n\nThe key is stored for this computer, readable only by the service that '
                                  'talks to this provider. Saving asks for your password.' % p.get('key_help', ''))
            grp = Adw.PreferencesGroup()
            url = Adw.EntryRow(title='Server address (https://…/v1, or http://127.0.0.1:…/v1)')
            mod = Adw.EntryRow(title='Model name')
            key = Adw.PasswordEntryRow(title='API key (leave empty if the server needs none)' if custom else 'API key')
            if custom:
                url.set_text(p.get('base_url') or '')
                mod.set_text(p['models'][0]['id'] if p['models'] else '')
                grp.add(url)
                grp.add(mod)
            grp.add(key)
            dlg.set_extra_child(grp)
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('save', 'Save key')
            dlg.set_response_appearance('save', Adw.ResponseAppearance.SUGGESTED)
            dlg.set_close_response('cancel')

            def respond(_d, r):
                if r != 'save':
                    return
                secret = key.get_text().strip()
                args = ['pkexec', '/usr/lib/tind-ai/setkey', p['id']]
                if custom:
                    args += [url.get_text().strip(), mod.get_text().strip()]
                elif not secret:
                    self.toast('Paste the API key first.')
                    return

                def work():
                    r2 = subprocess.run(args, input=secret + '\n', capture_output=True, text=True, timeout=300)
                    if r2.returncode != 0:
                        raise RuntimeError((r2.stderr or r2.stdout).strip() or 'cancelled')

                def done(_res, err):
                    if err:
                        self.toast('Key not saved: %s' % err)
                        return
                    self.providers = tindai.providers()
                    self.pbtn.set_popover(self.build_provider_popover())
                    self.update_header()
                    self.toast('Key saved for %s.' % tindai.provider_label(p))
                bg(work, done)
            dlg.connect('response', respond)
            dlg.present(self)

        def confirm_delete(self, chat):
            dlg = Adw.AlertDialog(heading='Delete this chat?', body=chat.get('title') or 'New chat')
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('delete', 'Delete')
            dlg.set_response_appearance('delete', Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response('cancel')
            dlg.connect('response', lambda _d, r: r == 'delete' and self.delete_chats([chat]))
            dlg.present(self)

        def confirm_delete_all(self):
            chats = [c for _p, c in all_chats()]
            if not chats:
                return
            dlg = Adw.AlertDialog(heading='Delete all %d chats?' % len(chats), body='This cannot be undone.')
            dlg.add_response('cancel', 'Cancel')
            dlg.add_response('delete', 'Delete all')
            dlg.set_response_appearance('delete', Adw.ResponseAppearance.DESTRUCTIVE)
            dlg.set_close_response('cancel')
            dlg.connect('response', lambda _d, r: r == 'delete' and self.delete_chats(chats))
            dlg.present(self)

        def delete_chats(self, chats):
            ids = [c['id'] for c in chats]
            for c in chats:
                try:
                    os.unlink(chat_path(c))
                except OSError:
                    pass

            def work():
                for cid in ids:     # the local service forgets the placeholder maps (they hold the real values)
                    tindai.call(tindai.LOCAL_SOCKET, {'op': 'forget', 'conversation': cid}, timeout=30)
            bg(work, lambda _r, _e: None)
            if self.chat and self.chat['id'] in ids:
                self.new_chat()
            self.refresh_sidebar()

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id='no.servr.TindAI', flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
            self.win = None

        def do_startup(self):
            Adw.Application.do_startup(self)
            css = Gtk.CssProvider()
            css.load_from_string(CSS)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        def do_activate(self):
            if not self.win:
                self.win = Win(self, open_target)
            self.win.present()

    return App().run([sys.argv[0]])


if __name__ == '__main__':
    if '--check' in sys.argv:
        sys.exit(check())
    target = sys.argv[sys.argv.index('--open') + 1] if '--open' in sys.argv[:-1] else None
    sys.exit(main(target))
