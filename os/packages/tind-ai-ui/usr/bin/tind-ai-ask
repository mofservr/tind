DATA_DIR = os.path.join(os.environ.get('XDG_DATA_HOME') or os.path.expanduser('~/.local/share'), 'tind-ai')
LEGACY_CHATS_DIR = os.path.join(DATA_DIR, 'chats')     # before 0.1.0~test7: one JSON file per chat
ACCEPTED = os.path.join(CONFIG_DIR, 'accepted')
SETTINGS = os.path.join(CONFIG_DIR, 'settings.json')
MAX_FILE = 200_000
SHELLS = ('bash', 'sh', 'shell', 'console', 'zsh')
TEMPLATES_FILE = '/usr/share/tind-ai/templates.json'
ATTACH_KEYS = ('journal', 'report', 'steam')
PRICES_FILE = '/usr/share/tind-ai/prices.json'
BANDS = ('free', 'cheap', 'mid', 'expensive', 'unknown')
BAND_NAMES = {'free': 'Free', 'cheap': 'Cheap', 'mid': 'Mid', 'expensive': 'Expensive', 'unknown': 'Price unknown'}
CURRENCY = {'EUR': '€', 'USD': '$', 'GBP': '£', 'NOK': 'kr '}
FOLDER_DEFAULT = os.path.expanduser('~/TindAI')
SUBDIRS = ('Documents', 'ChatArchive', 'Export')
OLD_EXPORT = os.path.expanduser('~/AI-export')          # the export folder before 0.1.0~test7
# key in the window -> file in the export folder, and how it is described in about.txt
EXPORT_FILES = {'report': ('tind-report.txt', 'Tind report'), 'journal': ('system-log.txt', 'system log'),
                'steam': ('steam-proton.txt', 'Steam and Proton logs')}
EXPORT_ABOUT = 'about.txt'

GUIDE = (
    "This window lets an AI service help you with your computer: a setting, an error message, a program that will "
    "not start, a script.\n\n"
    "How it keeps you in control:\n"
    "• What you type is sent with names, addresses, keys and passwords replaced by placeholders such as [user-1] or "
    "[ip-1]. Each message shows what was hidden.\n"
    "• When you attach system data (logs, the Tind report, files) you see the exact text before it is sent.\n"
    "• Only that text goes to the provider named at the top. European providers are the default.\n"
    "• The AI cannot run anything on this computer. Its suggestions are shown to you; you decide what to copy and run.\n"
    "• Chats and saved documents are kept in ~/TindAI, readable by you only. The chat archive shows your real names "
    "and addresses again. If you sync that folder (Nextcloud and the like), it leaves this computer.\n\n"
    "AI answers can be wrong. Read a command before you run it, and keep backups of what matters.")


# ---- small helpers (no GTK) -----------------------------------------------------------------------------------------
def load_json(path, default):
    try:
        with open(path, encoding='utf-8') as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def save_json(path, obj, mode=0o600):
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + '.tmp'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        json.dump(obj, f, ensure_ascii=False, indent=1)
    os.rename(tmp, path)


def provider_ready(p):
    if p.get('unavailable'):
        return False
    if p.get('service') == 'local':
        return True
    return os.path.exists(os.path.join(tindai.READY_DIR, p['id']))


def tail_file(path, limit=MAX_FILE):
    with open(path, 'rb') as f:
        f.seek(0, os.SEEK_END)
        size = f.tell()
        f.seek(max(0, size - limit))
        data = f.read()
    if b'\0' in data[:4096]:
        raise ValueError('%s is not a text file' % os.path.basename(path))
    return data.decode('utf-8', 'replace')


def collect_report():
    fd, path = tempfile.mkstemp(prefix='tind-report-', suffix='.txt')
    os.close(fd)
    try:
        subprocess.run(['tind-report', path], capture_output=True, timeout=120, check=False)
        return tail_file(path)
    finally:
        os.unlink(path)


def collect_steam():
    home = os.path.expanduser('~')
    found = []
    for pattern in ('.steam/steam/logs/console_log.txt', '.local/share/Steam/logs/console_log.txt',
                    '.steam/steam/logs/stderr.txt', 'steam-*.log'):
        found += glob.glob(os.path.join(home, pattern))
    found = sorted(set(os.path.realpath(f) for f in found), key=os.path.getmtime, reverse=True)[:3]
    return [(os.path.basename(f), tail_file(f, 80_000)) for f in found]


# ---- the TindAI folder ----------------------------------------------------------------------------------------------
def ai_root(settings):
    d = settings.get('folder')
    return d if isinstance(d, str) and os.path.isabs(d) else FOLDER_DEFAULT


def sub_dir(settings, name):
    return os.path.join(ai_root(settings), name)


def make_dir(path):
    """Create path and every missing parent readable by you only (os.makedirs gives its mode to the last folder
    only; the parents would get the umask's 755). Folders that already exist are left as they are."""
    missing = []
    p = os.path.abspath(path)
    while not os.path.isdir(p):
        missing.append(p)
        parent = os.path.dirname(p)
        if parent == p:
            break
        p = parent
    for d in reversed(missing):
        try:
            os.mkdir(d, 0o700)
        except FileExistsError:
            continue
        os.chmod(d, 0o700)
    return path


def migrate_old_export(settings):
    """~/AI-export (before ~test7) moves to <TindAI>/Export once, when nobody picked another export folder. Returns
    the new path, or None when there was nothing to move."""
    if settings.get('export_dir') or not os.path.isdir(OLD_EXPORT) or os.path.islink(OLD_EXPORT):
        return None
    new = sub_dir(settings, 'Export')
    if os.path.lexists(new):
        return None
    make_dir(os.path.dirname(new))
    os.rename(OLD_EXPORT, new)
    return new


def move_folder(old_root, new_root):
    """Move Documents, ChatArchive and Export from old_root to new_root. A sub-folder that does not exist at the new
    place moves whole; otherwise its entries move one by one and an entry whose name is taken there stays where it
    is. Returns (moved, kept): lists of paths relative to the TindAI folder. Nothing is ever overwritten or deleted
    (an emptied old folder is removed)."""
    old_root, new_root = os.path.realpath(old_root), os.path.realpath(new_root)
    if old_root == new_root:
        return [], []
    for name in SUBDIRS:
        src = os.path.join(old_root, name)
        if new_root == src or new_root.startswith(src + os.sep):
            raise ValueError('the new folder is inside %s' % src)
    make_dir(new_root)
    moved, kept = [], []
    for name in SUBDIRS:
        src, dst = os.path.join(old_root, name), os.path.join(new_root, name)
        if not os.path.isdir(src):
            continue
        if not os.path.lexists(dst):
            shutil.move(src, dst)
            moved.append(name)
            continue
        for entry in sorted(os.listdir(src)):
            if os.path.lexists(os.path.join(dst, entry)):
                kept.append(os.path.join(name, entry))
            else:
                shutil.move(os.path.join(src, entry), os.path.join(dst, entry))
                moved.append(os.path.join(name, entry))
        try:
            os.rmdir(src)
        except OSError:
            pass
    try:
        os.rmdir(old_root)
    except OSError:
        pass
    return moved, kept


def folder_has_files(root):
    return any(os.path.isdir(os.path.join(root, n)) and os.listdir(os.path.join(root, n)) for n in SUBDIRS)


# ---- the chat archive: one Markdown file per chat --------------------------------------------------------------------
# The file is the chat: readable in any editor, and still everything the window needs. Front matter between --- lines
# (one "key: JSON value" per line), then per message a marker line <!-- tind:message {meta as JSON} -->, a heading, the
# text, and for a user message what was sent (placeholders) after <!-- tind:sent -->. A line in a text that starts with
# "<!-- tind:" gets one more backslash in front when written and loses one when read, so no text can fake a marker.
ARCHIVE_VERSION = 1
MARK = '<!-- tind:'
MSG_RE = re.compile(r'^<!-- tind:message (\{.*\}) -->$')
ESC_RE = re.compile(r'^(\\*)<!-- tind:', re.M)
FRONT_KEYS = ('id', 'provider', 'model', 'title', 'created', 'updated')
MSG_META = ('role', 'time', 'raw', 'items', 'redactions', 'provider_name', 'model', 'model_name', 'seconds')


def _escape(text):
    return ESC_RE.sub(lambda m: '\\' + m.group(1) + MARK, text)


def _unescape(text):
    return re.sub(r'^\\(\\*)<!-- tind:', lambda m: m.group(1) + MARK, text, flags=re.M)


def _fence(text, char='~'):
    runs = [len(m.group(0)) for m in re.finditer(r'^%s+' % re.escape(char), text, re.M)]
    return char * max([3] + [n + 1 for n in runs])


def _when(t, fmt='%d %b %Y %H:%M'):
    return time.strftime(fmt, time.localtime(t or 0))


def chat_to_md(chat):
    lines = ['---', 'tind-chat: %d' % ARCHIVE_VERSION]
    for k in FRONT_KEYS:
        lines.append('%s: %s' % (k, json.dumps(chat.get(k, ''), ensure_ascii=False)))
    lines += ['---', '', '# ' + (chat.get('title') or 'New chat').replace('\n', ' '), '']
    for m in chat.get('messages', []):
        if m.get('pending') or not m.get('text'):
            continue
        meta = {k: m[k] for k in MSG_META if k in m and m[k] not in (None, '', [], {})}
        meta['role'] = m['role']
        lines.append(MARK + 'message ' + json.dumps(meta, ensure_ascii=False) + ' -->')
        if m['role'] == 'user':
            head = 'You'
        else:
            head = ' · '.join(b for b in (m.get('provider_name'), m.get('model_name') or m.get('model')) if b) or 'AI'
        stamp = ' · ' + _when(m['time']) if m.get('time') else ''
        lines += ['### %s%s' % (head, stamp), '', _escape(m['text'].strip('\n')), '']
        sent = m.get('sent')
        if sent and sent != m['text']:
            if m['role'] == 'user':
                red = m.get('redactions') or {}
                what = ', '.join('%d %s' % (n, k) for k, n in sorted(red.items())) or 'nothing'
                summary = 'Sent with placeholders (hidden: %s)' % what
            else:
                summary = 'As received, with placeholders'
            fence = _fence(sent)
            lines += [MARK + 'sent -->', '<details><summary>%s</summary>' % html.escape(summary), '',
                      fence + 'text', _escape(sent.strip('\n')), fence, '', '</details>', '']
    return '\n'.join(lines) + '\n'


def md_to_chat(text):
    """The chat in an archive file, or None when the file is not one (it is then left alone, never deleted)."""
    if not text.startswith('---\n'):
        return None
    try:
        head, body = text[4:].split('\n---\n', 1)
        front = {}
        for line in head.split('\n'):
            k, _, v = line.partition(': ')
            front[k.strip()] = json.loads(v)
    except ValueError:
        return None
    if front.get('tind-chat') != ARCHIVE_VERSION or not re.fullmatch(r'[0-9a-zA-Z]{1,64}', str(front.get('id', ''))):
        return None
    chat = {k: front.get(k, '') for k in FRONT_KEYS}
    chat['created'] = int(chat['created'] or 0)
    chat['updated'] = int(chat['updated'] or 0)
    chat['messages'] = []
    lines = body.split('\n')
    i = 0
    while i < len(lines):
        mt = MSG_RE.match(lines[i])
        if not mt:
            i += 1
            continue
        try:
            meta = json.loads(mt.group(1))
        except ValueError:
            meta = None
        j = i + 1
        while j < len(lines) and not MSG_RE.match(lines[j]):
            j += 1
        if isinstance(meta, dict) and meta.get('role') in ('user', 'assistant'):
            chunk = lines[i + 1:j]
            if chunk and chunk[0].startswith('### '):
                chunk = chunk[1:]
            sent = None
            if MARK + 'sent -->' in chunk:
                k = chunk.index(MARK + 'sent -->')
                tail, chunk = chunk[k + 1:], chunk[:k]
                for a, line in enumerate(tail):
                    if re.fullmatch(r'~{3,}text', line):
                        fence = line[:-4]
                        b = tail.index(fence, a + 1) if fence in tail[a + 1:] else len(tail)
                        sent = _unescape('\n'.join(tail[a + 1:b]))
                        break
            m = {k: meta[k] for k in MSG_META if k in meta}
            m['text'] = _unescape('\n'.join(chunk).strip('\n'))
            if sent is not None:
                m['sent'] = sent
            chat['messages'].append(m)
        i = j
    return chat


def load_chat(path):
    try:
        with open(path, encoding='utf-8') as f:
            chat = md_to_chat(f.read())
    except (OSError, UnicodeDecodeError):
        return None
    if chat:
        chat['_path'] = path
    return chat


def all_chats(folder):
    """Every chat in the archive folder, newest first: list of (path, chat dict). A file that is not a chat is
    skipped; two files with the same chat id (a copy made by hand) show once, the newer one."""
    out, seen = [], set()
    paths = glob.glob(os.path.join(folder, '*.md')) + glob.glob(os.path.join(folder, '*', '*.md'))
    for path in paths:
        chat = load_chat(path)
        if chat:
            out.append((path, chat))
    out.sort(key=lambda pc: (pc[1].get('updated', 0), os.path.getmtime(pc[0])), reverse=True)
    unique = []
    for path, chat in out:
        if chat['id'] not in seen:
            seen.add(chat['id'])
            unique.append((path, chat))
    return unique


def slug(text, limit=40):
    s = re.sub(r'[^\w]+', '-', text.lower(), flags=re.U).strip('-_')[:limit].strip('-_')
    return s or 'chat'


def chat_path(folder, chat):
    """Where the chat is saved: the file it came from (even if renamed or moved by hand), or a new name."""
    if chat.get('_path') and os.path.isdir(os.path.dirname(chat['_path'])):
        return chat['_path']
    name = '%s-%s-%s.md' % (_when(chat.get('created'), '%Y-%m-%d'), slug(chat.get('title') or ''), chat['id'])
    return os.path.join(folder, re.sub(r'[^\w.-]', '_', chat.get('provider') or 'other'), name)


def save_chat_file(folder, chat):
    path = chat_path(folder, chat)
    make_dir(os.path.dirname(path))
    _write_text(path, chat_to_md(chat))
    chat['_path'] = path
    return path


def migrate_old_chats(folder, restore=None):
    """The JSON chats of before ~test7 become archive files, with the answers' placeholders put back by restore(chat
    id, [texts]) (the local service; the answer as received is kept with the message). The old folder is renamed to
    chats.migrated, never deleted. Returns how many chats moved."""
    if not os.path.isdir(LEGACY_CHATS_DIR):
        return 0
    done = 0
    for path in sorted(glob.glob(os.path.join(LEGACY_CHATS_DIR, '*', '*.json'))):
        chat = load_json(path, None)
        if not (isinstance(chat, dict) and re.fullmatch(r'[0-9a-zA-Z]{1,64}', str(chat.get('id', '')))
                and isinstance(chat.get('messages'), list)):
            continue
        answers = [m for m in chat['messages'] if isinstance(m, dict) and m.get('role') == 'assistant'
                   and m.get('text') and not m.get('sent')]
        if answers and restore:
            try:
                texts = restore(chat['id'], [m['text'] for m in answers])
            except Exception:  # noqa: BLE001 - keep the text as received
                texts = None
            if texts and len(texts) == len(answers):
                for m, t in zip(answers, texts):
                    if t != m['text']:
                        m['sent'], m['text'] = m['text'], t
        chat.setdefault('provider', os.path.basename(os.path.dirname(path)))
        if not any(os.path.exists(p) for p in glob.glob(os.path.join(folder, '*', '*-%s.md' % chat['id']))):
            save_chat_file(folder, chat)
        done += 1
    target = LEGACY_CHATS_DIR + '.migrated'
    n = 1
    while os.path.lexists(target):
        n += 1
        target = '%s.migrated-%d' % (LEGACY_CHATS_DIR, n)
    os.rename(LEGACY_CHATS_DIR, target)
    return done


def restore_texts(conversation, texts):
    """Placeholders back to real values, by the local service (which holds the map). Unchanged if it cannot."""
    res = tindai.call(tindai.LOCAL_SOCKET, {'op': 'restore', 'conversation': conversation, 'texts': texts}, timeout=60)
    if not res.get('ok'):
        raise RuntimeError(res.get('error') or 'the local service did not answer')
    return res['texts']


FENCE_RE = re.compile(r'^ {0,3}(`{3,}|~{3,})\s*([A-Za-z0-9_+.-]*)[^`]*$')


def split_blocks(text):
    """[('text', str) | ('code', lang, str) | ('doc', title, markdown)] from an answer with fenced blocks. A fence
    opens at the start of a line and closes with the same character, at least as long; an unclosed one runs to the
    end. A block tagged "document" is a finished document (Markdown) the human can save."""
    out, para = [], []
    lines = text.split('\n')
    i = 0
    while i < len(lines):
        m = FENCE_RE.match(lines[i])
        if not m:
            para.append(lines[i])
            i += 1
            continue
        fence, lang = m.group(1), (m.group(2) or 'text').lower()
        j = i + 1
        while j < len(lines) and not re.fullmatch(r' {0,3}%s%s*\s*' % (re.escape(fence), re.escape(fence[0])),
                                                  lines[j]):
            j += 1
        body = '\n'.join(lines[i + 1:j]).rstrip('\n')
        if '\n'.join(para).strip():
            out.append(('text', '\n'.join(para)))
        para = []
        if lang == 'document':
            out.append(('doc', doc_title(body, 'Document'), body))
        else:
            out.append(('code', lang, body))
        i = j + 1
    if '\n'.join(para).strip():
        out.append(('text', '\n'.join(para)))
    return out


def to_markup(text, escape):
    """A little Markdown to Pango markup: headings, bold, inline code, bullets."""
    lines = []
    for line in text.strip('\n').split('\n'):
        head = re.match(r'^(#{1,4})\s+(.*)$', line)
        body = escape(head.group(2) if head else line)
        body = re.sub(r'\*\*(.+?)\*\*', r'<b>\1</b>', body)
        body = re.sub(r'`([^`]+)`', r'<tt>\1</tt>', body)
        body = re.sub(r'^(\s*)[-*] ', r'\1• ', body)
        lines.append('<b>%s</b>' % body if head else body)
    return '\n'.join(lines)


def load_templates(path=TEMPLATES_FILE):
    """The task templates (static data, no model call). A broken or missing file gives an empty list: the window then
    simply has no template chips. An entry that is not well formed is skipped, never fatal."""
    data = load_json(path, {})
    out, seen = [], set()
    for t in data.get('templates', []) if isinstance(data, dict) else []:
        try:
            fields = [f for f in t['fields'] if isinstance(f, dict) and re.fullmatch(r'\w+', str(f.get('id', '')))]
            lines = [ln for ln in t['lines'] if isinstance(ln, (str, dict))]
            if not (t['id'] and t['title'] and fields and lines) or t['id'] in seen:
                continue
        except (KeyError, TypeError):
            continue
        seen.add(t['id'])
        out.append({'id': str(t['id']), 'title': str(t['title']), 'hint': str(t.get('hint', '')), 'fields': fields,
                    'attach': [k for k in t.get('attach', []) if k in ATTACH_KEYS], 'lines': lines})
    return out


def missing_required(tpl, values):
    """Labels of the required fields that are still empty."""
    return [f.get('label', f['id']) for f in tpl['fields']
            if f.get('required') and not (values.get(f['id']) or '').strip()]


def compose_prompt(tpl, values, attached):
    """One English prompt from a template, the answers {field: text} and the attached data keys. A line with a field
    that was left empty is dropped; a line with "if_attached" stays only when one of those is attached. Answers are
    inserted as they are (they are never read as placeholders) and go through the fixed redaction rules like any
    typed text."""
    entries = []
    for ln in tpl['lines']:
        text, cond = (ln, None) if isinstance(ln, str) else (str(ln.get('text', '')), ln.get('if_attached'))
        if cond and not any(k in attached for k in cond):
            continue
        names = re.findall(r'\{(\w+)\}', text)
        vals = {n: (values.get(n) or '').strip() for n in names}
        if any(not v for v in vals.values()):
            continue
        entries.append(re.sub(r'\{(\w+)\}', lambda m: vals[m.group(1)], text))
    while entries and not entries[0].strip():
        entries.pop(0)
    while entries and not entries[-1].strip():
        entries.pop()
    tidy = [e for i, e in enumerate(entries) if e.strip() or (i and entries[i - 1].strip())]
    return '\n'.join(tidy)


# ---- prices (static data, no network) -------------------------------------------------------------------------------
def load_prices(path=None):
    """The shipped price list. A missing or broken file, or a broken entry, gives "price unknown", never an error."""
    data = load_json(path or PRICES_FILE, {})
    data = data if isinstance(data, dict) else {}
    out = {'as_of': str(data.get('as_of', '')), 'free': set(), 'models': {}, 'blend': (3.0, 1.0),
           'limits': (1.0, 10.0)}
    try:
        b, lim = data.get('blend', {}), data.get('limits', {})
        out['blend'] = (float(b.get('input', 3)), float(b.get('output', 1)))
        out['limits'] = (float(lim.get('cheap', 1)), float(lim.get('mid', 10)))
    except (AttributeError, TypeError, ValueError):
        pass
    if sum(out['blend']) <= 0:
        out['blend'] = (3.0, 1.0)
    free = data.get('free')
    out['free'] = {p for p in free if isinstance(p, str)} if isinstance(free, list) else set()
    provs = data.get('providers', {})
    for pid, models in (provs.items() if isinstance(provs, dict) else []):
        for mid, e in (models.items() if isinstance(models, dict) else []):
            try:
                entry = {'input': float(e['input']), 'output': float(e['output']), 'currency': str(e['currency']),
                         'note': str(e.get('note', '')), 'checked': e.get('checked', True) is not False}
            except (KeyError, TypeError, ValueError):
                continue
            if entry['input'] >= 0 and entry['output'] >= 0:
                out['models'][(str(pid), str(mid))] = entry
    return out


def price_of(prices, p, model_id):
    """The price entry for this provider's model, {'free': True} for a free provider, or None (unknown)."""
    if p.get('service') == 'local' or p.get('id') in prices['free']:
        return {'free': True}
    return prices['models'].get((p.get('id'), model_id))


def blended(prices, entry):
    wi, wo = prices['blend']
    return (wi * entry['input'] + wo * entry['output']) / (wi + wo)


def band(prices, entry):
    """free, cheap, mid, expensive or unknown. Limits are applied to the 3:1 blend, whatever the currency."""
    if entry is None:
        return 'unknown'
    if entry.get('free'):
        return 'free'
    x = blended(prices, entry)
    if x == 0:
        return 'free'
    cheap, mid = prices['limits']
    return 'cheap' if x < cheap else 'mid' if x < mid else 'expensive'


def money(value, currency):
    sym = CURRENCY.get(currency)
    num = ('%.2f' % value) if value < 100 else ('%.0f' % value)
    return sym + num if sym else '%s %s' % (num, currency)


def price_text(entry):
    """'€0.15 in · €0.60 out per million tokens', or the reason there is no price."""
    if entry is None:
        return 'Not on Tind\'s price list; check with the provider'
    if entry.get('free'):
        return 'Free: runs on this computer'
    return '%s in · %s out per million tokens' % (money(entry['input'], entry['currency']),
                                                   money(entry['output'], entry['currency']))


def as_of_text(prices):
    try:
        return time.strftime('%-d %b %Y', time.strptime(prices['as_of'], '%Y-%m-%d'))
    except ValueError:
        return 'an unknown date'


def check_prices():
    prices = load_prices()
    n = 0
    for p in tindai.providers():
        models = p['models'] or [{'id': '', 'name': '(no model yet)'}]
        for m in models:
            e = price_of(prices, p, m['id'])
            n += e is not None and not e.get('free')
            print('%-28s %-34s %-13s %s' % (tindai.provider_label(p)[:28], tindai.model_label(m)[:34],
                                            BAND_NAMES[band(prices, e)], price_text(e)))
    print('prices: %d models priced, list as of %s' % (n, prices['as_of'] or 'unknown'))
    return 0 if n else 1


# ---- export (for AI apps outside this window) -----------------------------------------------------------------------
def home_short(path):
    home = os.path.expanduser('~')
    return '~' + path[len(home):] if path == home or path.startswith(home + os.sep) else path


def export_dir(settings):
    """<TindAI>/Export, or the folder picked for exports before ~test7 (kept until the TindAI folder is changed)."""
    d = settings.get('export_dir')
    return d if isinstance(d, str) and os.path.isabs(d) else sub_dir(settings, 'Export')


def export_items(keys):
    """What this window reads as you, for the export: [{'file', 'text'}]. The system log is added by the local
    service (journal=True), which then applies the fixed rules to all of it."""
    items = []
    if 'report' in keys:
        items.append({'file': EXPORT_FILES['report'][0], 'text': collect_report()})
    if 'steam' in keys:
        logs = collect_steam()
        text = '\n\n'.join('## %s\n%s' % (n, b) for n, b in logs) if logs else '(no Steam or Proton logs found)'
        items.append({'file': EXPORT_FILES['steam'][0], 'text': text})
    return items


def write_export(folder, files, raw, redactions=None, when=None):
    """Write one export set into folder, replacing the previous one: files of the set that are not in this export
    are removed (other files in the folder are left alone), so the folder never mixes two exports. The folder is
    made 0700 and the files 0600. Returns the names written, about.txt last."""
    make_dir(folder)
    names = {f['file'] for f in files}
    known = {v[0] for v in EXPORT_FILES.values()}
    if not names or not names <= known:
        raise ValueError('nothing to export')
    for name in known - names:
        try:
            os.unlink(os.path.join(folder, name))
        except FileNotFoundError:
            pass
    order = [v[0] for v in EXPORT_FILES.values()]
    written = []
    for f in sorted(files, key=lambda f: order.index(f['file'])):
        _write_text(os.path.join(folder, f['file']), f['text'])
        written.append(f['file'])
    stamp = time.strftime('%Y-%m-%d %H:%M', time.localtime(when or time.time()))
    if raw:
        how = 'unredacted (exactly as on the system)'
    else:
        how = 'redacted (names, addresses and keys are placeholders such as [ip-1])'
    _write_text(os.path.join(folder, EXPORT_ABOUT), 'Tind export, %s: %s; %s.' % (stamp, how, ', '.join(written)))
    return written + [EXPORT_ABOUT]


def _write_text(path, text):
    tmp = path + '.tmp'
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        f.write(text if text.endswith('\n') else text + '\n')
    os.rename(tmp, path)


def run_export(keys, raw, folder):
    """Collect, redact (unless raw) in the local service, write. Returns (folder, names written, redactions)."""
    res = tindai.call(tindai.LOCAL_SOCKET, {'op': 'export', 'journal': 'journal' in keys, 'raw': bool(raw),
                                            'items': export_items(keys)}, timeout=180)
    if not res.get('ok'):
        raise RuntimeError(res.get('error') or 'the local service did not answer')
    return folder, write_export(folder, res['files'], raw), res.get('redactions') or {}


def cli_export(raw):
    settings = load_json(SETTINGS, {})
    migrate_old_export(settings)
    folder = export_dir(settings)
    try:
        folder, names, red = run_export(['report', 'journal'], raw, folder)
    except (OSError, RuntimeError, ValueError) as e:
        print('export failed: %s' % e)
        return 1
    print('exported to %s: %s' % (folder, ', '.join(names)))
    print('hidden: %s' % (', '.join('%d %s' % (n, k) for k, n in sorted(red.items())) or
                          ('nothing (unredacted)' if raw else 'nothing')))
    return 0


def check_templates():
