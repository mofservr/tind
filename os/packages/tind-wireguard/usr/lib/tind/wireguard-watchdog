#!/bin/bash
# Reconnect the servr.no tunnel when it has gone silent.
# WireGuard resolves the endpoint hostname only when the tunnel comes up. If the home WAN IP changes,
# the tunnel stops working without any error. A healthy tunnel with keepalive renews its handshake
# about every two minutes, so a handshake older than MAX_AGE seconds means the tunnel is dead.
# Taking the connection down and up resolves the endpoint name again.
# Runs from tind-wireguard-watchdog.timer (every minute). Does nothing when no tunnel is installed.
set -u
CONF=/etc/tind/servr-tunnel.conf
MAX_AGE="${TIND_WG_MAX_AGE:-150}"
STATE="${TIND_WG_STATE:-/run/tind-wireguard-watchdog}"

CONNECTION_NAME="tind-servr"
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

nmcli -t -f NAME connection show 2>/dev/null | grep -qx "$CONNECTION_NAME" || exit 0
# no network at all: nothing to fix, and bouncing the tunnel would not help
ip route show default 2>/dev/null | grep -q . || exit 0

now="$(date +%s)"
mkdir -p "$STATE"
active="$(nmcli -t -g GENERAL.STATE connection show "$CONNECTION_NAME" 2>/dev/null || true)"

bounce() {
    logger -t tind-wireguard-watchdog "$1; reconnecting $CONNECTION_NAME"
    nmcli connection down "$CONNECTION_NAME" >/dev/null 2>&1 || true
    nmcli connection up "$CONNECTION_NAME" >/dev/null 2>&1 \
        || logger -t tind-wireguard-watchdog "could not bring $CONNECTION_NAME up"
    echo "$now" > "$STATE/ref"
}

if [ "$active" != "activated" ]; then
    # autoconnect normally does this; retry at most once per MAX_AGE
    last="$(cat "$STATE/ref" 2>/dev/null || echo 0)"
    [ $((now - last)) -ge "$MAX_AGE" ] && bounce "tunnel not active"
    exit 0
fi

# the newest of: last handshake, our last reconnect, first time we saw it active
hs="$(wg show "$CONNECTION_NAME" latest-handshakes 2>/dev/null | awk 'NR==1{print $2}')"
hs="${hs:-0}"
ref="$(cat "$STATE/ref" 2>/dev/null || true)"
if [ -z "$ref" ]; then echo "$now" > "$STATE/ref"; ref="$now"; fi
[ "$hs" -gt "$ref" ] && ref="$hs"

age=$((now - ref))
[ "$age" -gt "$MAX_AGE" ] && bounce "no handshake for ${age}s"
exit 0
