#!/usr/bin/python3
"""setkey PROVIDER [BASE_URL MODEL]: run as root through pkexec by the Ask window. Reads the API key from stdin and
stores it as /etc/tind-ai/keys/PROVIDER (root only; systemd hands it to that provider's service alone). An empty key
removes it. For the custom endpoint, BASE_URL and MODEL are stored in /etc/tind-ai/custom.json too."""
import json
import os
import re
import subprocess
import sys

sys.path.insert(0, '/usr/lib/tind-ai')
import tindai  # noqa: E402
from tindai import endpoint  # noqa: E402

if os.geteuid() != 0:
    sys.exit('setkey: run as root')
pid = sys.argv[1] if len(sys.argv) > 1 else ''
if not re.match(r'^[a-z0-9-]+$', pid):
    sys.exit('setkey: bad provider')
tindai.provider(pid)  # unknown provider: error
if pid == 'custom':
    if len(sys.argv) != 4:
        sys.exit('setkey custom BASE_URL MODEL')
    base_url, model = sys.argv[2], sys.argv[3]
    endpoint.parse(base_url)
    if not re.match(r'^[A-Za-z0-9._:/@+-]{1,120}$', model):
        sys.exit('setkey: bad model name')
    with open(tindai.CUSTOM_FILE + '.tmp', 'w', encoding='utf-8') as f:
        json.dump({'base_url': base_url.rstrip('/'), 'model': model}, f)
    os.chmod(tindai.CUSTOM_FILE + '.tmp', 0o644)
    os.rename(tindai.CUSTOM_FILE + '.tmp', tindai.CUSTOM_FILE)
key = sys.stdin.readline().strip()
if len(key) > 4096 or any(c.isspace() for c in key):
    sys.exit('setkey: that does not look like an API key')
os.makedirs(tindai.KEYS_DIR, mode=0o700, exist_ok=True)
os.makedirs(tindai.READY_DIR, mode=0o755, exist_ok=True)
path = os.path.join(tindai.KEYS_DIR, pid)
ready = os.path.join(tindai.READY_DIR, pid)
if key or pid == 'custom':
    fd = os.open(path + '.tmp', os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, 'w', encoding='utf-8') as f:
        f.write(key + '\n')
    os.rename(path + '.tmp', path)
    open(ready, 'w').close()
    os.chmod(ready, 0o644)
    print('setkey: key stored for %s' % pid)
else:
    for f in (path, ready):
        try:
            os.unlink(f)
        except FileNotFoundError:
            pass
    print('setkey: key removed for %s' % pid)
# the running service (if any) picks up the new key on its next start
subprocess.run(['systemctl', 'stop', 'tind-ai-remote@%s.service' % pid], check=False)
