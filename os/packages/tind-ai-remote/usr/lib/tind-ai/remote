#!/usr/bin/python3
"""tind-ai-remote PROVIDER: sends one approved briefing to one provider's API. Runs as the system user tind-ai-remote.

One instance per provider (tind-ai-remote@PROVIDER.service, started by its socket /run/tind-ai/remote-PROVIDER.sock).
Each instance gets only its own API key (systemd credential "key"), can read only /var/lib/tind-ai/briefing and write
only /var/lib/tind-ai/outbox, and the firewall lets it reach only the addresses netallow resolved for its provider.

Only the human who owns a briefing can ask for it to be sent (the user id comes from the kernel), and the briefing is
read from disk, exactly as the local service wrote it and the human saw it in the preview.

Request:  {"op": "send", "id": "<briefing id>", "model": "<model id>"}
Answer:   {"ok": true, "answer": "...", "provider": "...", "model": "...", "usage": {...}}
The answer is also saved as /var/lib/tind-ai/outbox/<uid>/<id>.json (readable by that human only).
"""
import http.client
import json
import os
import re
import socket
import ssl
import sys
import time

sys.path.insert(0, '/usr/lib/tind-ai')
import tindai  # noqa: E402
from tindai import endpoint  # noqa: E402

PROVIDER = sys.argv[1] if len(sys.argv) > 1 else ''
MODEL_RE = re.compile(r'^[A-Za-z0-9._:/@+-]{1,120}$')
ID_RE = re.compile(r'^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$')
TIMEOUT = 240
MAX_TOKENS = 4096


def api_key():
    d = os.environ.get('CREDENTIALS_DIRECTORY', '')
    try:
        with open(os.path.join(d, 'key'), encoding='utf-8') as f:
            return f.read().strip()
    except OSError:
        return ''


class PinnedHTTPSConnection(http.client.HTTPSConnection):
    """HTTPS to one of the addresses netallow resolved, with the certificate checked against the host name."""

    def __init__(self, host, port, addresses, **kw):
        super().__init__(host, port, context=ssl.create_default_context(), timeout=TIMEOUT, **kw)
        self._addresses = addresses

    def connect(self):
        last = None
        for addr in self._addresses:
            try:
                sock = socket.create_connection((addr, self.port), timeout=self.timeout)
                self.sock = self._context.wrap_socket(sock, server_hostname=self.host)
                return
            except OSError as e:
                last = e
        raise last or OSError('no address to connect to')


class PinnedHTTPConnection(http.client.HTTPConnection):
    """Plain http to this computer only (endpoint.parse refuses anything else)."""

    def __init__(self, host, port, addresses, **kw):
        super().__init__(host, port, timeout=TIMEOUT, **kw)
        self._addresses = addresses

    def connect(self):
        self.sock = socket.create_connection((self._addresses[0], self.port), timeout=self.timeout)


def post(path, headers, body):
    h = endpoint.load(PROVIDER)
    cls = PinnedHTTPSConnection if h['scheme'] == 'https' else PinnedHTTPConnection
    conn = cls(h['host'], h['port'], h['addresses'])
    try:
        conn.request('POST', h['path'] + path, body=json.dumps(body).encode('utf-8'),
                     headers=dict(headers, **{'Content-Type': 'application/json', 'Host': h['host'],
                                              'User-Agent': 'Tind-AI/0.1'}))
        resp = conn.getresponse()
        raw = resp.read(8 * 1024 * 1024)
    finally:
        conn.close()
    try:
        data = json.loads(raw.decode('utf-8'))
    except ValueError:
        data = {'raw': raw[:500].decode('utf-8', 'replace')}
    if resp.status >= 400:
        msg = data.get('error', data) if isinstance(data, dict) else data
        if isinstance(msg, dict):
            msg = msg.get('message') or json.dumps(msg)[:400]
        raise RuntimeError('%s answered HTTP %d: %s' % (h['host'], resp.status, str(msg)[:400]))
    return data


def openai_compatible(brief, model, key):
    msgs = [{'role': 'system', 'content': brief['system']}]
    msgs += [{'role': m['role'], 'content': m['text']} for m in brief.get('history', [])]
    msgs.append({'role': 'user', 'content': brief['text']})
    headers = {'Authorization': 'Bearer ' + key} if key else {}
    data = post('/chat/completions', headers, {'model': model, 'messages': msgs, 'max_tokens': MAX_TOKENS})
    choice = (data.get('choices') or [{}])[0]
    text = (choice.get('message') or {}).get('content') or ''
    return text, data.get('usage', {})


def anthropic_native(brief, model, key):
    msgs = [{'role': m['role'], 'content': m['text']} for m in brief.get('history', [])]
    msgs.append({'role': 'user', 'content': brief['text']})
    data = post('/messages', {'x-api-key': key, 'anthropic-version': '2023-06-01'},
                {'model': model, 'system': brief['system'], 'messages': msgs, 'max_tokens': MAX_TOKENS})
    text = ''.join(b.get('text', '') for b in data.get('content', []) if b.get('type') == 'text')
    return text, data.get('usage', {})


ADAPTERS = {'openai': openai_compatible, 'anthropic': anthropic_native}


def handle(uid, req):
    if req.get('op') == 'ping':
        return {'ok': True, 'provider': PROVIDER, 'key': bool(api_key())}
    if req.get('op') != 'send':
        raise ValueError('unknown op')
    bid = str(req.get('id', ''))
    if not ID_RE.match(bid):
        raise ValueError('bad briefing id')
    with open(os.path.join(tindai.BRIEF_DIR, str(uid), bid + '.json'), encoding='utf-8') as f:
        brief = json.load(f)
    if brief.get('uid') != uid:
        raise PermissionError('that briefing belongs to someone else')
    if brief.get('provider') != PROVIDER:
        raise PermissionError('that briefing was prepared for %s, not %s' % (brief.get('provider'), PROVIDER))
    p = tindai.provider(PROVIDER)
    model = str(req.get('model') or brief.get('model') or (p['models'][0]['id'] if p['models'] else ''))
    if not MODEL_RE.match(model):
        raise ValueError('bad model name: %r' % model)
    key = api_key()
    if not key and PROVIDER != 'custom':
        raise RuntimeError('no API key is set for %s' % p['name'])
    t0 = time.time()
    text, usage = ADAPTERS[p['adapter']](brief, model, key)
    out = {'ok': True, 'id': bid, 'answer': text, 'provider': PROVIDER, 'provider_name': p['name'],
           'country': p['country'], 'model': model, 'usage': usage, 'seconds': round(time.time() - t0, 1)}
    folder = tindai.user_dir(tindai.OUTBOX_DIR, uid, readers=[uid])
    tindai.write_json(os.path.join(folder, bid + '.json'), dict(out, created=int(time.time())))
    tindai.prune(folder)
    return out


if __name__ == '__main__':
    if not re.match(r'^[a-z0-9-]+$', PROVIDER):
        raise SystemExit('usage: remote PROVIDER')
    tindai.provider(PROVIDER)
    tindai.serve(handle, idle=120)
