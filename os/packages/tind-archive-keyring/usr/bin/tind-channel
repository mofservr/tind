#!/bin/bash
# tind-channel: choose which Tind update channel this computer follows.
#
#   tind-channel                 show the current channel
#   sudo tind-channel stable     the default: a package version arrives 14 days after it first appeared on next
#   sudo tind-channel next       packages arrive immediately (for testing)
set -euo pipefail
SRC=/etc/apt/sources.list.d/tind.sources
die() { echo "tind-channel: $*" >&2; exit 1; }
[ -r "$SRC" ] || die "$SRC not found (is tind-archive-keyring installed?)"
current="$(sed -n 's/^Suites:[[:space:]]*//p' "$SRC" | head -1)"
case "${1:-}" in
    "")
        case "$current" in
            # the test channel was removed on 9 Nov 2026; tind-archive-keyring 0.1.2 moves such computers to next
            "next test") echo "Tind update channel: next (the old test channel; switch with 'sudo tind-channel next')" ;;
            *) echo "Tind update channel: ${current:-unknown}" ;;
        esac ;;
    stable|next)
        [ "$(id -u)" -eq 0 ] || die "run as root: sudo tind-channel $1"
        sed -i "s/^Suites:.*/Suites: $1/" "$SRC"
        echo "Tind update channel: $1. Run 'sudo apt update' to refresh." ;;
    test)
        die "the test channel was removed; use 'sudo tind-channel next'" ;;
    *)
        sed -n '2,6p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
