#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if [ -f /etc/calamares/settings.conf ]; then
        sed -i 's/^branding:.*/branding: tind/' /etc/calamares/settings.conf
    fi
    # job that records the extras chosen in the launcher dialog
    if [ -f /etc/calamares/settings.conf ] && ! grep -q 'tindextras' /etc/calamares/settings.conf; then
        awk '/^  - packages$/ && !execd { print; print "  - tindextras"; execd=1; next } { print }' \
            /etc/calamares/settings.conf > /etc/calamares/settings.conf.tind
        mv /etc/calamares/settings.conf.tind /etc/calamares/settings.conf
    fi
    # use our bootloader helper (works offline, UEFI and BIOS)
    if [ -f /etc/calamares/settings.conf ]; then
        sed -i 's/^  - bootloader-config$/  - tindbootloader/' /etc/calamares/settings.conf
    fi
    # Norwegian defaults: start the timezone at Europe/Oslo
    mkdir -p /etc/calamares/modules
    cat > /etc/calamares/modules/locale.conf <<'CONF'
---
region: "Europe"
zone: "Oslo"
CONF
    # after install: drop the live-session and installer packages from the installed system.
    # try_remove ignores packages that are not present (the stock list names some we do not ship).
    cat > /etc/calamares/modules/packages.conf <<'CONF'
---
backend: apt
update_db: false
update_system: false
operations:
  - try_remove:
      - live-boot
      - live-boot-doc
      - live-config
      - live-config-doc
      - live-config-systemd
      - live-tools
      - tind-installer
      - calamares-settings-debian
      - calamares
CONF
fi
exit 0
