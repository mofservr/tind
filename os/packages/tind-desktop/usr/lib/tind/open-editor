#!/bin/sh
# Super+E: LibreOffice Writer when it is installed (the Productivity box), otherwise the Text Editor.
# One key, one command; this only picks which app. Tind's hotkeys are described in claude/tind-hotkeys.md.
if [ "$(dpkg-query -W -f='${db:Status-Abbrev}' libreoffice-writer 2>/dev/null | cut -c1-2)" = "ii" ]; then
    exec libreoffice --writer
fi
exec gnome-text-editor
