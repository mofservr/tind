#!/usr/bin/python3
# tind-hotkeys: Tind's hotkey overview (Super+H), plus two command line modes used by the CI self-test.
#
#   tind-hotkeys          open the one-page overview; running it again while it is open closes it (Super+H toggles);
#                         its "All shortcuts" button opens the full list
#   tind-hotkeys --list   print every hotkey that is bound right now, one per line (no window)
#   tind-hotkeys --check  exit 1 and print the clashes if one key combination is bound to two actions
#
# Everything is read live from the settings (GNOME Shell, mutter, gnome-settings-daemon, Dash to Dock, Caffeine and
# the custom keybindings), so the window is right even after a user has changed a key in Settings. Nothing in here is
# a fixed list of keys. The only fixed things are a few friendlier action names and the window's group order.
import re
import sys

import gi
from gi.repository import Gio, GLib

# Settings schemas that hold key bindings. A schema that is not installed is skipped.
SCHEMAS = [
    'org.gnome.desktop.wm.keybindings',
    'org.gnome.mutter.keybindings',
    'org.gnome.mutter.wayland.keybindings',
    'org.gnome.shell.keybindings',
    'org.gnome.settings-daemon.plugins.media-keys',
    'org.gnome.shell.extensions.dash-to-dock',
    'org.gnome.shell.extensions.caffeine',
]
CUSTOM_SCHEMA = 'org.gnome.settings-daemon.plugins.media-keys.custom-keybinding'
DOCK_SCHEMA = 'org.gnome.shell.extensions.dash-to-dock'
# Dash to Dock binds these itself only while its own hot-keys switch is on; the app-hotkey keys are always
# listed because Tind's shell extension (tind-ice) binds them when the switch is off.
DOCK_ONLY_WITH_HOTKEYS = ('app-shift-hotkey-', 'app-ctrl-hotkey-', 'shortcut')

# Keys of type "as" in those schemas that are not key bindings, or that mean nothing to a user.
SKIP_KEYS = {'custom-keybindings', 'xwayland-grab-access-rules', 'panel-main-menu', 'set-spew-mark'}

ACCEL_RE = re.compile(r'^(<[A-Za-z0-9_]+>)*[A-Za-z0-9_]+$')

# Friendlier names than the schema summaries, for the keys Tind cares about. Anything not here uses its summary.
LABELS = {
    'switch-to-workspace': 'Go to workspace #',
    'move-to-workspace': 'Send window to workspace #',
    'switch-to-workspace-left': 'Previous workspace',
    'switch-to-workspace-right': 'Next workspace',
    'switch-to-workspace-up': 'Workspace above',
    'switch-to-workspace-down': 'Workspace below',
    'switch-to-workspace-last': 'Last workspace',
    'move-to-workspace-left': 'Send window to previous workspace',
    'move-to-workspace-right': 'Send window to next workspace',
    'move-to-workspace-up': 'Send window to workspace above',
    'move-to-workspace-down': 'Send window to workspace below',
    'move-to-workspace-last': 'Send window to last workspace',
    'move-to-monitor-left': 'Move window to the left monitor',
    'move-to-monitor-right': 'Move window to the right monitor',
    'move-to-monitor-up': 'Move window to the monitor above',
    'move-to-monitor-down': 'Move window to the monitor below',
    'toggle-maximized': 'Maximize / restore window',
    'maximize': 'Maximize window',
    'unmaximize': 'Restore window',
    'minimize': 'Minimize window',
    'close': 'Close window',
    'show-desktop': 'Show desktop',
    'toggle-tiled-left': 'Tile window to the left half',
    'toggle-tiled-right': 'Tile window to the right half',
    'toggle-overview': 'Overview',
    'toggle-application-view': 'Show applications',
    'toggle-quick-settings': 'Quick Settings',
    'toggle-message-tray': 'Notifications',
    'focus-active-notification': 'Focus the active notification',
    'show-screenshot-ui': 'Screenshot',
    'screenshot': 'Screenshot of the screen',
    'screenshot-window': 'Screenshot of a window',
    'show-screen-recording-ui': 'Screen recording',
    'switch-applications': 'Switch application',
    'switch-applications-backward': 'Switch application (backwards)',
    'switch-group': 'Switch windows of the app',
    'switch-group-backward': 'Switch windows of the app (backwards)',
    'switch-input-source': 'Switch keyboard layout',
    'switch-input-source-backward': 'Switch keyboard layout (backwards)',
    'switch-monitor': 'Switch monitor layout',
    'screensaver': 'Lock screen',
    'logout': 'Log out',
    'control-center': 'Settings',
    'calculator': 'Calculator',
    'mic-mute': 'Microphone mute',
    'magnifier': 'Magnifier on / off',
    'magnifier-zoom-in': 'Magnifier zoom in',
    'magnifier-zoom-out': 'Magnifier zoom out',
    'screenreader': 'Screen reader on / off',
    'help': 'GNOME help',
    'panel-run-dialog': 'Run a command',
    'switch-to-application': 'Switch to application #',
    'open-new-window-application': 'New window of application #',
    'app-hotkey': 'Dock app #',
    'app-shift-hotkey': 'Dock app # (shift behaviour)',
    'app-ctrl-hotkey': 'Dock app # (ctrl behaviour)',
    'shortcut': 'Show dock numbers',
    'toggle-shortcut': 'Caffeine on / off',
    'switch-to-session': 'Switch to text console #',
    'touchpad-toggle-static': 'Touchpad on / off',
}

MODS = {'primary': 'ctrl', 'ctrl': 'ctrl', 'control': 'ctrl', 'alt': 'alt', 'mod1': 'alt',
        'super': 'super', 'mod4': 'super', 'shift': 'shift', 'meta': 'meta', 'hyper': 'hyper'}
MOD_ORDER = ['super', 'ctrl', 'alt', 'shift', 'meta', 'hyper']
MOD_LABEL = {'super': 'Super', 'ctrl': 'Ctrl', 'alt': 'Alt', 'shift': 'Shift', 'meta': 'Meta', 'hyper': 'Hyper'}
BASE_LABEL = {'page_up': 'PgUp', 'page_down': 'PgDn', 'escape': 'Esc', 'above_tab': 'Above Tab', 'space': 'Space',
              'equal': '=', 'minus': '-', 'grave': '`', 'return': 'Enter', 'backspace': 'Backspace'}
BASE_SHOWN = {}  # lower-case key name -> the spelling it had in the settings (XF86AudioMute, Print, ...)


def normalise(accel):
    """('<Primary><Alt>t') -> (frozenset({'ctrl', 'alt'}), 't'), or None when it is not an accelerator."""
    if not accel or not ACCEL_RE.match(accel):
        return None
    mods = set()
    for m in re.findall(r'<([A-Za-z0-9_]+)>', accel):
        mods.add(MODS.get(m.lower(), m.lower()))
    shown = re.sub(r'<[A-Za-z0-9_]+>', '', accel)
    base = shown.lower()
    BASE_SHOWN.setdefault(base, shown)
    return frozenset(mods), base


def accel_label(norm):
    mods, base = norm
    parts = [MOD_LABEL.get(m, m.title()) for m in MOD_ORDER if m in mods]
    parts += [m.title() for m in sorted(mods) if m not in MOD_ORDER]
    shown = BASE_SHOWN.get(base) or (base.upper() if re.fullmatch(r'f?#', base) else base)
    parts.append(BASE_LABEL.get(base, shown.upper() if len(shown) == 1 else shown.replace('_', ' ')))
    return '+'.join(parts)


def _lookup(schema_id):
    source = Gio.SettingsSchemaSource.get_default()
    return source.lookup(schema_id, True) if source else None


class Binding:
    def __init__(self, schema, key, label, accels):
        self.schema = schema
        self.key = key
        self.label = label
        self.accels = accels  # list of (raw, normalised)


def _label_for(schema_obj, key_name):
    stem = re.sub(r'-\d+$', '', key_name)
    if key_name in LABELS:
        return LABELS[key_name]
    if stem in LABELS and stem != key_name:
        return LABELS[stem].replace('#', key_name[len(stem) + 1:])
    summary = schema_obj.get_key(key_name).get_summary()
    return summary.strip().rstrip('.') if summary else key_name


def read_bindings():
    out = []
    for schema_id in SCHEMAS:
        schema = _lookup(schema_id)
        if schema is None:
            continue
        if schema.get_path() is None:  # relocatable: Gio.Settings.new() would abort; none of these should be
            continue
        settings = Gio.Settings.new(schema_id)
        dock_hotkeys_on = False
        if schema_id == DOCK_SCHEMA and schema.has_key('hot-keys'):
            dock_hotkeys_on = settings.get_boolean('hot-keys')
        for key in schema.list_keys():
            if key in SKIP_KEYS:
                continue
            if schema_id == DOCK_SCHEMA and key.startswith(DOCK_ONLY_WITH_HOTKEYS) and not dock_hotkeys_on:
                continue
            if schema_id == DOCK_SCHEMA and not (key.startswith('app-') and 'hotkey' in key or key == 'shortcut'):
                continue
            if schema_id == 'org.gnome.shell.extensions.caffeine' and key != 'toggle-shortcut':
                continue
            if schema.get_key(key).get_value_type().dup_string() != 'as':
                continue
            summary = schema.get_key(key).get_summary() or ''
            if summary.upper().startswith('DEPRECATED'):
                continue
            accels = []
            for raw in settings.get_strv(key):
                norm = normalise(raw)
                if norm:
                    accels.append((raw, norm))
            if accels:
                out.append(Binding(schema_id, key, _label_for(schema, key), accels))
    # custom keybindings
    media = _lookup('org.gnome.settings-daemon.plugins.media-keys')
    if media is not None and _lookup(CUSTOM_SCHEMA) is not None:
        for path in Gio.Settings.new('org.gnome.settings-daemon.plugins.media-keys').get_strv('custom-keybindings'):
            c = Gio.Settings.new_with_path(CUSTOM_SCHEMA, path)
            norm = normalise(c.get_string('binding'))
            if norm:
                out.append(Binding(CUSTOM_SCHEMA, path.rstrip('/').rsplit('/', 1)[-1],
                                   c.get_string('name') or c.get_string('command'),
                                   [(c.get_string('binding'), norm)]))
    return out


def clashes(bindings):
    by = {}
    for b in bindings:
        seen = set()
        for _raw, norm in b.accels:
            if norm in seen:
                continue
            seen.add(norm)
            by.setdefault(norm, []).append(b)
    return {n: bs for n, bs in by.items() if len({(b.schema, b.key) for b in bs}) > 1}


def cmd_list():
    rows = []
    for b in read_bindings():
        for _raw, norm in b.accels:
            rows.append((accel_label(norm), '%s %s' % (b.schema, b.key), b.label))
    for r in sorted(rows):
        print('\t'.join(r))
    return 0


def cmd_check():
    bad = clashes(read_bindings())
    if not bad:
        print('hotkeys unique')
        return 0
    for norm, bs in sorted(bad.items(), key=lambda kv: accel_label(kv[0])):
        print('%s: %s' % (accel_label(norm), ', '.join('%s %s' % (b.schema.replace('org.gnome.', ''), b.key) for b in bs)))
    return 1


# ---------------------------------------------------------------------------------------------------- the window

GROUPS = [
    ('workspaces', 'Workspaces', 'Super: the wall'),
    ('windows', 'Windows', 'Super+Alt: the paper'),
    ('apps', 'Apps', 'Super+Ctrl: the dock apps and app variants'),
    ('commands', 'Commands', 'Super+letter'),
    ('other', 'Other', None),
    ('access', 'Accessibility', None),
    ('hardware', 'Hardware keys', None),
]
ACCESS_KEYS = {'magnifier', 'magnifier-zoom-in', 'magnifier-zoom-out', 'screenreader'}
WS_BASES = set('1234567890') | {'left', 'right', 'up', 'down', 'page_up', 'page_down', 'home', 'end'}


def group_of(norm):
    mods, base = norm
    if base.startswith('xf86'):
        return 'hardware'
    if 'super' in mods and 'alt' in mods:
        return 'windows'
    if mods == {'super', 'shift'} and base in WS_BASES:
        return 'windows'  # Super+Shift+PgUp and friends send the window to another workspace
    if 'super' in mods and 'ctrl' in mods:
        return 'apps'
    if mods == {'super'} and base in WS_BASES:
        return 'workspaces'
    if 'super' in mods:
        return 'commands'
    return 'other'


def window_rows(bindings):
    """[(group, action label, key label)], numbered keys (workspace 1..9) folded into one row with a '#'."""
    rows = []
    numbered = {}
    for b in bindings:
        m = re.match(r'^(.*)-(\d+)$', b.key)
        if m and b.schema != CUSTOM_SCHEMA:
            numbered.setdefault((b.schema, m.group(1)), []).append((int(m.group(2)), b))
        else:
            for _raw, norm in b.accels:
                g = 'access' if b.key in ACCESS_KEYS else 'commands' if b.schema == CUSTOM_SCHEMA else group_of(norm)
                rows.append((g, b.label, accel_label(norm)))
    for (_schema, stem), items in numbered.items():
        items.sort(key=lambda it: it[0])
        first = items[0][1]
        pattern = first.accels[0][1]
        folded = len(items) >= 3
        base = pattern[1]
        tail = re.search(r'(\d+)$', base)
        if folded and tail:
            head = base[:tail.start()]
            for n, b in items:
                ok = any(norm[0] == pattern[0] and norm[1] in (head + str(n), head + str(n % 10))
                         for _r, norm in b.accels)
                if not ok:
                    folded = False
        else:
            folded = False
        if folded:
            label = LABELS.get(stem, first.label)
            if '#' not in label:
                label = re.sub(r'\d+$', '#', label.strip()) if re.search(r'\d+$', label.strip()) else label + ' #'
            key = accel_label((pattern[0], head + '#'))
            rows.append((group_of(pattern), label, key))
            # keys that are not part of the pattern (workspace 1 also on Super+Home, for example)
            for n, b in items:
                for _r, norm in b.accels:
                    if norm[0] == pattern[0] and norm[1] in (head + str(n), head + str(n % 10)):
                        continue
                    rows.append((group_of(norm), b.label, accel_label(norm)))
        else:
            for _n, b in items:
                for _r, norm in b.accels:
                    rows.append((group_of(norm), b.label, accel_label(norm)))
    # the Super tap, a single-key setting rather than an accelerator
    if _lookup('org.gnome.mutter') is not None:
        tap = Gio.Settings.new('org.gnome.mutter').get_string('overlay-key')
        if tap:
            rows.append(('commands', 'Overview (tap)', MOD_LABEL.get(tap.split('_')[0].lower(), tap)))
    merged = {}
    for g, label, key in rows:
        merged.setdefault((g, label), []).append(key)
    return sorted((g, label, '   '.join(dict.fromkeys(keys))) for (g, label), keys in merged.items())


# ---------------------------------------------------------------------------------------- the one-page overview

WM = 'org.gnome.desktop.wm.keybindings'
SH = 'org.gnome.shell.keybindings'
MK = 'org.gnome.settings-daemon.plugins.media-keys'
MU = 'org.gnome.mutter.keybindings'
CUSTOM = 'custom'
TAP = 'tap'

# The overview shows the keys people use, in boxes, on one page; "All shortcuts" opens the full list. Only the
# choice of actions and their order is fixed here: the keys themselves are read live, so a changed key shows its new
# value and a removed one shows "not set". Columns of (title, family, rows); a row is (label, [(schema, key)], filter)
# where filter 'super' keeps only the Super combinations of a key and 'nosuper' only the others. A key ending in
# '-#' is folded over its numbers (1 to the number of workspaces, or 1-9 and 0 for the dock).
SHEET = [
    [('Workspaces', 'Super', [
        ('Go to workspace', [(WM, 'switch-to-workspace-#')], 'super'),
        ('Previous / next workspace', [(WM, 'switch-to-workspace-left'), (WM, 'switch-to-workspace-right')], 'super'),
        ('Overview', [(TAP, ''), (SH, 'toggle-overview')], None),
     ]),
     ('Windows', 'Super+Alt', [
        ('Send to workspace', [(WM, 'move-to-workspace-#')], 'super'),
        ('Tile to left / right half', [(MU, 'toggle-tiled-left'), (MU, 'toggle-tiled-right')], None),
        ('Move to other monitor', [(WM, 'move-to-monitor-left'), (WM, 'move-to-monitor-right')], None),
        ('Maximize / restore', [(WM, 'toggle-maximized')], 'super'),
        ('Minimize', [(WM, 'minimize')], None),
        ('Close', [(WM, 'close')], None),
     ]),
     ('Apps', 'Super+Ctrl', [
        ('Dock app', [(DOCK_SCHEMA, 'app-hotkey-#')], None),
        ('Private browser window', [(CUSTOM, 'tind-browser-private')], None),
     ])],
    [('Commands', 'Super+letter', 'LETTERS')],
    [('Switching', None, [
        ('Switch apps', [(WM, 'switch-applications')], 'nosuper'),
        ('Switch windows of an app', [(WM, 'switch-group')], 'nosuper'),
        ('Keyboard layout', [(WM, 'switch-input-source')], None),
        ('Monitor layout', [(MU, 'switch-monitor')], 'super'),
     ]),
     ('Screenshots and system', None, [
        ('Screenshot', [(SH, 'show-screenshot-ui')], None),
        ('Screenshot of the screen', [(SH, 'screenshot')], None),
        ('Screenshot of a window', [(SH, 'screenshot-window')], None),
        ('System Monitor', [(CUSTOM, 'tind-system-monitor')], None),
        ('Run a command', [(WM, 'panel-run-dialog')], None),
        ('Log out', [(MK, 'logout')], None),
     ]),
     ('Accessibility', None, [
        ('Magnifier on / off', [(MK, 'magnifier')], None),
        ('Zoom in / out', [(MK, 'magnifier-zoom-in'), (MK, 'magnifier-zoom-out')], None),
        ('Screen reader', [(MK, 'screenreader')], None),
     ])],
]
# Super+letter commands, listed in the order of the key each one has now.
LETTERS = [
    (SH, 'toggle-application-view', 'Show apps'), (CUSTOM, 'tind-browser', 'Browser'),
    (MK, 'calculator', 'Calculator'), (WM, 'show-desktop', 'Show desktop'),
    (CUSTOM, 'tind-editor', 'Writer / Text Editor'), (CUSTOM, 'tind-files', 'Files'), (CUSTOM, 'tind-steam', 'Steam'),
    (CUSTOM, 'tind-help', 'Hotkey overview'), (CUSTOM, 'tind-ai', 'AI assistant'), (MK, 'screensaver', 'Lock screen'), (MK, 'mic-mute', 'Microphone mute'),
    (SH, 'toggle-message-tray', 'Notifications'), (SH, 'toggle-quick-settings', 'Quick Settings'),
    (SH, 'show-screen-recording-ui', 'Screen recording'), (MK, 'control-center', 'Settings'),
    (CUSTOM, 'tind-terminal-super', 'Terminal'), (CUSTOM, 'tind-software', 'Software'),
]
ARROWS = {'Left': '←', 'Right': '→', 'Up': '↑', 'Down': '↓'}
SUBTITLE = 'Super is the wall · Super+Alt the window · Super+Ctrl the apps · Super+letter a command'
CSS = b"""
.tind-hk-card { padding: 12px 14px; }
.tind-hk-key { font-size: 0.85em; font-weight: 600; padding: 1px 7px; min-width: 14px; border-radius: 6px;
               border: 1px solid alpha(currentColor, 0.25); border-bottom-width: 2px;
               background: alpha(currentColor, 0.06); }
.tind-hk-key.letter { min-width: 18px; }
.tind-hk-footer { font-size: 0.9em; }
"""


def sheet_accels(schema, key):
    """The normalised accelerators of one key, for the overview."""
    if schema == TAP:
        if _lookup('org.gnome.mutter') is None:
            return []
        tap = Gio.Settings.new('org.gnome.mutter').get_string('overlay-key')
        return [(frozenset(), tap.split('_')[0].lower())] if tap else []
    if schema == CUSTOM:
        if _lookup(CUSTOM_SCHEMA) is None:
            return []
        path = '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/%s/' % key
        media = _lookup(MK) and Gio.Settings.new(MK).get_strv('custom-keybindings')
        if not media or path not in media:
            return []
        norm = normalise(Gio.Settings.new_with_path(CUSTOM_SCHEMA, path).get_string('binding'))
        return [norm] if norm else []
    probe = key[:-2] + '-1' if key.endswith('-#') else key
    found = None
    for sid in [schema] + [x for x in SCHEMAS if x != schema]:
        obj = _lookup(sid)
        if obj is not None and obj.get_path() is not None and obj.has_key(probe):
            found = sid
            break
    if found is None:
        return []
    settings = Gio.Settings.new(found)
    if not key.endswith('-#'):
        return [n for n in (normalise(a) for a in settings.get_strv(key)) if n]
    stem = key[:-2]
    if found == DOCK_SCHEMA:
        count, last = 10, '0'
    else:
        count = Gio.Settings.new('org.gnome.desktop.wm.preferences').get_int('num-workspaces') \
            if _lookup('org.gnome.desktop.wm.preferences') else 4
        count = max(1, min(count, 12))
        last = str(count)
    per = []
    for i in range(1, count + 1):
        name = '%s-%d' % (stem, i)
        if not _lookup(found).has_key(name):
            break
        per.append([n for n in (normalise(a) for a in settings.get_strv(name)) if n])
    # fold only when every number has a key with the same modifiers and the number itself as the key
    for mods in {n[0] for n in (per[0] if per else [])}:
        if all(any(n[0] == mods and n[1] == str((i + 1) % 10 if found == DOCK_SCHEMA else i + 1) for n in keys)
               for i, keys in enumerate(per)):
            return [(mods, '1–%s' % last if len(per) > 1 else '1')]
    return []


def key_parts(norm):
    mods, base = norm
    parts = [MOD_LABEL.get(m, m.title()) for m in MOD_ORDER if m in mods]
    if base == 'super':
        parts.append('Super')
    elif re.fullmatch(r'1(–\d+)?', base):
        parts.append(base)
    else:
        label = accel_label((frozenset(), base))
        parts.append(ARROWS.get(label, label))
    return parts


def pick(accels, filt):
    if filt == 'super':
        return [a for a in accels if 'super' in a[0]] or accels
    if filt == 'nosuper':
        return [a for a in accels if 'super' not in a[0]] or accels
    return accels


def run_window():
    gi.require_version('Gtk', '4.0')
    gi.require_version('Adw', '1')
    from gi.repository import Adw, Gdk, Gtk

    def keycaps(Gtk, parts, extra=None):
        box = Gtk.Box(spacing=3, valign=Gtk.Align.CENTER)
        for p in parts:
            lab = Gtk.Label(label=p)
            lab.add_css_class('tind-hk-key')
            if extra:
                lab.add_css_class(extra)
            box.append(lab)
        return box

    def keys_widget(entries, filt):
        found = []
        for schema, key in entries:
            accels = pick(sheet_accels(schema, key), filt)
            if accels:
                found.append(accels[0])
        box = Gtk.Box(spacing=3, halign=Gtk.Align.END, valign=Gtk.Align.CENTER)
        if not found:
            box.append(Gtk.Label(label='not set', css_classes=['dim-label', 'caption']))
            return box
        same = len(found) > 1 and len({f[0] for f in found}) == 1
        for i, norm in enumerate(found):
            parts = key_parts(norm)
            if same and i > 0:
                parts = parts[-1:]
            if i > 0:
                box.append(Gtk.Label(label='/' if same else 'or', css_classes=['dim-label', 'caption']))
            box.append(keycaps(Gtk, parts))
        return box

    def card(title, family, rows):
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6, css_classes=['card', 'tind-hk-card'])
        head = Gtk.Box(spacing=8)
        head.append(Gtk.Label(label=title, xalign=0, hexpand=True, css_classes=['heading']))
        if family:
            head.append(Gtk.Label(label=family, css_classes=['dim-label', 'caption']))
        box.append(head)
        grid = Gtk.Grid(column_spacing=16, row_spacing=5)
        if rows == 'LETTERS':
            items = []
            for schema, key, label in LETTERS:
                accels = pick(sheet_accels(schema, key), 'super')
                norm = accels[0] if accels else None
                items.append((accel_label(norm) if norm else '~', label, norm))
            for i, (_sort, label, norm) in enumerate(sorted(items)):
                if norm is None:
                    grid.attach(Gtk.Label(label='not set', css_classes=['dim-label', 'caption'], xalign=0), 0, i, 1, 1)
                else:
                    parts = key_parts(norm)
                    grid.attach(keycaps(Gtk, parts[1:] if norm[0] == {'super'} else parts, 'letter'), 0, i, 1, 1)
                grid.attach(Gtk.Label(label=label, xalign=0, hexpand=True), 1, i, 1, 1)
        else:
            for i, (label, entries, filt) in enumerate(rows):
                grid.attach(Gtk.Label(label=label, xalign=0, hexpand=True), 0, i, 1, 1)
                grid.attach(keys_widget(entries, filt), 1, i, 1, 1)
        box.append(grid)
        return box

    def close_on_esc(win):
        keys = Gtk.EventControllerKey()

        def on_key(_controller, keyval, _keycode, _state):
            if keyval == Gdk.KEY_Escape:
                win.close()
                return True
            return False

        keys.connect('key-pressed', on_key)
        win.add_controller(keys)

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id='no.servr.TindHotkeys')
            self.win = None

        def do_activate(self):
            # a second start while the window is open closes it, so the same key opens and closes the window
            if self.win is not None and self.win.get_visible():
                self.win.close()
                return
            css = Gtk.CssProvider()
            css.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), css,
                                                      Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            self.win = self.build_overview()
            self.win.present()

        def build_overview(self):
            win = Adw.ApplicationWindow(application=self, title='Hotkey overview', resizable=False)
            view = Adw.ToolbarView()
            header = Adw.HeaderBar()
            header.set_title_widget(Adw.WindowTitle(title='Hotkey overview', subtitle=SUBTITLE))
            view.add_top_bar(header)
            columns = Gtk.Box(spacing=12, homogeneous=True, margin_start=12, margin_end=12, margin_top=6)
            for column in SHEET:
                col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
                for title, family, rows in column:
                    col.append(card(title, family, rows))
                columns.append(col)
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin_bottom=12)
            outer.append(columns)
            foot = Gtk.Box(spacing=12, margin_start=16, margin_end=12)
            foot.append(Gtk.Label(label='Volume, brightness and media keys work as printed on the key. '
                                        'Change any hotkey in Settings › Keyboard › View and Customise Shortcuts.',
                                  xalign=0, hexpand=True, wrap=True, css_classes=['dim-label', 'tind-hk-footer']))
            button = Gtk.Button(label='All shortcuts…')
            button.connect('clicked', lambda _b: self.build_full(win).present())
            foot.append(button)
            outer.append(foot)
            view.set_content(outer)
            win.set_content(view)
            close_on_esc(win)
            return win

        def build_full(self, parent):
            rows = window_rows(read_bindings())
            win = Adw.Window(title='All shortcuts', transient_for=parent, modal=True,
                             default_width=560, default_height=700)
            view = Adw.ToolbarView()
            view.add_top_bar(Adw.HeaderBar())
            page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18, margin_top=12, margin_bottom=18,
                           margin_start=12, margin_end=12)
            for gid, title, desc in GROUPS:
                items = [(label, key) for g, label, key in rows if g == gid]
                if not items:
                    continue
                if gid == 'hardware':
                    group = Adw.PreferencesGroup()
                    expander = Adw.ExpanderRow(title='%s (%d)' % (title, len(items)))
                    for label, key in items:
                        expander.add_row(self._row(label, key))
                    group.add(expander)
                else:
                    group = Adw.PreferencesGroup(title=title)
                    if desc:
                        group.set_description(desc)
                    for label, key in items:
                        group.add(self._row(label, key))
                page.append(group)
            clamp = Adw.Clamp(maximum_size=620, child=page)
            view.set_content(Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=clamp))
            win.set_content(view)
            close_on_esc(win)
            return win

        @staticmethod
        def _row(label, key):
            row = Adw.ActionRow(title=GLib.markup_escape_text(label))
            lab = Gtk.Label(label=key, valign=Gtk.Align.CENTER, selectable=False)
            lab.add_css_class('monospace')
            lab.add_css_class('dim-label')
            row.add_suffix(lab)
            return row

    return App().run(None)


def main(argv):
    if '--list' in argv:
        return cmd_list()
    if '--check' in argv:
        return cmd_check()
    if any(a in ('-h', '--help') for a in argv):
        print(__doc__ or '')
        return 0
    return run_window()


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
