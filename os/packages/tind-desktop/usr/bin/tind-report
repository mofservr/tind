#!/bin/bash
# Collects hardware, driver, network and boot information into one text file you can attach
# to a bug report or a chat. Contains no passwords. MAC addresses and serial numbers are masked;
# the computer name and user name can still appear.
set -u
out="${1:-$HOME/tind-report-$(date +%Y%m%d-%H%M%S).txt}"
SUDO=""; [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null && SUDO="sudo -n"
sec() { printf '\n##### %s\n' "$*"; }
# A missing tool is reported as such instead of printing a shell error.
run() {
    printf '$ %s\n' "$*"
    if ! command -v "$1" >/dev/null 2>&1; then echo "(not installed)"; return 0; fi
    "$@" 2>&1 | head -n "${LINES_MAX:-120}"
}
# MAC addresses and serial numbers are masked in the whole report, whichever command printed them.
scrub() { sed -E -e 's/([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}/xx:xx:xx:xx:xx:xx/g' -e 's/(Serial Number:[[:space:]]*).*/\1(removed)/'; }
# The system journal needs root or the adm/systemd-journal group.
can_read_journal() { [ "$(id -u)" -eq 0 ] || id -nG | tr ' ' '\n' | grep -qxE 'adm|systemd-journal'; }
jctl() {
    if can_read_journal; then journalctl "$@" 2>&1
    elif [ -n "$SUDO" ] && $SUDO true 2>/dev/null; then $SUDO journalctl "$@" 2>&1
    else echo "(no access to the system journal; run: sudo tind-report)"; fi
}
if ! can_read_journal && [ -n "$SUDO" ] && ! $SUDO true 2>/dev/null && [ -t 0 ]; then
    echo "The system journal needs your password once (press Enter to skip it):"
    sudo -v 2>/dev/null || true
fi
# One-glance hardware summary for the top of the report: what a friend would otherwise have to write by hand.
pci_names() {
    command -v lspci >/dev/null 2>&1 || { echo "(lspci not installed)"; return 0; }
    local o; o=$(for c in "$@"; do lspci -nn -d "::$c" 2>/dev/null; done | sed -E 's/^[^ ]+ [^:]+: //' | paste -sd';' -)
    echo "${o:-none found}"
}
# Kernel driver in use for each GPU, from lspci (e.g. amdgpu, nvidia, nouveau, i915).
gpu_drivers() {
    command -v lspci >/dev/null 2>&1 || { echo "(lspci not installed)"; return 0; }
    local o; o=$(for c in 0300 0302 0380; do lspci -nnk -d "::$c" 2>/dev/null; done | sed -n 's/^[[:space:]]*Kernel driver in use:[[:space:]]*//p' | paste -sd',' -)
    echo "${o:-no driver loaded}"
}
# Bluetooth adapters: take each hci device, find its USB id, and name it with lsusb.
bt_names() {
    local h d p v n out=""
    for h in /sys/class/bluetooth/hci*; do
        [ -e "$h" ] || continue
        d=$(readlink -f "$h/device" 2>/dev/null); p="$d"; v=""
        for _ in 1 2 3; do
            if [ -r "$p/idVendor" ] && [ -r "$p/idProduct" ]; then v="$(cat "$p/idVendor"):$(cat "$p/idProduct")"; break; fi
            p=$(dirname "$p")
        done
        if [ -n "$v" ] && command -v lsusb >/dev/null 2>&1; then
            n=$(lsusb -d "$v" 2>/dev/null | sed -E 's/^Bus [0-9]+ Device [0-9]+: ID //' | head -n 1)
        fi
        out="${out:+$out; }${n:-${h##*/} (not a USB adapter)}"
    done
    echo "${out:-none found}"
}
summary() {
    sec "Summary"
    echo "Machine:   $(cat /sys/class/dmi/id/sys_vendor 2>/dev/null) $(cat /sys/class/dmi/id/product_name 2>/dev/null)"
    echo "CPU:       $(lscpu 2>/dev/null | sed -n 's/^Model name:[[:space:]]*//p' | head -n 1)"
    echo "RAM:       $(free -h 2>/dev/null | awk '/^Mem:/ {print $2}')"
    echo "GPU:       $(pci_names 0300 0302 0380)"
    echo "GPU driver: $(gpu_drivers)"
    echo "Wi-Fi:     $(pci_names 0280)"
    echo "Bluetooth: $(bt_names)"
    echo "Sound:     $(pci_names 0403 0401)"
    echo "Ethernet:  $(pci_names 0200)"
    echo "Boot:      $([ -d /sys/firmware/efi ] && echo UEFI || echo BIOS); Secure Boot: $(command -v mokutil >/dev/null && mokutil --sb-state 2>&1 | head -n 1 || echo unknown)"
}
{
    echo "Tind report, $(date -u +%FT%TZ)"
    summary
    sec "Tind and OS"; cat /etc/os-release; run uname -a; run dpkg -l 'tind-*'
    sec "Hardware"; for f in sys_vendor product_name product_version bios_vendor bios_version bios_date chassis_type; do echo "$f: $(cat /sys/class/dmi/id/$f 2>/dev/null)"; done
    run lscpu; run free -h; run lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT
    sec "Boot"; [ -d /sys/firmware/efi ] && echo "UEFI" || echo "BIOS"
    command -v mokutil >/dev/null && run mokutil --sb-state
    run cat /proc/cmdline
    sec "GPU"; run lspci -nnk -d ::0300; run lspci -nnk -d ::0302; run lspci -nnk -d ::0380
    command -v tind-gpu >/dev/null && run tind-gpu status
    command -v nvidia-smi >/dev/null && run nvidia-smi
    command -v vulkaninfo >/dev/null && { printf '$ vulkaninfo --summary\n'; vulkaninfo --summary 2>&1 | head -40; }
    command -v glxinfo >/dev/null && { printf '$ glxinfo -B\n'; glxinfo -B 2>&1 | head -25; }
    run dkms status
    sec "NVIDIA driver and fallback"
    run apt-cache policy nvidia-driver; run lsmod; run ls /etc/modprobe.d
    jctl -t tind-gpu-check -b --no-pager | tail -n 30
    command -v mokutil >/dev/null && run mokutil --list-enrolled
    sec "Firmware updates"; run fwupdmgr get-devices --no-unreported-check; run fwupdmgr get-updates --no-unreported-check
    printf '$ journalctl -u fwupd-refresh.service (all boots)\n'; jctl -u fwupd-refresh.service --no-pager | tail -n 25
    sec "Other systems and boot menu"; grep -E "^\s*menuentry '" /boot/grub/grub.cfg 2>/dev/null | sed -E "s/^\s*menuentry '([^']*)'.*/\1/" | head -20
    run efibootmgr
    sec "Tind apps and login screen"; ls -1 /usr/share/applications/tind* /etc/xdg/autostart/tind* 2>/dev/null
    echo "login logo is Tind: $(cmp -s /usr/share/tind/login-logo-64.png /usr/share/images/vendor-logos/logo-text-version-64.png && echo yes || echo NO)"
    sec "Wi-Fi, network and Bluetooth"; run lspci -nnk -d ::0280; run lsusb
    if command -v rfkill >/dev/null 2>&1; then
        run rfkill list
    else
        echo '$ rfkill list (rfkill is not installed; /sys/class/rfkill instead)'
        for r in /sys/class/rfkill/rfkill*; do
            [ -e "$r" ] || continue
            echo "$(cat "$r/type" 2>/dev/null) $(cat "$r/name" 2>/dev/null): soft=$(cat "$r/soft" 2>/dev/null) hard=$(cat "$r/hard" 2>/dev/null)"
        done
    fi
    run nmcli -t -f DEVICE,TYPE,STATE device
    printf '$ kernel warnings and errors this boot\n'; jctl -k -b -p warning --no-pager | tail -n 60
    sec "Audio"; run lspci -nnk -d ::0403; run lspci -nnk -d ::0401; command -v wpctl >/dev/null && run wpctl status
    sec "Power"; command -v powerprofilesctl >/dev/null && run powerprofilesctl; ls /sys/class/power_supply 2>/dev/null
    sec "Time"; run timedatectl; run timedatectl timesync-status
    printf '$ journalctl -u systemd-timesyncd (this boot)\n'; jctl -u systemd-timesyncd -b --no-pager | tail -n 15
    sec "Services"; run systemctl --failed --no-legend; run systemctl is-active ufw apparmor NetworkManager gdm tind-extras.service
    sec "Journal, errors this boot"; jctl -b -p err --no-pager | tail -n 100
    sec "Journal, previous boot errors"; jctl -b -1 -p err --no-pager | tail -n 60
    sec "Extras"; cat /var/lib/tind/extras-status 2>&1; tail -n 40 /var/log/tind-extras.log 2>&1
    sec "Updates"; ls -l /var/lib/tind/apt-refreshed 2>&1; run apt-get -s upgrade -qq
} 2>&1 | scrub > "$out"
echo "Report written to: $out"
echo "Attach that file when you ask for help."
