#!/bin/sh
set -e
systemctl enable tind-apt-refresh.service >/dev/null 2>&1 || true
systemctl enable tind-debian-components.service >/dev/null 2>&1 || true
# Machines installed before 0.1.15 have Debian's sources without non-free: fix them now. A fresh install
# is fixed by the first-boot service instead, because the installer rewrites the sources after this runs.
if [ "$1" = "configure" ] && [ -n "${2:-}" ] && dpkg --compare-versions "$2" lt 0.1.15; then
    /usr/lib/tind/debian-components || true
fi
exit 0
