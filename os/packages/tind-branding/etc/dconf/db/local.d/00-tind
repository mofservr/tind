# Tind GNOME defaults (system-wide, users can still change everything)

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
accent-color='teal'
icon-theme='Papirus'
font-name='Nunito Sans 11'
document-font-name='Nunito Sans 11'

# 24-hour clock; the time zone is NOT set automatically (that needs the location service)
clock-format='24h'
clock-show-weekday=true

[org/gnome/desktop/datetime]
automatic-timezone=false

[org/gnome/system/location]
enabled=false

# window buttons: minimize and close
[org/gnome/desktop/wm/preferences]
button-layout=':minimize,close'

# Ctrl+Alt+T opens the Terminal (GNOME 48 has no built-in terminal shortcut key, so it is a custom one)
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tind-terminal/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tind-terminal]
name='Terminal'
command='gnome-terminal'
binding='<Primary><Alt>t'

[org/gnome/desktop/input-sources]
sources=[('xkb', 'no')]

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/tind/segla-light.png'
picture-uri-dark='file:///usr/share/backgrounds/tind/segla-dark.png'
picture-options='zoom'
primary-color='#0C1523'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/tind/segla-dark.png'
picture-options='zoom'
primary-color='#0C1523'

[org/gnome/shell]
enabled-extensions=['tind-ice@tind.no', 'dash-to-dock@micxgx.gmail.com']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'org.gnome.Terminal.desktop', 'thunderbird.desktop', 'libreoffice-writer.desktop', 'org.gnome.Software.desktop', 'org.gnome.Settings.desktop']

[org/gnome/shell/extensions/dash-to-dock]
dock-position='LEFT'
extend-height=true
height-fraction=1.0
dock-fixed=true
autohide=false
intellihide=false
show-trash=false
show-mounts=false
running-indicator-style='DOTS'
dash-max-icon-size=44
