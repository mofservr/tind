# Tind GNOME defaults (system-wide, users can still change everything)

[org/gnome/desktop/interface]
color-scheme='prefer-dark'
# Tind teal is the 'green' slot of GNOME's accent list (all nine slots are re-coloured, see tind-ice)
accent-color='green'
icon-theme='Papirus'
font-name='Nunito Sans 11'
document-font-name='Nunito Sans 11'

# 24-hour clock; the time zone is NOT set automatically (that needs the location service)
clock-format='24h'
clock-show-weekday=true

[org/gnome/desktop/datetime]
automatic-timezone=false

[org/gnome/system/location]
enabled=false

# window buttons: minimize and close
[org/gnome/desktop/wm/preferences]
button-layout=':minimize,close'

# Ctrl+Alt+T opens the Terminal (GNOME 48 has no built-in terminal shortcut key, so it is a custom one)
[org/gnome/settings-daemon/plugins/media-keys]
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tind-terminal/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/tind-terminal]
name='Terminal'
command='gnome-terminal'
binding='<Primary><Alt>t'

[org/gnome/desktop/input-sources]
sources=[('xkb', 'no')]

[org/gnome/desktop/background]
picture-uri='file:///usr/share/backgrounds/tind/tranquil-light.png'
picture-uri-dark='file:///usr/share/backgrounds/tind/tranquil-dark.png'
picture-options='zoom'
primary-color='#0C1523'

[org/gnome/desktop/screensaver]
picture-uri='file:///usr/share/backgrounds/tind/tranquil-dark.png'
picture-options='zoom'
primary-color='#0C1523'

# Tray icons: Debian ships the AppIndicator extension as 'ubuntu-appindicators@ubuntu.com' (shown as
# "Ubuntu AppIndicators"); the upstream id is kept as well, an unknown id in this list is ignored.
[org/gnome/shell]
enabled-extensions=['tind-ice@tind.no', 'dash-to-dock@micxgx.gmail.com', 'ubuntu-appindicators@ubuntu.com', 'appindicatorsupport@rgcjonas.gmail.com', 'caffeine@patapon.info', 'system-monitor-panel@naimur', 'multi-monitors-bar@frederykabryan']
favorite-apps=['firefox-esr.desktop', 'thunderbird.desktop', 'org.gnome.Nautilus.desktop']

[org/gnome/shell/extensions/dash-to-dock]
# Left panel-mode dock, always visible, full height; settings as tuned by Morten 2026-10-19
dock-position='LEFT'
multi-monitor=true
extend-height=true
height-fraction=1.0
dock-fixed=true
autohide=false
intellihide=false
show-trash=false
show-mounts=true
show-mounts-only-mounted=true
show-mounts-network=false
running-indicator-style='DOTS'
dash-max-icon-size=40
preview-size-scale=0.16
icon-size-fixed=false
always-center-icons=false
show-favorites=true
show-running=true
show-windows-preview=true
isolate-workspaces=false
isolate-monitors=false
workspace-agnostic-urgent-windows=true
scroll-to-focused-application=true
show-show-apps-button=true
show-apps-at-top=false
show-apps-always-in-the-edge=true
hot-keys=false
click-action='previews'
scroll-action='cycle-windows'
custom-theme-shrink=true
disable-overview-on-startup=true
apply-custom-theme=false
custom-background-color=false
transparency-mode='DEFAULT'
background-opacity=1.0

# System Monitor in the top bar: temperature next to CPU, then memory, disk and network. GPU is only a
# card in the menu (it stays out of the bar); external disks listed, network card off.
[org/gnome/shell/extensions/system-monitor-panel]
panel-order=['temperature', 'cpu', 'gpu', 'memory', 'disk', 'network']
show-temperature=true
show-cpu=true
show-gpu=false
show-memory=true
show-disk=true
show-network=true
show-cpu-card=true
show-gpu-card=true
show-memory-card=true
show-disk-card=true
show-external-disks=true
show-temperature-card=true
show-network-card=false

# App grid folders. categories/excluded-apps are emptied so GNOME's own Utilities folder
# does not pull in other apps; only the apps listed here are shown in each folder.
# Office fills up when the Productivity and cloud box (LibreOffice) is installed.
[org/gnome/desktop/app-folders]
folder-children=['Office', 'System', 'Utilities']

[org/gnome/desktop/app-folders/folders/Office]
name='Office'
translate=false
categories=@as []
excluded-apps=@as []
apps=['libreoffice-writer.desktop', 'libreoffice-calc.desktop', 'libreoffice-impress.desktop', 'libreoffice-startcenter.desktop']

[org/gnome/desktop/app-folders/folders/System]
name='System'
translate=false
categories=@as []
excluded-apps=@as []
apps=['proton.vpn.app.gtk.desktop', 'org.gnome.Extensions.desktop', 'tind-optins.desktop']

[org/gnome/desktop/app-folders/folders/Utilities]
name='Utilities'
translate=false
categories=@as []
excluded-apps=@as []
apps=['org.gnome.Calculator.desktop', 'org.gnome.TextEditor.desktop', 'org.gnome.SystemMonitor.desktop', 'org.gnome.DiskUtility.desktop', 'org.gnome.Loupe.desktop', 'org.gnome.Papers.desktop', 'org.gnome.FileRoller.desktop']
