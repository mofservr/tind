#!/bin/bash
# tind-feeds: open the news reader (Super+W). Without NewsFlash it opens Tind Apps, where the News reader box is.
# The first time, a notice gives the address of nyhet'r for NewsFlash's FreshRSS login (NewsFlash cannot be preset).
APP="io.gitlab.news_flash.NewsFlash"
SERVER="https://nyhetr.servr.no/api/greader.php"
flatpak info "$APP" >/dev/null 2>&1 || exec tind-optins
if [ ! -d "$HOME/.var/app/$APP" ]; then
    notify-send -i "$APP" "Log in to nyhet'r" \
        "In NewsFlash pick FreshRSS, enter $SERVER and your FreshRSS username and API password (not the web password). Needs the home network or the Tind-VPN." 2>/dev/null || true
fi
exec flatpak run "$APP" "$@"
