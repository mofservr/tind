#!/bin/bash
# tind-feeds: open the news reader (Super+W). Without Liferea it opens Tind Apps, where the News reader box is.
# nyhet'r is reachable from the home network and the Tind-VPN only; from anywhere else the connection is dropped
# without an answer. Liferea cannot tell that from a wrong password (it asks for the login again), so say it first.
SERVER="https://nyhetr.servr.no/api/greader.php/"
command -v liferea >/dev/null 2>&1 || exec tind-optins
# any HTTP answer counts as reachable (401, 404 and so on); a dropped connection, a timeout or no DNS does not
if ! curl -sS -o /dev/null --max-time 6 "$SERVER" 2>/dev/null; then
    notify-send -i network-offline "nyhet'r is not reachable from this network" \
        "Use the home network or the Tind-VPN. If Liferea asks for a login, press Cancel: your password is not wrong. Articles already loaded stay readable." 2>/dev/null || true
fi
exec liferea "$@"
