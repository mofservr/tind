#!/bin/bash
# News reader: NewsFlash from Flathub (GTK 4 and libadwaita, follows the system's light and dark theme). It logs in to
# nyhet'r, the household FreshRSS (https://nyhetr.servr.no/api/greader.php), with the FreshRSS username and the
# separate API password; NewsFlash keeps them itself and syncs on its own. Not on the ISO; Tind Apps only.
#   setup-feeds             the whole box
#   setup-feeds newsflash   the same (ids: newsflash, as in feeds.optin)
set -euo pipefail
# shellcheck source=/dev/null
. /usr/lib/tind/extras-lib.sh
need_root
pick_apps "newsflash" "$@"
echo "== Tind: news reader setup"
if want newsflash; then optional "NewsFlash" flatpak_install io.gitlab.news_flash.NewsFlash; fi
echo "== Tind: news reader setup done"
