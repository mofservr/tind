#!/bin/bash
# First boot after install: run the stacks the user ticked in the installer.
# Marker: /var/lib/tind/pending-extras (words: gaming dev). Status: /var/lib/tind/extras-status.
set -u
marker=/var/lib/tind/pending-extras
status=/var/lib/tind/extras-status
[ -s "$marker" ] || exit 0
log=/var/log/tind-extras.log
exec >>"$log" 2>&1
echo "=== $(date -Is) extras first boot: $(cat "$marker")"
echo running > "$status"
ok=0
for i in $(seq 1 60); do
    if curl -fsS -m 5 -o /dev/null https://deb.debian.org/debian/dists/trixie/Release; then ok=1; break; fi
    sleep 5
done
if [ "$ok" = 0 ]; then
    echo "offline" > "$status"; echo "no internet; will retry at next boot"; exit 0
fi
failed=""
for item in $(cat "$marker"); do
    case "$item" in
        gaming) /usr/lib/tind/setup-gaming || failed="$failed gaming" ;;
        dev)    /usr/lib/tind/setup-dev    || failed="$failed dev" ;;
    esac
done
if [ -z "$failed" ]; then
    rm -f "$marker"; echo "done" > "$status"
else
    echo "failed:${failed# }" > "$status"
    # keep only the failed items for the next attempt
    echo "${failed# }" > "$marker"
fi
exit 0
