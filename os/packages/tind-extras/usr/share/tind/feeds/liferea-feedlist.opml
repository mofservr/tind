<?xml version="1.0" encoding="UTF-8"?>
<!-- Tind: Liferea's first-start feed list. One source, nyhet'r (FreshRSS, Google Reader API). The user only logs in:
     username plus the separate API password from the Profile page of nyhetr.servr.no. Liferea wants the full
     endpoint here and adds /accounts/ClientLogin itself. Installed by setup-feeds in place of feedlist_en.opml. -->
<opml version="1.0">
<head>
<title>Tind feed list</title>
</head>
<body>
<outline type="source" sourceType="fl_google_reader" title="nyhet'r" xmlUrl="https://nyhetr.servr.no/api/greader.php" expanded="true"/>
</body>
</opml>
