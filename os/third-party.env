# Third-party repositories added at BUILD time. Shell syntax.
# UNVERIFIED: written from memory of Proton's install instructions. Confirm both URLs on
# Proton's official Linux install page before the first build, and compare the key
# fingerprint that scripts/prepare-thirdparty.sh prints with the one Proton publishes.
PROTON_REPO_URL="https://repo.protonvpn.com/debian"
PROTON_SUITE="stable"
PROTON_COMPONENT="main"
PROTON_KEY_URL="https://repo.protonvpn.com/debian/public_key.asc"
PROTON_PACKAGE="proton-vpn-gnome-desktop"
